[2026-10-04T17:13:51.453Z] [INFO]                 "+            return tally;",
[2026-10-04T17:13:51.453Z] [INFO]                 "+        }));",
[2026-10-04T17:13:51.453Z] [INFO]                 "+",
[2026-10-04T17:13:51.453Z] [INFO]                 "+        var swapped = new Tally(n, LinksChecksum(n, true));",
[2026-10-04T17:13:51.453Z] [INFO]                 "+        Timed(timings, \"update\", swapped, () => storage.Transaction(() =>",
