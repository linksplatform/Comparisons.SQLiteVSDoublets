[2026-10-04T18:48:00.978Z] [INFO]           "command": "python3 - <<'EOF'\np='tests/storages.rs'; s=open(p).read()\ns=s.replace(\"\"\"    links::{DoubletsLinks, Link, LinksStorage, SqliteLinks},\n    objects::\"\"\",\"\"\"    links::{DoubletsLinks, Link, LinksStorage, SqliteLinks},\n    memory::volatile,\n    objects::\"\"\",1)\nanchor = \"#[test]\\n#[should_panic(expected = \\\"query_all returned unexpected records\\\")]\"\ntest = '''/// A fresh store reserves 2^20 links, so this many links make it grow once.\nconst GROWN: u64 = (1 << 20) + 1;\n\nfn create_until_grown(mut links: impl LinksStorage<u32>) {\n    for i in 1..=GROWN {\n        let (from, to) = link(i);\n        links.create(from as u32, to as u32);\n    }\n    assert_eq!(links.count(), GROWN);\n    for i in [1, 1_040_384, 1_040_385, GROWN] {\n        let (from, to) = link(i);\n        let (id, from, to) = (i as u32, from as u32, to as u32);\n        assert_eq!(links.get(id), Some(Link { id, from, to }));\n    }\n}\n\n#[test]\nfn stores_keep_their_links_when_their_memory_grows() {\n    create_until_grown(DoubletsLinks::new(unit::Store::<u32, _>::new(volatile()).unwrap()));\n    create_until_grown(DoubletsLinks::new(\n        split::Store::<u32, _, _>::new(volatile(), volatile()).unwrap(),\n    ));\n}\n\n/// Fails once `doublets` uses the whole memory after growing it: then `memory::Whole` can be removed.\n#[test]\n#[should_panic(expected = \"index out of bounds\")]\nfn doublets_lose_the_memory_they_grow() {\n    create_until_grown(DoubletsLinks::new(unit::Store::<u32, _>::new(Global::new()).unwrap()));\n}\n\n'''\nassert anchor in s\ns=s.replace(anchor, test+anchor,1)\nopen(p,'w').write(s)\nEOF\ncargo fmt && time cargo test --test storages grow 2>&1 | tail -15",
