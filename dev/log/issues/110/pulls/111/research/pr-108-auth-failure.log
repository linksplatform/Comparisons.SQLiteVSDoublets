[2026-10-04T17:01:32.827Z] [INFO]                 "-//! Minimal reproductions of a `doublets` 0.5.0 split store bug: deleting a link panics",
[2026-10-04T17:01:32.827Z] [INFO]                 "-//! with \"index out of bounds\" in `InternalSourcesRecursionlessTree` after some updates.",
[2026-10-04T17:01:32.827Z] [INFO]                 "+//! Minimal reproductions of a `doublets` 0.5.0 split store bug.",
[2026-10-04T17:01:32.827Z] [INFO]                 "+//!",
[2026-10-04T17:01:32.827Z] [INFO]                 "+//! `split::Store::update_links` detaches the link and only then asks `is_virtual(new_source)`,",
[2026-10-04T17:01:32.827Z] [INFO]                 "+//! which is `is_unused`: `size_as_target == 0 && source != 0`. Right after the detach that is true",
[2026-10-04T17:01:32.827Z] [INFO]                 "+//! for the link itself, so updating a link to reference itself attaches it to the external",
[2026-10-04T17:01:32.827Z] [INFO]                 "+//! (header) trees. A later delete looks for it in its own internal trees and panics with",
[2026-10-04T17:01:32.827Z] [INFO]                 "+//! \"index out of bounds\" in `InternalSourcesRecursionlessTree::detach_core`.",
[2026-10-04T17:01:32.827Z] [INFO]                 "+//! Creating such a link works, because a fresh link has `source == 0`.",
[2026-10-04T17:01:32.827Z] [INFO]                 "+//!",
[2026-10-04T17:01:32.827Z] [INFO]                 "+//! Usage: `cargo run --release -- <unit|split|dump> <scenario index>`, exit code 101 is the panic.",
[2026-10-04T17:01:32.827Z] [INFO]                 " use doublets::{Doublets, mem::Global, split, unit};",
[2026-10-04T17:01:32.827Z] [INFO]                 " ",
[2026-10-04T17:01:32.827Z] [INFO]                 " type Step = (&'static str, u32, u32, u32);",
[2026-10-04T17:01:32.827Z] [INFO]                 " ",
[2026-10-04T17:01:32.827Z] [INFO]                 " fn run<D: Doublets<u32>>(mut store: D, steps: &[Step]) -> u32 {",
[2026-10-04T17:01:32.827Z] [INFO]                 "     for &(operation, id, from, to) in steps {",
[2026-10-04T17:01:32.827Z] [INFO]                 "-        eprintln!(\"{operation} {id} {from} {to}\");",
[2026-10-04T17:01:32.827Z] [INFO]                 "         match operation {",
[2026-10-04T17:01:32.827Z] [INFO]                 "             \"create\" => assert_eq!(store.create_link(from, to).unwrap(), id),",
[2026-10-04T17:01:32.827Z] [INFO]                 "             \"update\" => drop(store.update(id, from, to).unwrap()),"
[2026-10-04T17:01:32.827Z] [INFO]               ]
[2026-10-04T17:01:32.827Z] [INFO]             }
[2026-10-04T17:01:32.827Z] [INFO]           ]
