        "input": {
          "command": "python3 - <<'EOF'\np='Links.cs'\ns=open(p).read()\ns=s.replace('''    public ulong Count() => (ulong)(long)Command(\"SELECT COUNT(*) FROM links\").ExecuteScalar()!;''','''    public ulong Count()\n    {\n        using var count = Command(\"SELECT COUNT(*) FROM links\");\n        return (ulong)(long)count.ExecuteScalar()!;\n    }''')\ns=s.replace('''    public void Dispose() => links.Dispose();''','''    public void Dispose() => (links as IDisposable)?.Dispose();''')\nopen(p,'w').write(s)\nEOF\ncat > Objects.cs <<'EOF'\nusing System.Numerics;\nusing Microsoft.Data.Sqlite;\nusing Platform.Collections.Stacks;\nusing Platform.Converters;\nusing Platform.Data;\nusing Platform.Data.Doublets;\nusing Platform.Data.Doublets.CriterionMatchers;\nusing Platform.Data.Doublets.PropertyOperators;\nusing Platform.Data.Doublets.Sequences.Converters;\nusing Platform.Data.Doublets.Sequences.Unicode;\nusing Platform.Data.Doublets.Sequences.Walkers;\nusing Platform.Data.Numbers.Raw;\n\nnamespace Comparisons.SQLiteVSDoublets;\n\npublic interface IBlogPostsStorage<T> : IDisposable where T : struct\n{\n    T Create(BlogPost post);\n    BlogPost? Get(T id);\n    void Each(Action<T, BlogPost> visit);\n    void Delete(T id);\n    ulong Count();\n\n    TResult Transaction<TResult>(Func<TResult> work) => work();\n}\n\npublic sealed class SQLiteBlogPosts<T> : IBlogPostsStorage<T> where T : struct, IBinaryInteger<T>\n{\n    private readonly SqliteConnection _connection;\n    private readonly SqliteCommand _create;\n    private readonly SqliteCommand _get;\n    private readonly SqliteCommand _each;\n    private readonly SqliteCommand _delete;\n\n    public static SQLiteBlogPosts<T> Open(string path) => new($\"Data Source={path};Pooling=False\");\n\n    public static SQLiteBlogPosts<T> InMemory() => new(\"Data Source=:memory:;Pooling=False\");\n\n    private SQLiteBlogPosts(string connectionString)\n    {\n        _connection = new SqliteConnection(connectionString);\n        _connection.Open();\n        using (var create = Command(\"CREATE TABLE blog_posts (id INTEGER PRIMARY KEY, title TEXT NOT NULL, content TEXT NOT NULL, publication_date INTEGER NOT NULL)\"))\n        {\n            create.ExecuteNonQuery();\n        }\n        _create = Command(\"INSERT INTO blog_posts (title, content, publication_date) VALUES ($title, $content, $publication_date) RETURNING id\");\n        _create.Parameters.Add(\"$title\", SqliteType.Text);\n        _create.Parameters.Add(\"$content\", SqliteType.Text);\n        _create.Parameters.Add(\"$publication_date\", SqliteType.Integer);\n        _get = Command(\"SELECT title, content, publication_date FROM blog_posts WHERE id = $id\");\n        _get.Parameters.Add(\"$id\", SqliteType.Integer);\n        _each = Command(\"SELECT title, content, publication_date, id FROM blog_posts\");\n        _delete = Command(\"DELETE FROM blog_posts WHERE id = $id\");\n        _delete.Parameters.Add(\"$id\", SqliteType.Integer);\n    }\n\n    private SqliteCommand Command(string sql)\n    {\n        var command = _connection.CreateCommand();\n        command.CommandText = sql;\n        return command;\n    }\n\n    private static BlogPost BlogPost(SqliteDataReader reader) =>\n        new(reader.GetString(0), reader.GetString(1), (ulong)reader.GetInt64(2));\n\n    public T Create(BlogPost post)\n    {\n        _create.Parameters[0].Value = post.Title;\n        _create.Parameters[1].Value = post.Content;\n        _create.Parameters[2].Value = (long)post.PublicationDate;\n        return T.CreateChecked((long)_create.ExecuteScalar()!);\n    }\n\n    public BlogPost? Get(T id)\n    {\n        _get.Parameters[0].Value = long.CreateChecked(id);\n        using var reader = _get.ExecuteReader();\n        return reader.Read() ? BlogPost(reader) : null;\n    }\n\n    public void Each(Action<T, BlogPost> visit)\n    {\n        using var reader = _each.ExecuteReader();\n        while (reader.Read())\n        {\n            visit(T.CreateChecked(reader.GetInt64(3)), BlogPost(reader));\n        }\n    }\n\n    public void Delete(T id)\n    {\n        _delete.Parameters[0].Value = long.CreateChecked(id);\n        _delete.ExecuteNonQuery();\n    }\n\n    public ulong Count()\n    {\n        using var count = Command(\"SELECT COUNT(*) FROM blog_posts\");\n        return (ulong)(long)count.ExecuteScalar()!;\n    }\n\n    public TResult Transaction<TResult>(Func<TResult> work)\n    {\n        using var transaction = _connection.BeginTransaction();\n        var result = work();\n        transaction.Commit();\n        return result;\n    }\n\n    public void Dispose() => _connection.Dispose();\n}\n\n/// <summary>\n/// Stores each blog post as a <c>(blog_post, itself)</c> link with <c>(post, property) -> value</c> properties,\n/// strings as balanced-variant sequences of Unicode symbols and dates as raw numbers.\n/// </summary>\npublic sealed class DoubletsBlogPosts<T> : IBlogPostsStorage<T>\n    where T : struct, IUnsignedNumber<T>, IComparisonOperators<T, T, bool>\n{\n    private readonly ILinks<T> _links;\n    private readonly T _any;\n    private readonly T _unicodeSequence;\n    private readonly T _title;\n    private readonly T _content;\n    private readonly T _publicationDate;\n    private readonly T _blogPost;\n    private readonly PropertiesOperator<T> _properties;\n    private readonly AddressToRawNumberConverter<T> _addressToNumber = new();\n    private readonly RawNumberToAddressConverter<T> _numberToAddress = new();\n    private readonly IConverter<string, T> _stringToSequence;\n    private readonly IConverter<T, string> _sequenceToString;\n\n    public DoubletsBlogPosts(ILinks<T> links, bool cacheSequences)\n    {\n        _links = links;\n        _any = links.Constants.Any;\n        var meaningRoot = links.CreatePoint();\n        T Marker()\n        {\n            var marker = links.Create();\n            return links.Update(marker, meaningRoot, marker);\n        }\n        var unicodeSymbo