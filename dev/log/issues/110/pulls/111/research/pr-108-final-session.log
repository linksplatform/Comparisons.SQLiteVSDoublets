[2026-10-05T00:28:07.997Z] [INFO]     "role": "user",
[2026-10-05T00:28:07.997Z] [INFO]     "content": [
[2026-10-05T00:28:07.997Z] [INFO]       {
[2026-10-05T00:28:07.997Z] [INFO]         "tool_use_id": "toolu_01JX7RALJm1Dd7XoXghdUzDS",
[2026-10-05T00:28:07.997Z] [INFO]         "type": "tool_result",
[2026-10-05T00:28:07.997Z] [INFO]         "content": "     1\t//! Deterministic data shared by every storage and by the C# implementation.\n     2\t\n     3\tconst GOLDEN_GAMMA: u64 = 0x9E37_79B9_7F4A_7C15;\n     4\t\n     5\tpub fn splitmix64(x: u64) -> u64 {\n     6\t    let mut z = x.wrapping_add(GOLDEN_GAMMA);\n     7\t    z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n     8\t    z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n     9\t    z ^ (z >> 31)\n    10\t}\n    11\t\n    12\t/// The `(from, to)` pair of the link with id `i`: both reference already created ids\n    13\t/// and `from + to == i + 1`, so every pair is unique.\n    14\tpub fn link(i: u64) -> (u64, u64) {\n    15\t    let from = 1 + splitmix64(2 * i) % i;\n    16\t    (from, i + 1 - from)\n    17\t}\n    18\t\n    19\t/// Order-sensitive mix of two numbers; summing mixes detects records that are lost,\n    20\t/// duplicated or associated with the wrong id.\n    21\tpub fn mix(a: u64, b: u64) -> u64 {\n    22\t    (a.wrapping_mul(GOLDEN_GAMMA) ^ b).wrapping_mul(GOLDEN_GAMMA)\n    23\t}\n    24\t\n    25\tpub fn link_checksum(id: u64, from: u64, to: u64) -> u64 {\n    26\t    mix(mix(id, from), to)\n    27\t}\n    28\t\n    29\tpub fn links_checksum(n: u64, swapped: bool) -> u64 {\n    30\t    (1..=n)\n    31\t        .map(|i| {\n    32\t            let (from, to) = link(i);\n    33\t            if swapped {\n    34\t                link_checksum(i, to, from)\n    35\t            } else {\n    36\t                link_checksum(i, from, to)\n    37\t            }\n    38\t        })\n    39\t        .fold(0, u64::wrapping_add)\n    40\t}\n    41\t\n    42\t/// Visits `1..=n` once each in a scattered order, so point operations do not hit\n    43\t/// neighbouring records one after another.\n    44\tpub fn scattered(n: u64) -> impl Iterator<Item = u64> {\n    45\t    let mut stride = GOLDEN_GAMMA % n.max(1);\n    46\t    while gcd(stride, n) != 1 {\n    47\t        stride += 1;\n    48\t    }\n    49\t    (0..n).map(move |k| 1 + (k * stride) % n)\n    50\t}\n    51\t\n    52\tfn gcd(a: u64, b: u64) -> u64 {\n    53\t    if b == 0 { a } else { gcd(b, a % b) }\n    54\t}\n    55\t\n    56\t#[derive(Clone, Debug, PartialEq, Eq)]\n    57\tpub struct BlogPost {\n    58\t    pub title: String,\n    59\t    pub content: String,\n    60\t    /// Seconds since the Unix epoch.\n    61\t    pub publication_date: u64,\n    62\t}\n    63\t\n    64\timpl BlogPost {\n    65\t    pub fn checksum(&self) -> u64 {\n    66\t        let bytes = |text: &str| text.bytes().map(u64::from).sum::<u64>();\n    67\t        bytes(&self.title) + bytes(&self.content) + self.publication_date\n    68\t    }\n    69\t}\n    70\t\n    71\tconst SEPTEMBER_2020: u64 = 1_600_000_000;\n    72\tconst THIRTY_DAYS: u64 = 30 * 24 * 60 * 60;\n    73\t\n    74\tconst PARAGRAPHS: [&str; 5] = [\n    75\t    \"Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis malesuada blandit mauris nec bibendum. Phasellus feugiat vehicula mauris et aliquet. Integer et gravida velit, in rutrum leo. Duis pretium, nunc ac posuere porttitor, augue sapien commodo tortor, nec consequat lorem eros ultricies odio. Aliquam varius congue ex nec viverra. Pellentesque eu velit tellus. Donec ac luctus nisi. Curabitur dignissim sodales mauris eu semper. Ut pretium lorem nulla, sit amet auctor arcu placerat vitae. Quisque lacinia dolor et consectetur fermentum. Nam ac orci vitae nulla aliquam tempor ac a nibh. Ut ac tincidunt lacus. Morbi vitae felis lorem.\",\n    76\t    \"Curabitur tincidunt nibh sit amet finibus dictum. Suspendisse aliquet arcu non rutrum ultrices. Integer ullamcorper mauris sit amet nibh aliquam, et tempor turpis hendrerit. In molestie elit et mauris rutrum, non auctor ligula ultricies. Vestibulum dignissim mauris finibus libero interdum hendrerit. Nunc vitae ipsum porttitor, egestas magna ut, sagittis sem. Donec euismod ac tortor vel porta. Vivamus convallis, ex at vestibulum rutrum, velit purus venenatis metus, sit amet aliquam sapien nibh quis elit. Aenean id neque a orci sodales venenatis. Integer ut orci ligula. Interdum et malesuada fames ac ante ipsum primis in faucibus. Praesent molestie dolor non lobortis ornare. Duis quis nisl sollicitudin, accumsan ante sed, eleifend velit. Maecenas maximus sed ante nec auctor.\",\n    77\t    \"Donec vitae felis lectus. Aenean velit sapien, porttitor ut feugiat a, consectetur et risus. Proin ac viverra sem. Nullam sagittis ex tortor, eu pellentesque tellus efficitur at. Nunc non egestas leo. Nam sed suscipit neque. Nam sodales vel neque eget eleifend. Vivamus in condimentum elit, consectetur commodo ex. Suspendisse rutrum, sapien efficitur cursus sodales, dolor orci pulvinar mauris, eu fringilla leo ex id leo. Interdum et malesuada fames ac ante ipsum primis in faucibus. Proin rhoncus sapien massa, molestie vestibulum augue hendrerit nec. Aliquam malesuada varius sapien id accumsan. Duis blandit aliquet felis, nec pellentesque lacus tincidunt et. Cras sed ligula vel nisl laoreet sagittis. Vestibulum ante ipsum primis in faucibus orci luctus et ultrices posuere cubilia Curae; Praesent tristique a neque aliquet aliquam.\",\n    78\t    \"Aliquam sed egestas felis. Maecenas sollicitudin nisl in sapien posuere vulputate. Suspendisse eleifend sem magna, interdum consectetur augue venenatis at. Vivamus ornare orci vel orci sodales maximus. Donec ultricies felis ac nulla fermentum gravida. Phasellus vulputate turpis odio, a varius nibh luctus et. Aliquam tincidunt, metus ut congue porttitor, nibh dui ullamcorper quam, a eleifend elit ipsum sit amet quam. Aenean venenatis mollis interdum. Nunc cursus ex sit amet enim lacinia hendrerit. Nullam at libero iaculis, consectetur velit in, porta sem. Ut mattis ut ex in imperdiet. Maecenas pellentesque sit amet dui eget vehicula. Sed posuere, arcu pretium convallis tincidunt, turpis leo dignissim felis, non euismod diam magna a risus. Suspendisse a arcu nec turpis pulvinar ullamcorper. Nunc iaculis malesuada elit eu pretium. Aenean a neque a sapien tincidunt faucibus.\",\n    79\t    \"Ut a eleifend augue, eget posuere augue. Proin purus neque, pretium condimentum ipsum ut, venenatis tincidunt nunc. In vitae odio in justo pharetra tincidunt. Maecenas vel tellus interdum, suscipit tellus sit amet, cursus justo. Mauris sollicitudin euismod molestie. Cras eros nisi, molestie vel elementum ut, consequat ac nunc. In consectetur nulla vitae interdum elementum. Praesent faucibus magna et iaculis congue. Curabitur convallis cursus porttitor. Praesent hendrerit justo ut sem convallis sollicitudin eu at odio.\",\n    80\t];\n    81\t\n    82\tpub fn blog_post(i: u64) -> BlogPost {\n    83\t    BlogPost {\n    84\t        title: format!(\"Blog post {i}\"),\n    85\t        content: PARAGRAPHS[(i % 5) as usize].to_owned(),\n    86\t        publication_date: SEPTEMBER_2020 + splitmix64(i) % THIRTY_DAYS,\n    87\t    }\n    88\t}\n    89\t\n    90\tpub fn blog_posts_checksum(n: u64) -> u64 {\n    91\t    (1..=n).map(|i| blog_post(i).checksum()).sum()\n    92\t}\n    93\t\n    94\t/// Like [`blog_posts_checksum`], but also checks that the `i`-th created id returns the `i`-th post.\n    95\tpub fn blog_posts_by_number_checksum(n: u64) -> u64 {\n    96\t    (1..=n)\n    97\t        .map(|i| mix(i, blog_post(i).checksum()))\n    98\t        .fold(0, u64::wrapping_add)\n    99\t}\n   100\tusing System.Text;\n   101\t\n   102\tnamespace Comparisons.SQLiteVSDoublets;\n   103\t\n   104\t/// <summary>Deterministic data shared by every storage and by the Rust implementation.</summary>\n   105\tpublic static class Dataset\n   106\t{\n   107\t    private const ulong GoldenGamma = 0x9E37_79B9_7F4A_7C15;\n   108\t\n   109\t    public static ulong SplitMix64(ulong x)\n   110\t    {\n   111\t        var z = x + GoldenGamma;\n   112\t        z = (z ^ (z >> 30)) * 0xBF58_476D_1CE4_E5B9;\n   113\t        z = (z ^ (z >> 27)) * 0x94D0_49BB_1331_11EB;\n   114\t        return z ^ (z >> 31);\n   115\t    }\n   116\t\n   117\t    /// <summary>\n   118\t    /// The <c>(From, To)</c> pair of the link with id <paramref name=\"i\"/>: both reference already created ids\n   119\t    /// and <c>From + To == i + 1</c>, so every pair is unique.\n   120\t    /// </summary>\n   121\t    public static (ulong From, ulong To) Link(ulong i)\n   122\t    {\n   123\t        var from = 1 + (SplitMix64(2 * i) % i);\n   124\t        return (from, i + 1 - from);\n   125\t    }\n   126\t\n   127\t    /// <summary>\n   128\t    /// Order-sensitive mix of two numbers; summing mixes detects records that are lost,\n   129\t    /// duplicated or associated with the wrong id.\n   130\t    /// </summary>\n   131\t    public static ulong Mix(ulong a, ulong b) => ((a * GoldenGamma) ^ b) * GoldenGamma;\n   132\t\n   133\t    public static ulong LinkChecksum(ulong id, ulong from, ulong to) => Mix(Mix(id, from), to);\n   134\t\n   135\t    public static ulong LinksChecksum(ulong n, bool swapped)\n   136\t    {\n   137\t        ulong checksum = 0;\n   138\t        for (ulong i = 1; i <= n; i++)\n   139\t        {\n   140\t            var (from, to) = Link(i);\n   141\t            checksum += swapped ? LinkChecksum(i, to, from) : LinkChecksum(i, from, to);\n   142\t        }\n   143\t        return checksum;\n   144\t    }\n   145\t\n   146\t    /// <summary>\n   147\t    /// Visits <c>1..=n</c> once each in a scattered order, so point operations do not hit\n   148\t    /// neighbouring records one after another.\n   149\t    /// </summary>\n   150\t    public static IEnumerable<ulong> Scattered(ulong n)\n   151\t    {\n   152\t        var stride = GoldenGamma % Math.Max(n, 1);\n   153\t        while (Gcd(stride, n) != 1)\n   154\t        {\n   155\t            stride++;\n   156\t        }\n   157\t        for (ulong k = 0; k < n; k++)\n   158\t        {\n   159\t            yield return 1 + ((k * stride) % n);\n   160\t        }\n   161\t    }\n   162\t\n   163\t    private static ulong Gcd(ulong a, ulong b) => b == 0 ? a : Gcd(b, a % b);\n   164\t\n   165\t    private const ulong September2020 = 1_600_000_000;\n   166\t    private const ulong ThirtyDays = 30 * 24 * 60 * 60;\n   167\t\n   168\t    private static readonly string[] Paragraphs =\n   169\t    [\n   170\t        \"Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis malesuada blandit mauris nec bibendum. Phasellus feugiat vehicula mauris et aliquet. Integer et gravida velit, in rutrum leo. Duis pretium, nunc ac posuere porttitor, augue sapien commodo tortor, nec consequat lorem eros ultricies odio. Aliquam varius congue ex nec viverra. Pellentesque eu velit tellus. Donec ac luctus nisi. Curabitur dignissim sodales mauris eu semper. Ut pretium lorem nulla, sit amet auctor arcu placerat vitae. Quisque lacinia dolor et consectetur fermentum. Nam ac orci vitae nulla aliquam tempor ac a nibh. Ut ac tincidunt lacus. Morbi vitae felis lorem.\",\n   171\t        \"Curabitur tincidunt nibh sit amet finibus dictum. Suspendisse aliquet arcu non rutrum ultrices. Integer ullamcorper mauris sit amet nibh aliquam, et tempor turpis hendrerit. In molestie elit et mauris rutrum, non auctor ligula ultricies. Vestibulum dignissim mauris finibus libero interdum hendrerit. Nunc vitae ipsum porttitor, egestas magna ut, sagittis sem. Donec euismod ac tortor vel porta. Vivamus convallis, ex at vestibulum rutrum, velit purus venenatis metus, sit amet aliquam sapien nibh quis elit. Aenean id neque a orci sodales venenatis. Integer ut orci ligula. Interdum et malesuada fames ac ante ipsum primis in faucibus. Praesent molestie dolor non lobortis ornare. Duis quis nisl sollicitudin, accumsan ante sed, eleifend velit. Maecenas maximus sed ante nec auctor.\",\n   172\t        \"Donec vitae felis lectus. Aenean velit sapien, porttitor ut feugiat a, consectetur et risus. Proin ac viverra sem. Nullam sagittis ex tortor, eu pellentesque tellus efficitur at. Nunc non egestas leo. Nam