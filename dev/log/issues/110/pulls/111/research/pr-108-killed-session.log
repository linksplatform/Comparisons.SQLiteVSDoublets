 && (link.Source == victim.Id || link.Target == victim.Id))) continue;\n        links.Delete(victim.Id);\n        alive.Remove(victim.Id);\n        foreach (var link in alive.Values)\n        {\n            if (links.SearchOrDefault(link.Source, link.Target) != link.Id)\n                return $\"after deleting ({victim.Id}: {victim.Source} {victim.Target}) search({link.Source}, {link.Target}) = {links.SearchOrDefault(link.Source, link.Target)}, expected {link.Id}; links {string.Join(\" \", created.Select(l => $\"({l.Id}: {l.Source} {l.Target})\"))}\";\n        }\n    }\n    return null;\n}\nEOF\ntimeout 600 dotnet run 2>&1 | tail -5",
