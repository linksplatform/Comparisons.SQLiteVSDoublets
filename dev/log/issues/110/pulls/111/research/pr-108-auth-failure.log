[2026-10-04T16:55:40.417Z] [INFO]                 "+            let (from, to) = link(i);",
[2026-10-04T16:55:40.417Z] [INFO]                 "+            store.update(i, to, from).unwrap();",
[2026-10-04T16:55:40.417Z] [INFO]                 "+        }",
[2026-10-04T16:55:40.417Z] [INFO]                 "+    }",
[2026-10-04T16:55:40.417Z] [INFO]                 "+    let ids: Vec<u32> = if reverse_delete { (1..=n).rev().collect() } else { (1..=n).collect() };",
[2026-10-04T16:55:40.417Z] [INFO]                 "+    for id in ids {",
[2026-10-04T16:55:40.417Z] [INFO]                 "+        store.delete(id).unwrap();",
[2026-10-04T16:55:40.417Z] [INFO]                 "+    }",
[2026-10-04T16:55:40.417Z] [INFO]                 "+    println!(\"{name} n={n} swap={swap} reverse_delete={reverse_delete}: ok, count = {}\", store.count());",
[2026-10-04T16:55:40.417Z] [INFO]                 "+}",
[2026-10-04T16:55:40.417Z] [INFO]                 "+",
[2026-10-04T16:55:40.417Z] [INFO]                 "+fn main() {",
[2026-10-04T16:55:40.417Z] [INFO]                 "+    let args: Vec<String> = std::env::args().collect();",
[2026-10-04T16:55:40.417Z] [INFO]                 "+    let kind = args[1].as_str();",
[2026-10-04T16:55:40.417Z] [INFO]                 "+    let n: u32 = args[2].parse().unwrap();",
[2026-10-04T16:55:40.417Z] [INFO]                 "+    let swap = args[3] == \"swap\";",
[2026-10-04T16:55:40.417Z] [INFO]                 "+    let reverse = args[4] == \"reverse\";",
[2026-10-04T16:55:40.417Z] [INFO]                 "+    match kind {",
[2026-10-04T16:55:40.417Z] [INFO]                 "+        \"unit\" => run(kind, unit::Store::<u32, _>::new(Global::new()).unwrap(), n, swap, reverse),",
[2026-10-04T16:55:40.417Z] [INFO]                 "+        _ => run(kind, split::Store::<u32, _, _>::new(Global::new(), Global::new()).unwrap(), n, swap, reverse),",
[2026-10-04T16:55:40.417Z] [INFO]                 "+    }",
[2026-10-04T16:55:40.417Z] [INFO]                 "+}"
[2026-10-04T16:55:40.417Z] [INFO]               ]
[2026-10-04T16:55:40.417Z] [INFO]             }
