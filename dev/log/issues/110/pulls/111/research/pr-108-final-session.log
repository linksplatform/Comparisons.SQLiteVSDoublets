[2026-10-05T00:28:09.481Z] [INFO]         "content": "     1\tusing System.Diagnostics;\n     2\tusing System.Numerics;\n     3\tusing System.Text.Json.Nodes;\n     4\tusing Platform.Data;\n     5\tusing Platform.Data.Doublets;\n     6\tusing Platform.Data.Doublets.Memory;\n     7\tusing Platform.Data.Doublets.Memory.Split.Generic;\n     8\tusing Platform.Data.Doublets.Memory.United.Generic;\n     9\tusing Platform.Memory;\n    10\tusing static Comparisons.SQLiteVSDoublets.Dataset;\n    11\t\n    12\tnamespace Comparisons.SQLiteVSDoublets;\n    13\t\n    14\t/// <summary>\n    15\t/// Runs every storage through the same lifecycle on a fresh store per repetition:\n    16\t/// a timed batch per operation, each validated against the expected count and checksum.\n    17\t/// </summary>\n    18\tpublic static class Harness\n    19\t{\n    20\t    public static readonly string[] LinksVariants =\n    21\t    [\n    22\t        \"SQLite_Memory\",\n    23\t        \"SQLite_File\",\n    24\t        \"Doublets_United_Volatile\",\n    25\t        \"Doublets_United_NonVolatile\",\n    26\t        \"Doublets_Split_Volatile\",\n    27\t        \"Doublets_Split_NonVolatile\",\n    28\t    ];\n    29\t\n    30\t    public static readonly string[] ObjectsVariants =\n    31\t    [\n    32\t        \"SQLite_Memory\",\n    33\t        \"SQLite_File\",\n    34\t        \"Doublets_United_Volatile_Cached\",\n    35\t        \"Doublets_United_Volatile_Uncached\",\n    36\t        \"Doublets_United_NonVolatile_Cached\",\n    37\t        \"Doublets_United_NonVolatile_Uncached\",\n    38\t        \"Doublets_Split_Volatile_Cached\",\n    39\t        \"Doublets_Split_Volatile_Uncached\",\n    40\t        \"Doublets_Split_NonVolatile_Cached\",\n    41\t        \"Doublets_Split_NonVolatile_Uncached\",\n    42\t    ];\n    43\t\n    44\t    public const ulong WarmUpSize = 10_000;\n    45\t\n    46\t    /// <summary>Count and order-sensitive checksum of the records an operation has seen.</summary>\n    47\t    public record struct Tally(ulong Count, ulong Checksum)\n    48\t    {\n    49\t        public void Add(ulong checksum)\n    50\t        {\n    51\t            Count++;\n    52\t            Checksum += checksum;\n    53\t        }\n    54\t\n    55\t        public void AddLink<T>(Link<T> link) where T : IBinaryInteger<T> =>\n    56\t            Add(LinkChecksum(ulong.CreateChecked(link.Id), ulong.CreateChecked(link.From), ulong.CreateChecked(link.To)));\n    57\t    }\n    58\t\n    59\t    private static void Timed(List<(string, TimeSpan)> timings, string operation, Tally expected, Func<Tally> work)\n    60\t    {\n    61\t        var stopwatch = Stopwatch.StartNew();\n    62\t        var actual = work();\n    63\t        timings.Add((operation, stopwatch.Elapsed));\n    64\t        Check(actual == expected, $\"{operation} returned unexpected records: {actual} instead of {expected}\");\n    65\t    }\n    66\t\n    67\t    private static void Check(bool condition, string message)\n    68\t    {\n    69\t        if (!condition)\n    70\t        {\n    71\t            throw new InvalidOperationException(message);\n    72\t        }\n    73\t    }\n    74\t\n    75\t    public static List<(string, TimeSpan)> LinksLifecycle<T>(ILinksStorage<T> storage, ulong n, Action created)\n    76\t        where T : struct, IBinaryInteger<T>\n    77\t    {\n    78\t        static T Int(ulong value) => T.CreateChecked(value);\n    79\t        var expected = new Tally(n, LinksChecksum(n, false));\n    80\t        var timings = new List<(string, TimeSpan)>();\n    81\t\n    82\t        Timed(timings, \"create\", expected, () => storage.Transaction(() =>\n    83\t        {\n    84\t            var tally = new Tally();\n    85\t            for (ulong i = 1; i <= n; i++)\n    86\t            {\n    87\t                var (from, to) = Link(i);\n    88\t                var id = storage.Create(Int(from), Int(to));\n    89\t                tally.AddLink(new Link<T>(id, Int(from), Int(to)));\n    90\t            }\n    91\t            return tally;\n    92\t        }));\n    93\t        created();\n    94\t\n    95\t        Timed(timings, \"query_all\", expected, () => storage.Transaction(() =>\n    96\t        {\n    97\t            var tally = new Tally();\n    98\t            storage.Each(link => tally.AddLink(link));\n    99\t            return tally;\n   100\t        }));\n   101\t        Timed(timings, \"query_by_id\", expected, () => storage.Transaction(() =>\n   102\t        {\n   103\t            var tally = new Tally();\n   104\t            foreach (var id in Scattered(n))\n   105\t            {\n   106\t                tally.AddLink(storage.Get(Int(id))!.Value);\n   107\t            }\n   108\t            return tally;\n   109\t        }));\n   110\t        Timed(timings, \"query_by_from_to\", expected, () => storage.Transaction(() =>\n   111\t        {\n   112\t            var tally = new Tally();\n   113\t            foreach (var i in Scattered(n))\n   114\t            {\n   115\t                var (from, to) = Link(i);\n   116\t                var id = storage.Search(Int(from), Int(to))!.Value;\n   117\t                tally.AddLink(new Link<T>(id, Int(from), Int(to)));\n   118\t            }\n   119\t            return tally;\n   120\t        }));\n   121\t        Timed(timings, \"query_by_from\", expected, () => storage.Transaction(() =>\n   122\t        {\n   123\t            var tally = new Tally();\n   124\t            foreach (var from in Scattered(n))\n   125\t            {\n   126\t                storage.EachWithFrom(Int(from), link => tally.AddLink(link));\n   127\t            }\n   128\t            return tally;\n   129\t        }));\n   130\t        Timed(timings, \"query_by_to\", expected, () => storage.Transaction(() =>\n   131\t        {\n   132\t            var tally = new Tally();\n   133\t            foreach (var to in Scattered(n))\n   134\t            {\n   135\t                storage.EachWithTo(Int(to), link => tally.AddLink(link));\n   136\t            }\n   137\t            return tally;\n   138\t        }));\n   139\t\n   140\t        var swapped = new Tally(n, LinksChecksum(n, true));\n   141\t        Timed(timings, \"update\", swapped, () => storage.Transaction(() =>\n   142\t        {\n   143\t            var tally = new Tally();\n   144\t            foreach (var id in Scattered(n))\n   145\t            {\n   146\t                var (from, to) = Link(id);\n   147\t                storage.Update(Int(id), Int(to), Int(from));\n   148\t                tally.Add(LinkChecksum(id, to, from));\n   149\t            }\n   150\t            return tally;\n   151\t        }));\n   152\t        var stored = new Tally();\n   153\t        storage.Each(link => stored.AddLink(link));\n   154\t        Check(stored == swapped, \"update did not swap every link\");\n   155\t\n   156\t        Timed(timings, \"delete\", new Tally(n, 0), () => storage.Transaction(() =>\n   157\t        {\n   158\t            var tally = new Tally();\n   159\t            foreach (var id in Scattered(n))\n   160\t            {\n   161\t                storage.Delete(Int(id));\n   162\t                tally.Add(0);\n   163\t            }\n   164\t            return tally;\n   165\t        }));\n   166\t        Check(storage.Count() == 0, \"delete left links behind\");\n   167\t        return timings;\n   168\t    }\n   169\t\n   170\t    public static List<(string, TimeSpan)> ObjectsLifecycle<T>(IBlogPostsStorage<T> storage, ulong n, Action created)\n   171\t        where T : struct, IBinaryInteger<T>\n   172\t    {\n   173\t        var expected = new Tally(n, BlogPostsChecksum(n));\n   174\t        var timings = new List<(string, TimeSpan)>();\n   175\t        var ids = new List<T>((int)n);\n   176\t\n   177\t        Timed(timings, \"create\", expected, () => storage.Transaction(() =>\n   178\t        {\n   179\t            var tally = new Tally();\n   180\t            for (ulong i = 1; i <= n; i++)\n   181\t            {\n   182\t                var post = BlogPost(i);\n   183\t                ids.Add(storage.Create(post));\n   184\t                tally.Add(post.Checksum);\n   185\t            }\n   186\t            return tally;\n   187\t        }));\n   188\t        created();\n   189\t\n   190\t        Timed(timings, \"read_all\", expected, () => storage.Transaction(() =>\n   191\t        {\n   192\t            var tally = new Tally();\n   193\t            storage.Each((_, post) => tally.Add(post.Checksum));\n   194\t            return tally;\n   195\t        }));\n   196\t        Timed(timings, \"read_by_id\", new Tally(n, BlogPostsByNumberChecksum(n)), () => storage.Transaction(() =>\n   197\t        {\n   198\t            var tally = new Tally();\n   199\t            foreach (var i in Scattered(n))\n   200\t            {\n   201\t                var post = storage.Get(ids[(int)i - 1])!;\n   202\t                tally.Add(Mix(i, post.Checksum));\n   203\t            }\n   204\t            return tally;\n   205\t        }));\n   206\t        Timed(timings, \"delete\", new Tally(n, 0), () => storage.Transaction(() =>\n   207\t        {\n   208\t            var tally = new Tally();\n   209\t            foreach (var i in Scattered(n))\n   210\t            {\n   211\t                storage.Delete(ids[(int)i - 1]);\n   212\t                tally.Add(0);\n   213\t            }\n   214\t            return tally;\n   215\t        }));\n   216\t        Check(storage.Count() == 0, \"delete left blog posts behind\");\n   217\t        return timings;\n   218\t    }\n   219\t\n   220\t    public sealed record Measurement(string Variant, ulong? FileBytes, List<(string Operation, List<double> Samples)> Operations)\n   221\t    {\n   222\t        public JsonObject ToJson()\n   223\t        {\n   224\t            var operations = new JsonObject();\n   225\t            foreach (var (operation, samples) in Operations)\n   226\t            {\n   227\t                var sorted = samples.Order().ToList();\n   228\t                var middle = sorted.Count / 2;\n   229\t                var median = sorted.Count % 2 == 0 ? (sorted[middle - 1] + sorted[middle]) / 2 : sorted[middle];\n   230\t                operations[operation] = new JsonObject\n   231\t                {\n   232\t                    [\"median_ns\"] = median,\n   233\t                    [\"min_ns\"] = sorted[0],\n   234\t                    [\"max_ns\"] = sorted[^1],\n   235\t                    [\"samples_ns\"] = new JsonArray(samples.Select(sample => (JsonNode)sample).ToArray()),\n   236\t                };\n   237\t            }\n   238\t            return new JsonObject { [\"variant\"] = Variant, [\"file_bytes\"] = FileBytes, [\"operations\"] = operations };\n   239\t        }\n   240\t    }\n   241\t\n   242\t    private static ulong DirectoryBytes(string directory) =>\n   243\t        (ulong)new DirectoryInfo(directory).GetFiles().Sum(file => file.Length);\n   244\t\n   245\t    /// <summary>\n   246\t    /// Times <paramref name=\"lifecycle\"/> on <paramref name=\"repetitions\"/> fresh stores opened in empty directories,\n   247\t    /// after one discarded warm-up.\n   248\t    /// </summary>\n   249\t    private static Measurement Measure<TStorage>(\n   250\t        string variant,\n   251\t        ulong n,\n   252\t        int repetitions,\n   253\t        string directory,\n   254\t        Func<string, TStorage> open,\n   255\t        Func<TStorage, ulong, Action, List<(string, TimeSpan)>> lifecycle)\n   256\t        where TStorage : IDisposable\n   257\t    {\n   258\t        var measurement = new Measurement(variant, null, []);\n   259\t        for (var repetition = 0; repetition <= repetitions; repetition++)\n   260\t        {\n   261\t            var size = repetition == 0 ? Math.Min(n, WarmUpSize) : n;\n   262\t            var workspace = Path.Combine(directory, $\"{variant}-{repetition}\");\n   263\t            Directory.CreateDirectory(workspace);\n   264\t            GC.Collect();\n   265\t            GC.WaitForPendingFinalizers();\n   266\t            ulong fileBytes = 0;\n   267\t            List<(string, TimeSpan)> timings;\n   268\t            using (var storage = open(workspace))\n   269\t            {\n   270\t                timings = lifecycle(storage, size, () => fileBytes = DirectoryBytes(workspace));\n   271\t            }\n   272\t            Directory.Delete(workspace, true);\n   273\t            if (repetition == 0)\n   274\t            {\n   275\t                continue;\n   276\t            }\n   277\t            Console.Error.WriteLine($\"{variant} #{repetition}: {Summary(timings, n)}\");\n   278\t            measurement = measurement with { FileBytes = fileBytes > 0 ? fileBytes : null };\n   279\t            foreach (var (operation, elapsed) in timings)\n   280\t            {\n   281\t                var nsPerOperation = elapsed.TotalNanoseconds / n;\n   282\t                var index = measurement.Operations.FindIndex(entry => entry.Operation == operation);\n   283\t                if (index < 0)\n   284\t                {\n   285\t                    measurement.Operations.Add((operation, [nsPerOperation]));\n   286\t                }\n   287\t                else\n   288\t                {\n   289\t                    measurement.Operations[index].Samples.Add(nsPerOperation);\n   290\t                }\n   291\t            }\n   292\t        }\n   293\t        return measurement;\n   294\t    }\n   295\t\n   296\t    private static string Summary(List<(string Operation, TimeSpan Elapsed)> timings, ulong n) =>\n   297\t        string.Join(\", \", timings.Select(timing => $\"{timing.Operation} {timing.Elapsed.TotalNanoseconds / n:F0} ns/op\"));\n   298\t\n   299\t    private static string File(string directory, string name) => Path.Combine(directory, name);\n   300\t\n   301\t    private static FileMappedResizableDirectMemory Mapped(string directory, string name) => new(File(directory, name));\n   302\t\n   303\t    /// <summary>Objects store numbers and Unicode symbols as raw numbers, which are external references.</summary>\n   304\t    /// <remarks>\n   305\t    /// The size balanced index trees (the default) degenerate when many links share a source or a target,\n   306\t    /// which makes every blog post creation linear in the number of stored posts;\n   307\t    /// the AVL trees stay logarithmic (see experiments/csharp_objects_profile).\n   308\t    /// </remarks>\n   309\t    public static ILinks<T> United<T>(IResizableDirectMemory memory, bool external = false) where T : struct, IBinaryInteger<T>, IUnsignedNumber<T>, IMinMaxValue<T> =>\n   310\t        new UnitedMemoryLinks<T>(memory, UnitedMemoryLinks<T>.DefaultLinksSizeStep, new LinksConstants<T>(external), IndexTreeType.SizedAndThreadedAVLBalancedTree);\n   311\t\n   312\t    public static ILinks<T> Split<T>(IResizableDirectMemory data, IResizableDirectMemory index, bool external = false) where T : struct, IBinaryInteger<T>, IUnsignedNumber<T>, IMinMaxValue<T> =>\n   313\t        new SplitMemoryLinks<T>(data, index, SplitMemoryLinks<T>.DefaultLinksSizeStep, new LinksConstants<T>(external));\n   314\t\n   315\t    public static Measurement MeasureLinks<T>(string variant, ulong n, int repetitions, string directory)\n   316\t        where T : struct, IBinaryInteger<T>, IUnsignedNumber<T>, IMinMaxValue<T>\n   317\t    {\n   318\t        Func<string, ILinksStorage<T>> open = variant switch\n   319\t        {\n   320\t            \"SQLite_Memory\" => _ => SQLiteLinks<T>.InMemory(),\n   321\t            \"SQLite_File\" => dir => SQLiteLinks<T>.Open(File(dir, \"links.db\")),\n   322\t            \"Doublets_United_Volatile\" => _ => new DoubletsLinks<T>(United<T>(new HeapResizableDirectMemory())),\n   323\t            \"Doublets_United_NonVolatile\" => dir => new DoubletsLinks<T>(United<T>(Mapped(dir, \"links.links\"))),\n   324\t            \"Doublets_Split_Volatile\" => _ => new DoubletsLinks<T>(Split<T>(new HeapResizableDirectMemory(), new HeapResizableDirectMemory())),\n   325\t            \"Doublets_Split_NonVolatile\" => dir => new DoubletsLinks<T>(Split<T>(Mapped(dir, \"data.links\"), Mapped(dir, \"index.links\"))),\n   326\t            _ => throw new ArgumentException($\"unknown links variant {variant}\"),\n   327\t        };\n   328\t        return Measure(variant, n, repetitions, directory, open, LinksLifecycle);\n   329\t    }\n   330\t\n   331\t    public static Measurement MeasureObjects<T>(string variant, ulong n, int repetitions, string directory)\n   332\t        where T : struct, IBinaryInteger<T>, IUnsignedNumber<T>, IMinMaxValue<T>\n   333\t    {\n   334\t        var cached = variant.EndsWith(\"_Cached\");\n   335\t        Func<string, IBlogPostsStorage<T>> open = variant.Replace(\"_Uncached\", \"\").Replace(\"_Cached\", \"\") switch\n   336\t        {\n   337\t            \"SQLite_Memory\" => _ => SQLiteBlogPosts<T>.InMemory(),\n   338\t            \"SQLite_File\" => dir => SQLiteBlogPosts<T>.Open(File(dir, \"blog_posts.db\")),\n   339\t            \"Doublets_United_Volatile\" => _ => new DoubletsBlogPosts<T>(United<T>(new HeapResizableDirectMemory(), external: true), cached),\n   340\t            \"Doublets_United_NonVolatile\" => dir => new DoubletsBlogPosts<T>(United<T>(Mapped(dir, \"links.links\"), external: true), cached),\n   341\t            \"Doublets_Split_Volatile\" => _ => new DoubletsBlogPosts<T>(Split<T>(new HeapResizableDirectMemory(), new HeapResizableDirectMemory(), external: true), cached),\n   342\t            \"Doublets_Split_NonVolatile\" => dir => new DoubletsBlogPosts<T>(Split<T>(Mapped(dir, \"data.links\"), Mapped(dir, \"index.links\"), external: true), cached),\n   343\t            _ => throw new ArgumentException($\"unknown objects variant {variant}\"),\n   344\t        };\n   345\t        return Measure(variant, n, repetitions, directory, open, ObjectsLifecycle);\n   346\t    }\n   347\t}\n   348\tusing Microsoft.Data.Sqlite;\n   349\t\n   350\tnamespace Comparisons.SQLiteVSDoublets;\n   351\t\n   352\t/// <summary>A connection with reusable prepared commands that all join the current transaction.</summary>\n   353\tpublic abstract class SQLiteStorage : IDisposable\n   354\t{\n   355\t    private readonly SqliteConnection _connection;\n   356\t    private readonly List<SqliteCommand> _commands = [];\n   357\t    private readonly string _table;\n   358\t\n   359\t    protected SQLiteStorage(string path, string table, string schema)\n   360\t    {\n   361\t        _connection = new SqliteConnection($\"Data Source={path};Pooling=False\");\n   362\t        _connection.Open();\n   363\t        _table = table;\n   364\t        using var create = _connection.CreateCommand();\n   365\t        create.CommandText = schema;\n   366\t        create.ExecuteNonQuery();\n   367\t    }\n   368\t\n   369\t    protected SqliteCommand Command(string sql, params (string Name, SqliteType Type)[] parameters)\n   370\t    {\n   371\t        var command = _connection.CreateCommand();\n   372\t        command.CommandText = sql;\n   373\t        foreach (var (name, type) in parameters)\n   374\t        {\n   375\t            command.Parameters.Add(name, type);\n   376\t        }\n   377\t        _commands.Add(command);\n   378\t        return command;\n   379\t    }\n   380\t\n   381\t    public ulong Count()\n   382\t    {\n   383\t        using var count = _connection.CreateCommand();\n   384\t        count.CommandText = $\"SELECT COUNT(*) FROM {_table}\";\n   385\t        return (ulong)(long)count.ExecuteScalar()!;\n   386\t    }\n   387\t\n   388\t    public TResult Transaction<TResult>(Func<TResult> work)\n   389\t    {\n   390\t        using var transaction = _connection.BeginTransaction();\n   391\t        _commands.ForEach(command => command.Transaction = transaction);\n   392\t        try\n   393\t        {\n   394\t            var result = work();\n   395\t            transaction.Commit();\n   396\t            return result;\n   397\t        }\n   398\t        finally\n   399\t        {\n   400\t            _commands.ForEach(command => command.Transaction = null);\n   401\t        }\n   402\t    }\n   403\t\n   404\t    public void Dispose()\n   405\t    {\n   406\t        _commands.ForEach(command => command.Dispose());\n   407\t        _connection.Dispose();\n   408\t    }\n   409\t}\n   410\t// Usage: sqlite-vs-doublets <links|objects> <32|64> <size> [--work N | --repetitions N]\n   411\t//        [--variants A,B] [--directory DIR] [--output FILE]\n   412\t//\n   413\t// Repetitions default to `work / size` clamped to 1..=MaxRepetitions, so smaller sizes get more,\n   414\t// but not endless, repetitions. Objects get less work, because one blog post takes hundreds of links.\n   415\t\n   416\tusing System.Text.Json;\n   417\tusing System.Text.Json.Nodes;\n   418\tusing Comparisons.SQLiteVSDoublets;\n   419\tusing Microsoft.Data.Sqlite;\n   420\t\n   421\tconst ulong LinksWork = 3_000_000;\n   422\tconst ulong ObjectsWork = 500_000;\n   423\tconst ulong MaxRepetitions = 10;\n   424\t\n   425\tvar (category, bits, sizeText) = (args[0], args[1], args[2]);\n   426\tvar options = args[3..].Chunk(2).ToDictionary(pair => pair[0].TrimStart('-'), pair => pair[1]);\n   427\tstatic ulong Number(string text) => ulong.Parse(text.Replace(\"_\", \"\"));\n   428\tvar size = Number(sizeText);\n   429\tvar work = options.TryGetValue(\"work\", out var workText) ? Number(workText) : category == \"links\" ? LinksWork : ObjectsWork;\n   430\tvar repetitions = options.TryGetValue(\"repetitions\", out var count)\n   431\t    ? int.Parse(count)\n   432\t    : (int)Math.Clamp(work / size, 1, MaxRepetitions);\n   433\tvar allVariants = category == \"links\" ? Harness.LinksVariants : Harness.ObjectsVariants;\n   434\tvar variants = options.TryGetValue(\"variants\", out var names)\n   435\t    ? names.Split(',').Select(name => allVariants.Contains(name) ? name : throw new ArgumentException(name)).ToArray()\n   436\t    : allVariants;\n   437\tvar directory = options.GetValueOrDefault(\"directory\") ?? Path.GetTempPath();\n   438\t\n   439\tvar measurements = variants.Select(variant => (category, bits) switch\n   440\t{\n   441\t    (\"links\", \"32\") => Harness.MeasureLinks<uint>(variant, size, repetitions, directory),\n   442\t    (\"links\", \"64\") => Harness.MeasureLinks<ulong>(variant, size, repetitions, directory),\n   443\t    (\"objects\", \"32\") => Harness.MeasureObjects<uint>(variant, size, repetitions, directory),\n   444\t    (\"objects\", \"64\") => Harness.MeasureObjects<ulong>(variant, size, repetitions, directory),\n   445\t    _ => throw new ArgumentException(\"category must be links or objects and bits must be 32 or 64\"),\n   446\t}).ToList();\n   447\t\n   448\tusing var connection = new SqliteConnection(\"Data Source=:memory:\");\n   449\tconnection.Open();\n   450\tusing var version = connection.CreateCommand();\n   451\tversion.CommandText = \"SELECT sqlite_version()\";\n   452\tvar report = new JsonObject\n   453\t{\n   454\t    [\"language\"] = \"C#\",\n   455\t    [\"category\"] = category,\n   456\t    [\"bits\"] = int.Parse(bits),\n   457\t    [\"size\"] = size,\n   458\t    [\"repetitions\"] = repetitions,\n   459\t    [\"warm_up_size\"] = Math.Min(size, Harness.WarmUpSize),\n   460\t    [\"sqlite_version\"] = (string)version.ExecuteScalar()!,\n   461\t    [\"results\"] = new JsonArray(measurements.Select(measurement => (JsonNode)measurement.ToJson()).ToArray()),\n   462\t};\n   463\tvar json = report.ToJsonString(new JsonSerializerOptions { WriteIndented = true });\n   464\tif (options.TryGetValue(\"output\", out var output))\n   465\t{\n   466\t    File.WriteAllText(output, json);\n   467\t}\n   468\telse\n   469\t{\n   470\t    Console.WriteLine(json);\n   471\t}",
