[2026-10-04T18:50:01.625Z] [INFO]               "lines": [
[2026-10-04T18:50:01.625Z] [INFO]                 "-use doublets::{Doublets, data::LinksConstants, mem::Global, unit};",
[2026-10-04T18:50:01.625Z] [INFO]                 "-use sqlite_vs_doublets::{dataset::blog_post, objects::{BlogPostsStorage, DoubletsBlogPosts}};",
[2026-10-04T18:50:01.625Z] [INFO]                 "-use std::panic;",
[2026-10-04T18:50:01.625Z] [INFO]                 "+//! Minimal reproduction of a `doublets` 0.5.0 and `platform-mem` 0.3.0 mismatch.",
[2026-10-04T18:50:01.625Z] [INFO]                 "+//!",
[2026-10-04T18:50:01.625Z] [INFO]                 "+//! `doublets::mem::resize_mem` returns what `RawMem::grow_filled` returns, and the stores use it as",
[2026-10-04T18:50:01.625Z] [INFO]                 "+//! their whole memory. `platform-mem` returns only the grown part. `Store::init` grows the memory",
[2026-10-04T18:50:01.625Z] [INFO]                 "+//! from 8,192 to 2^20 links, so a fresh store sees 1,040,384 links, while its header says that",
[2026-10-04T18:50:01.625Z] [INFO]                 "+//! 2^20 − 1 are reserved: creating link 1,040,384 panics with \"Data part should be in data memory\"",
[2026-10-04T18:50:01.625Z] [INFO]                 "+//! (or \"index out of bounds\" in a tree). A later growth would leave the store with an empty memory.",
[2026-10-04T18:50:01.625Z] [INFO]                 "+//!",
[2026-10-04T18:50:01.625Z] [INFO]                 "+//! Usage: `cargo run --release -- <bare|whole>`: `bare` panics, `whole` uses",
[2026-10-04T18:50:01.625Z] [INFO]                 "+//! `sqlite_vs_doublets::memory::Whole` and creates 2^21 + 1 links, growing the memory twice.",
[2026-10-04T18:50:01.625Z] [INFO]                 "+use doublets::{Doublets, Error, mem::Global, unit};",
[2026-10-04T18:50:01.625Z] [INFO]                 "+use sqlite_vs_doublets::memory::volatile;",
[2026-10-04T18:50:01.625Z] [INFO]                 "+use std::{env, panic};",
[2026-10-04T18:50:01.625Z] [INFO]                 " ",
[2026-10-04T18:50:01.625Z] [INFO]                 "-fn main() {",
[2026-10-04T18:50:01.625Z] [INFO]                 "-    let mut posts = DoubletsBlogPosts::new(",
[2026-10-04T18:50:01.625Z] [INFO]                 "-        unit::Store::<u64, _>::with_constants(Global::new(), LinksConstants::external()).unwrap(),",
[2026-10-04T18:50:01.625Z] [INFO]                 "-        true,",
[2026-10-04T18:50:01.625Z] [INFO]                 "-    );",
[2026-10-04T18:50:01.625Z] [INFO]                 "-    let mut last = 0;",
[2026-10-04T18:50:01.625Z] [INFO]                 "-    let result = panic::catch_unwind(panic::AssertUnwindSafe(|| {",
[2026-10-04T18:50:01.625Z] [INFO]                 "-        for i in 1..=200_000u64 {",
[2026-10-04T18:50:01.625Z] [INFO]                 "-            last = i;",
[2026-10-04T18:50:01.625Z] [INFO]                 "-            posts.create(&blog_post(i));",
[2026-10-04T18:50:01.625Z] [INFO]                 "+const LINKS: u64 = (1 << 21) + 1;",
[2026-10-04T18:50:01.625Z] [INFO]                 "+",
[2026-10-04T18:50:01.625Z] [INFO]                 "+fn create(mut store: impl Doublets<u64>) -> Result<u64, Error<u64>> {",
[2026-10-04T18:50:01.625Z] [INFO]                 "+    for i in 1..=LINKS {",
[2026-10-04T18:50:01.625Z] [INFO]                 "+        if i % 100_000 == 0 || (1_040_380..=1_040_390).contains(&i) {",
[2026-10-04T18:50:01.625Z] [INFO]                 "+            eprintln!(\"creating link {i}\");",
[2026-10-04T18:50:01.625Z] [INFO]                 "         }",
[2026-10-04T18:50:01.625Z] [INFO]                 "-    }));",
[2026-10-04T18:50:01.625Z] [INFO]                 "-    println!(\"stopped at post {last}: {:?}\", result.is_err());",
[2026-10-04T18:50:01.625Z] [INFO]                 "+        store.create_link(1, i.min(2))?;",
[2026-10-04T18:50:01.625Z] [INFO]                 "+    }",
[2026-10-04T18:50:01.625Z] [INFO]                 "+    assert_eq!(store.get_link(1).unwrap().target, 1);",
[2026-10-04T18:50:01.625Z] [INFO]                 "+    Ok(store.count())",
[2026-10-04T18:50:01.625Z] [INFO]                 " }",
[2026-10-04T18:50:01.625Z] [INFO]                 "+",
[2026-10-04T18:50:01.625Z] [INFO]                 "+fn main() {",
[2026-10-04T18:50:01.625Z] [INFO]                 "+    let result = panic::catch_unwind(|| match env::args().nth(1).as_deref() {",
[2026-10-04T18:50:01.625Z] [INFO]                 "+        Some(\"bare\") => create(unit::Store::<u64, _>::new(Global::new()).unwrap()),",
[2026-10-04T18:50:01.625Z] [INFO]                 "+        Some(\"whole\") => create(unit::Store::<u64, _>::new(volatile()).unwrap()),",
[2026-10-04T18:50:01.625Z] [INFO]                 "+        _ => panic!(\"usage: unit_store_growth <bare|whole>\"),",
[2026-10-04T18:50:01.625Z] [INFO]                 "+    });",
[2026-10-04T18:50:01.625Z] [INFO]                 "+    println!(\"{result:?}\");",
[2026-10-04T18:50:01.625Z] [INFO]                 "+}"
[2026-10-04T18:50:01.625Z] [INFO]               ]
[2026-10-04T18:50:01.625Z] [INFO]             }
[2026-10-04T18:50:01.625Z] [INFO]           ]
