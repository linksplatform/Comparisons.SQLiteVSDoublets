[2026-10-04T18:39:50.690Z] [INFO]         "content": "439:pub fn measure_objects<T: LinkReference>(\n440:    variant: &'static str,\n441:    n: u64,\n442:    repetitions: usize,\n443:    directory: &Path,\n444:) -> Measurement {\n445:    let cached = variant.ends_with(\"_Cached\");\n446:    match variant\n447:        .trim_end_matches(\"_Cached\")\n448:        .trim_end_matches(\"_Uncached\")\n449:    {\n450:        \"SQLite_Memory\" => measure(\n451:            variant,\n452:            n,\n453:            repetitions,\n454:            directory,\n455:            |_| SqliteBlogPosts::<T>::in_memory(),\n456:            objects_lifecycle,\n457:        ),\n458:        \"SQLite_File\" => measure(\n459:            variant,\n460:            n,\n461:            repetitions,\n462:            directory,\n463:            |dir| SqliteBlogPosts::<T>::open(file(dir, \"blog_posts.db\")),\n464:            objects_lifecycle,\n465:        ),\n466:        \"Doublets_United_Volatile\" => measure(\n467:            variant,\n468:            n,\n469:            repetitions,\n470:            directory,\n471:            |_| {\n472:                DoubletsBlogPosts::new(\n473:                    unit::Store::<T, _>::with_constants(Global::new(), LinksConstants::external())\n474:                        .unwrap(),\n475:                    cached,\n476:                )\n477:            },\n478:            objects_lifecycle,\n479:        ),\n480:        \"Doublets_United_NonVolatile\" => measure(\n481:            variant,\n482:            n,\n483:            repetitions,\n484:            directory,\n485:            |dir| {\n486:                DoubletsBlogPosts::new(\n487:                    unit::Store::<T, _>::with_constants(\n488:                        mapped(dir, \"links.links\"),\n489:                        LinksConstants::external(),\n490:                    )\n491:                    .unwrap(),\n492:                    cached,\n493:                )\n494:            },\n495:            objects_lifecycle,\n496:        ),\n497:        \"Doublets_Split_Volatile\" => measure(\n498:            variant,\n499:            n,\n500:            repetitions,\n501:            directory,\n502:            |_| {\n503:                DoubletsBlogPosts::new(\n504:                    split::Store::<T, _, _>::with_constants(\n505:                        Global::new(),\n506:                        Global::new(),\n507:                        LinksConstants::external(),\n508:                    )\n509:                    .unwrap(),\n510:                    cached,\n511:                )\n512:            },\n513:            objects_lifecycle,\n514:        ),\n515:        \"Doublets_Split_NonVolatile\" => measure(\n516:            variant,\n517:            n,\n518:            repetitions,\n519:            directory,\n520:            |dir| {\n521:                DoubletsBlogPosts::new(\n522:                    split::Store::<T, _, _>::with_constants(\n523:                        mapped(dir, \"data.links\"),\n524:                        mapped(dir, \"index.links\"),\n525:                        LinksConstants::external(),\n526:                    )\n527:                    .unwrap(),\n528:                    cached,\n529:                )\n530:            },\n531:            objects_lifecycle,\n532:        ),\n533:        _ => panic!(\"unknown objects variant {variant}\"),\n534:    }\n535:}\nrust/src/harness.rs:205:    let mut ids = Vec::with_capacity(n as usize);\n//! Memory layout and store implementations for doublets.\n//!\n//! Two store backends are available:\n//! - [`mod@unit`] — a single contiguous memory region per store.\n//! - [`split`] — separate data and index memory regions.\n\npub use header::LinksHeader;\npub use traits::{\n    LinksList, LinksTree, SplitList, SplitTree, SplitUpdateMem, UnitTree, UnitUpdateMem,\n};\nmod header;\npub mod split;\nmod traits;\npub mod unit;\n\n#[cfg(feature = \"mem\")]\npub use ::mem::*;\n\npub mod parts {\n    pub use super::{\n        split::{DataPart, IndexPart},\n        unit::LinkPart,\n    };\n}\n\npub(crate) fn resize_mem<M: ::mem::RawMem>(\n    m: &mut M,\n    new_cap: usize,\n) -> ::mem::Result<&mut [M::Item]>\nwhere\n    M::Item: Default + Clone,\n{\n    let current = m.allocated().len();\n    if new_cap > current {\n        m.grow_filled(new_cap - current, M::Item::default())\n    } else if new_cap < current {\n        m.shrink(current - new_cap)?;\n        Ok(m.allocated_mut())\n    } else {\n        Ok(m.allocated_mut())\n    }\n}",
