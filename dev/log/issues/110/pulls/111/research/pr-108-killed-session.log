          "+        },",
          "+        \"language\": \"Дуплеты на {language} против SQLite\",",
          "+        \"bits\": \"Тесты с {bits}-битным пространством адресов/идентификаторов\",",
          "+        \"size\": {\"links\": \"{size} связей\", \"objects\": \"{size} записей блога\"},",
