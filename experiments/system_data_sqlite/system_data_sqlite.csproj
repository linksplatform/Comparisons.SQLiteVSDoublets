<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IncludeNativeSQLite Condition="'$(IncludeNativeSQLite)' == ''">true</IncludeNativeSQLite>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" Condition="'$(IncludeNativeSQLite)' == 'true'" />
    <PackageReference Include="System.Data.SQLite" Version="2.0.4" />
  </ItemGroup>
</Project>
