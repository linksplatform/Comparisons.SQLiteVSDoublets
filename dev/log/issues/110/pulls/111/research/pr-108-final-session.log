[2026-10-05T00:29:16.858Z] [INFO]         "content": "[package]\nname = \"sqlite-vs-doublets\"\nversion = \"0.2.0\"\nedition = \"2024\"\nlicense = \"Unlicense\"\ndescription = \"Compares SQLite and Doublets as storage for links and for objects\"\n\n[dependencies]\ndoublets = \"0.5.0\"\nrusqlite = { version = \"0.40.2\", features = [\"bundled\", \"fallible_uint\"] }\nserde_json = \"1.0\"\n\n[profile.release]\nlto = true\ncodegen-units = 1\n<Project Sdk=\"Microsoft.NET.Sdk\">\n\n  <PropertyGroup>\n    <OutputType>Exe</OutputType>\n    <TargetFramework>net10.0</TargetFramework>\n    <ImplicitUsings>enable</ImplicitUsings>\n    <Nullable>enable</Nullable>\n    <RootNamespace>Comparisons.SQLiteVSDoublets</RootNamespace>\n    <AssemblyName>sqlite-vs-doublets</AssemblyName>\n    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>\n    <InvariantGlobalization>true</InvariantGlobalization>\n  </PropertyGroup>\n\n  <ItemGroup>\n    <PackageReference Include=\"Microsoft.Data.Sqlite\" Version=\"10.0.12\" />\n    <PackageReference Include=\"Platform.Data.Doublets\" Version=\"0.18.1\" />\n    <PackageReference Include=\"Platform.Data.Doublets.Sequences\" Version=\"0.6.5\" />\n  </ItemGroup>\n\n</Project>\n{\n  \"sdk\": {\n    \"version\": \"10.0.100\",\n    \"rollForward\": \"latestFeature\",\n    \"allowPrerelease\": false\n  },\n  \"test\": {\n    \"runner\": \"Microsoft.Testing.Platform\"\n  }\n}\n     1\t#!/usr/bin/env python3\n     2\t\"\"\"Turns the benchmark JSON reports into the README results sections and charts.\n     3\t\n     4\tUsage: benchmark_report.py RESULTS_DIR [--readme README.md] [--readme README.ru.md] [--charts DIR]\n     5\t\n     6\tEvery JSON report (written by `rust` and `csharp` with `--output`) is one table: a language,\n     7\ta category (links or objects), an address/id space (32 or 64 bit) and a size, measured on one machine.\n     8\tThe README section between the markers is regenerated in the hierarchy\n     9\tcategory -> language -> bits -> size, and charts are written per category, language and bits.\n    10\t\"\"\"\n    11\t\n    12\timport argparse\n    13\timport json\n    14\timport re\n    15\timport statistics\n    16\tfrom pathlib import Path\n    17\t\n    18\tSTART_MARKER = \"<!--BENCHMARK_RESULTS_START-->\"\n    19\tEND_MARKER = \"<!--BENCHMARK_RESULTS_END-->\"\n    20\t\n    21\tCATEGORIES = (\"links\", \"objects\")\n    22\tNOISE = 0.05\n    23\tLANGUAGES = (\"Rust\", \"C#\")\n    24\tBITS = (32, 64)\n    25\t\n    26\tOPERATIONS = {\n    27\t    \"links\": (\n    28\t        \"create\",\n    29\t        \"query_all\",\n    30\t        \"query_by_id\",\n    31\t        \"query_by_from_to\",\n    32\t        \"query_by_from\",\n    33\t        \"query_by_to\",\n    34\t        \"update\",\n    35\t        \"delete\",\n    36\t    ),\n    37\t    \"objects\": (\"create\", \"read_all\", \"read_by_id\", \"delete\"),\n    38\t}\n    39\t\n    40\t\n    41\tdef russian_plural(count, one, few, many):\n    42\t    if count % 10 == 1 and count % 100 != 11:\n    43\t        return one\n    44\t    return few if 2 <= count % 10 <= 4 and not 12 <= count % 100 <= 14 else many\n    45\t\n    46\t\n    47\tTEXT = {\n    48\t    \"en\": {\n    49\t        \"category\": {\n    50\t            \"links\": \"Doublets vs SQLite as storage for links\",\n    51\t            \"objects\": \"Doublets vs SQLite as storage for objects\",\n    52\t        },\n    53\t        \"language\": \"{language} doublets vs SQLite\",\n    54\t        \"bits\": \"{bits} bit address/id space benchmarks\",\n    55\t        \"size\": {\"links\": \"{size} links\", \"objects\": \"{size} blog posts\"},\n    56\t        \"operations\": {\n    57\t            \"create\": \"Create\",\n    58\t            \"query_all\": \"Read all\",\n    59\t            \"query_by_id\": \"Read by id\",\n    60\t            \"query_by_from_to\": \"Search (from, to)\",\n    61\t            \"query_by_from\": \"Read by from\",\n    62\t            \"query_by_to\": \"Read by to\",\n    63\t            \"update\": \"Update\",\n    64\t            \"delete\": \"Delete\",\n    65\t            \"read_all\": \"Read all\",\n    66\t            \"read_by_id\": \"Read by id\",\n    67\t        },\n    68\t        \"storage\": \"Storage\",\n    69\t        \"file_size\": \"File size\",\n    70\t        \"faster\": \"{ratio}× faster\",\n    71\t        \"slower\": \"{ratio}× slower\",\n    72\t        \"same\": \"≈ same\",\n    73\t        \"provenance\": \"_{repetitions} after a warm-up, median time per operation. SQLite {sqlite}, {machine}, {source}._\",\n    74\t        \"repetitions\": lambda count: f\"{count} repetition\" + (\"\" if count == 1 else \"s\"),\n    75\t        \"machine\": \"unknown machine\",\n    76\t        \"local\": \"a local run\",\n    77\t        \"run\": \"[GitHub Actions run]({url}) on {date}\",\n    78\t        \"missing\": \"_No results yet._\",\n    79\t        \"chart\": \"{language} doublets vs SQLite, {bits} bit, {category}\",\n    80\t        \"nouns\": {\"links\": \"links\", \"objects\": \"objects\"},\n    81\t    },\n    82\t    \"ru\": {\n    83\t        \"category\": {\n    84\t            \"links\": \"Дуплеты против SQLite как хранилище связей\",\n    85\t            \"objects\": \"Дуплеты против SQLite как хранилище объектов\",\n    86\t        },\n    87\t        \"language\": \"Дуплеты на {language} против SQLite\",\n    88\t        \"bits\": \"Тесты с {bits}-битным пространством адресов/идентификаторов\",\n    89\t        \"size\": {\"links\": \"{size} связей\", \"objects\": \"{size} записей блога\"},\n    90\t        \"operations\": {\n    91\t            \"create\": \"Создание\",\n    92\t            \"query_all\": \"Чтение всех\",\n    93\t            \"query_by_id\": \"Чтение по id\",\n    94\t            \"query_by_from_to\": \"Поиск (from, to)\",\n    95\t            \"query_by_from\": \"Чтение по from\",\n    96\t            \"query_by_to\": \"Чтение по to\",\n    97\t            \"update\": \"Обновление\",\n    98\t            \"delete\": \"Удаление\",\n    99\t            \"read_all\": \"Чтение всех\",\n   100\t            \"read_by_id\": \"Чтение по id\",\n   101\t        },\n   102\t        \"storage\": \"Хранилище\",\n   103\t        \"file_size\": \"Размер файлов\",\n   104\t        \"faster\": \"в {ratio}× быстрее\",\n   105\t        \"slower\": \"в {ratio}× медленнее\",\n   106\t        \"same\": \"≈ так же\",\n   107\t        \"provenance\": \"_{repetitions} после прогрева, медианное время одной операции. SQLite {sqlite}, {machine}, {source}._\",\n   108\t        \"repetitions\": lambda count: f\"{count} повтор\" + russian_plural(count, \"\", \"а\", \"ов\"),\n   109\t        \"machine\": \"неизвестная машина\",\n   110\t        \"local\": \"локальный запуск\",\n   111\t        \"run\": \"[запуск GitHub Actions]({url}) от {date}\",\n   112\t        \"missing\": \"_Результатов пока нет._\",\n   113\t        \"chart\": \"Дуплеты на {language} против SQLite, {bits} бит, {category}\",\n   114\t        \"nouns\": {\"links\": \"связи\", \"objects\": \"объекты\"},\n   115\t    },\n   116\t}\n   117\t\n   118\t\n   119\tdef load(directory):\n   120\t    \"\"\"All reports in `directory`, keyed by (category, language, bits, size).\"\"\"\n   121\t    reports = {}\n   122\t    for path in sorted(Path(directory).glob(\"*.json\")):\n   123\t        report = json.loads(path.read_text(encoding=\"utf-8\"))\n   124\t        key = (report[\"category\"], report[\"language\"], report[\"bits\"], report[\"size\"])\n   125\t        if key in reports:\n   126\t            raise ValueError(f\"{path} duplicates the results of {key}\")\n   127\t        reports[key] = report\n   128\t    return reports\n   129\t\n   130\t\n   131\tdef baseline(variant):\n   132\t    \"\"\"Doublets are compared with SQLite of the same durability: volatile with memory, non-volatile with file.\"\"\"\n   133\t    if variant.startswith(\"SQLite\"):\n   134\t        return None\n   135\t    return \"SQLite_File\" if \"_NonVolatile\" in variant else \"SQLite_Memory\"\n   136\t\n   137\t\n   138\tdef significant(value):\n   139\t    \"\"\"Three significant digits without an exponent: 999.6 is 1000, not 1e+03.\"\"\"\n   140\t    return f\"{float(f'{value:.3g}'):g}\"\n   141\t\n   142\t\n   143\tdef duration(nanoseconds):\n   144\t    rounded = float(significant(nanoseconds))\n   145\t    for unit, scale in ((\"s\", 1e9), (\"ms\", 1e6), (\"µs\", 1e3)):\n   146\t        if rounded >= scale:\n   147\t            return f\"{significant(rounded / scale)} {unit}\"\n   148\t    return f\"{significant(rounded)} ns\"\n   149\t\n   150\t\n   151\tdef size(count):\n   152\t    return f\"{count:,}\"\n   153\t\n   154\t\n   155\tdef file_size(count):\n   156\t    return \"—\" if count is None else f\"{count / 2**20:.1f} MiB\"\n   157\t\n   158\t\n   159\tdef quartiles(measured):\n   160\t    \"\"\"The middle half of the samples: unlike the full range, one outlier repetition does not widen it.\"\"\"\n   161\t    samples = measured[\"samples_ns\"]\n   162\t    if len(samples) == 1:\n   163\t        return samples[0], samples[0]\n   164\t    first, _, third = statistics.quantiles(samples, n=4, method=\"inclusive\")\n   165\t    return first, third\n   166\t\n   167\t\n   168\tdef comparison(measured, reference, text):\n   169\t    \"\"\"How `measured` compares with `reference`.\n   170\t\n   171\t    Overlapping interquartile ranges and medians within NOISE of each other (single samples have no range)\n   172\t    are not called a difference.\n   173\t    \"\"\"\n   174\t    (low, high), (reference_low, reference_high) = quartiles(measured), quartiles(reference)\n   175\t    overlapping = low <= reference_high and reference_low <= high\n   176\t    ratio = max(measured[\"median_ns\"], reference[\"median_ns\"]) / min(measured[\"median_ns\"], reference[\"median_ns\"])\n   177\t    if overlapping or ratio < 1 + NOISE:\n   178\t        return text[\"same\"]\n   179\t    if measured[\"median_ns\"] <= reference[\"median_ns\"]:\n   180\t        return text[\"faster\"].format(ratio=significant(reference[\"median_ns\"] / measured[\"median_ns\"]))\n   181\t    return text[\"slower\"].format(ratio=significant(measured[\"median_ns\"] / reference[\"median_ns\"]))\n   182\t\n   183\t\n   184\tdef table(report, text):\n   185\t    operations = OPERATIONS[report[\"category\"]]\n   186\t    by_variant = {result[\"variant\"]: result for result in report[\"results\"]}\n   187\t    header = [text[\"storage\"], *(text[\"operations\"][operation] for operation in operations), text[\"file_size\"]]\n   188\t    lines = [\"| \" + \" | \".join(header) + \" |\", \"|\" + \"---|\" + \"---:|\" * (len(header) - 1)]\n   189\t    for variant, result in by_variant.items():\n   190\t        reference = by_variant.get(baseline(variant))\n   191\t        cells = [variant.replace(\"_\", \" \")]\n   192\t        for operation in operations:\n   193\t            measured = result[\"operations\"][operation]\n   194\t            cell = duration(measured[\"median_ns\"])\n   195\t            if reference is not None:\n   196\t                cell += f\" ({comparison(measured, reference['operations'][operation], text)})\"\n   197\t            cells.append(cell)\n   198\t        cells.append(file_size(result[\"file_bytes\"]))\n   199\t        lines.append(\"| \" + \" | \".join(cells) + \" |\")\n   200\t    return \"\\n\".join(lines)",
