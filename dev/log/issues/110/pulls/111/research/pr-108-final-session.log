content, post.publication_date],\n                |row| row.get::<_, i64>(0),\n            )\n            .map(|id| T::try_from(id).unwrap())\n            .unwrap()\"\"\")\ns=s.replace('execute_batch(\"BEGIN\")','execute_batch(\"BEGIN IMMEDIATE\")')\ns=s.replace(\"\"\"    sequences: HashMap<String, T>,\n    strings: HashMap<T, String>,\"\"\",\"\"\"    sequences: HashMap<Arc<str>, T>,\n    strings: HashMap<T, Arc<str>>,\"\"\")\ns=s.replace(\"fn sequence(&mut self, string: &str) -> T {\",\"fn sequence(&mut self, string: &Arc<str>) -> T {\")\ns=s.replace(\".and_then(|cache| cache.sequences.get(string))\",\".and_then(|cache| cache.sequences.get(&**string))\")\ns=s.replace(\"cache.sequences.insert(string.to_owned(), sequence);\",\"cache.sequences.insert(Arc::clone(string), sequence);\")\ns=s.replace(\"fn string(&mut self, sequence: T) -> String {\",\"fn string(&mut self, sequence: T) -> Arc<str> {\")\ns=s.replace(\"\"\"            return string.clone();\n        }\n        if sequence == self.unicode_sequence {\n            return String::new();\n        }\"\"\",\"\"\"            return Arc::clone(string);\n        }\n        if sequence == self.unicode_sequence {\n            return Arc::default();\n        }\"\"\")\ns=s.replace(\"\"\"        let string = String::from_utf16(&utf16).unwrap();\n        if let Some(cache) = &mut self.cache {\n            cache.strings.insert(sequence, string.clone());\"\"\",\"\"\"        let string: Arc<str> = String::from_utf16(&utf16).unwrap().into();\n        if let Some(cache) = &mut self.cache {\n            cache.strings.insert(sequence, Arc::clone(&string));\"\"\")\nopen(p,'w').write(s)\n\np='rust/src/links.rs'; s=open(p).read()\ns=s.replace(\"\"\"            .prepare_cached(r#\"INSERT INTO links (\"from\", \"to\") VALUES (?1, ?2)\"#)\n            .unwrap();\n        statement.execute(params![sql(from), sql(to)]).unwrap();\n        id(self.connection.last_insert_rowid())\"\"\",\"\"\"            .prepare_cached(r#\"INSERT INTO links (\"from\", \"to\") VALUES (?1, ?2) RETURNING id\"#)\n            .unwrap();\n        statement\n            .query_row([sql(from), sql(to)], |row| row.get(0).map(id))\n            .unwrap()\"\"\")\ns=s.replace('execute_batch(\"BEGIN\")','execute_batch(\"BEGIN IMMEDIATE\")')\nopen(p,'w').write(s)\n\np='rust/tests/storages.rs'; s=open(p).read()\ns=s.replace(\"        title: String::new(),\",\"        title: \\\"\\\".into(),\")\nopen(p,'w').write(s)\nE\nhead -12 rust/src/objects.rs; grep -n \"params\" rust/src/links.rs | head -3"
