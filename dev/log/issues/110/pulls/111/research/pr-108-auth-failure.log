[2026-10-04T17:13:51.453Z] [INFO]                 "+    /// <summary>Count and order-sensitive checksum of the records an operation has seen.</summary>",
[2026-10-04T17:13:51.453Z] [INFO]                 "+    public record struct Tally(ulong Count, ulong Checksum)",
[2026-10-04T17:13:51.453Z] [INFO]                 "+    {",
