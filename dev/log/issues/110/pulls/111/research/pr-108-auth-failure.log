[2026-10-04T17:19:17.289Z] [INFO]               "lines": [
[2026-10-04T17:19:17.289Z] [INFO]                 "+// Shows which links match (any, post_property, any) when a blog post is deleted from a Doublets store.",
[2026-10-04T17:19:17.289Z] [INFO]                 "+using Comparisons.SQLiteVSDoublets;",
[2026-10-04T17:19:17.289Z] [INFO]                 "+using Platform.Data;",
[2026-10-04T17:19:17.289Z] [INFO]                 "+using Platform.Data.Doublets;",
[2026-10-04T17:19:17.289Z] [INFO]                 "+using Platform.Data.Doublets.Memory.United.Generic;",
[2026-10-04T17:19:17.289Z] [INFO]                 "+using Platform.Memory;",
[2026-10-04T17:19:17.289Z] [INFO]                 "+",
[2026-10-04T17:19:17.289Z] [INFO]                 "+var links = new UnitedMemoryLinks<ulong>(new HeapResizableDirectMemory());",
[2026-10-04T17:19:17.289Z] [INFO]                 "+var posts = new DoubletsBlogPosts<ulong>(links, cacheSequences: args.Contains(\"--cached\"));",
[2026-10-04T17:19:17.289Z] [INFO]                 "+var ids = Enumerable.Range(1, 3).Select(i => posts.Create(Dataset.BlogPost((ulong)i))).ToList();",
[2026-10-04T17:19:17.289Z] [INFO]                 "+var any = links.Constants.Any;",
[2026-10-04T17:19:17.289Z] [INFO]                 "+foreach (var id in ids)",
[2026-10-04T17:19:17.289Z] [INFO]                 "+{",
[2026-10-04T17:19:17.289Z] [INFO]                 "+    for (ulong property = 4; property <= 6; property++)",
[2026-10-04T17:19:17.289Z] [INFO]                 "+    {",
[2026-10-04T17:19:17.289Z] [INFO]                 "+        var objectProperty = links.SearchOrDefault(id, property);",
[2026-10-04T17:19:17.289Z] [INFO]                 "+        var matches = new List<string>();",
[2026-10-04T17:19:17.289Z] [INFO]                 "+        links.Each(link => { matches.Add($\"({link![0]}: {link[1]} {link[2]})\"); return links.Constants.Continue; }, any, objectProperty, any);",
[2026-10-04T17:19:17.289Z] [INFO]                 "+        Console.WriteLine($\"post {id} property {property}: ({id}, {property}) = {objectProperty}, values {string.Join(\" \", matches)}\");",
[2026-10-04T17:19:17.289Z] [INFO]                 "+    }",
[2026-10-04T17:19:17.289Z] [INFO]                 "+}",
[2026-10-04T17:19:17.289Z] [INFO]                 "+foreach (var id in ids)",
[2026-10-04T17:19:17.289Z] [INFO]                 "+{",
[2026-10-04T17:19:17.289Z] [INFO]                 "+    Console.WriteLine($\"deleting {id}\");",
[2026-10-04T17:19:17.289Z] [INFO]                 "+    posts.Delete(id);",
[2026-10-04T17:19:17.289Z] [INFO]                 "+}",
[2026-10-04T17:19:17.289Z] [INFO]                 "+Console.WriteLine($\"count {links.Count()}\");"
[2026-10-04T17:19:17.289Z] [INFO]               ]
[2026-10-04T17:19:17.289Z] [INFO]             }
