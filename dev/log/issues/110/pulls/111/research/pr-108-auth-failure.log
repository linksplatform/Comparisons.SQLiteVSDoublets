[2026-10-04T17:13:51.453Z] [INFO]                 "+    public sealed record Measurement(string Variant, ulong? FileBytes, List<(string Operation, List<double> Samples)> Operations)",
[2026-10-04T17:13:51.453Z] [INFO]                 "+    {",
[2026-10-04T17:13:51.453Z] [INFO]                 "+        public JsonObject ToJson()",
[2026-10-04T17:13:51.453Z] [INFO]                 "+        {",
[2026-10-04T17:13:51.453Z] [INFO]                 "+            var operations = new JsonObject();",
[2026-10-04T17:13:51.453Z] [INFO]                 "+            foreach (var (operation, samples) in Operations)",
[2026-10-04T17:13:51.453Z] [INFO]                 "+            {",
[2026-10-04T17:13:51.453Z] [INFO]                 "+                var sorted = samples.Order().ToList();",
[2026-10-04T17:13:51.453Z] [INFO]                 "+                var middle = sorted.Count / 2;",
[2026-10-04T17:13:51.453Z] [INFO]                 "+                var median = sorted.Count % 2 == 0 ? (sorted[middle - 1] + sorted[middle]) / 2 : sorted[middle];",
[2026-10-04T17:13:51.453Z] [INFO]                 "+                operations[operation] = new JsonObject",
[2026-10-04T17:13:51.453Z] [INFO]                 "+                {",
