                 .push((operation, vec![ns_per_operation])),\n            }\n        }\n    }\n    measurement\n}\n\n'''\ns=s[:start]+new+s[end:]\ns=s.replace(\"pub const WARM_UP_SIZE: u64 = 10_000;\\n\",\"pub const WARM_UP_SIZE: u64 = 10_000;\\npub const WARM_UP_TIME: Duration = Duration::from_secs(1);\\n\")\nopen(p,'w').write(s)\nE\ngrep -n \"^use\\|Instant\\|Duration\" rust/src/harness.rs | head"
