          "content": "name: Benchmarks\n\n# Every job measures one README table (language, category, bits, size) with all its variants on one runner,\n# so that the variants of a table are compared on the same machine. Pull requests run the whole pipeline\n# on small sizes; pushes to main publish the results to README.md and README.ru.md.\non:\n  push:\n    branches: [main]\n    paths: ['rust/**', 'csharp/**', 'scripts/**', '.github/workflows/benchmarks.yml']\n  pull_request:\n    paths: ['rust/**', 'csharp/**', 'scripts/**', '.github/workflows/benchmarks.yml']\n  workflow_dispatch:\n    inputs:\n      sizes:\n        description: JSON array of sizes (objects skip 10,000,000 and more)\n        default: '[100000, 1000000, 10000000]'\n\nconcurrency:\n  group: ${{ github.workflow }}-${{ github.ref }}\n  cancel-in-progress: ${{ github.event_name == 'pull_request' }}\n\nenv:\n  CARGO_TERM_COLOR: always\n\njobs:\n  report-tests:\n    name: Report script tests\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    steps:\n      - uses: actions/checkout@v7\n      - uses: actions/setup-python@v7\n        with:\n          python-version: '3.13'\n      - run: pip install -r scripts/requirements.txt\n      - run: python -m unittest discover -s scripts -v\n\n  benchmark:\n    name: ${{ matrix.language }} ${{ matrix.category }} ${{ matrix.bits }} bit ${{ matrix.size }}\n    runs-on: ubuntu-latest\n    timeout-minutes: 355\n    strategy:\n      fail-fast: false\n      matrix:\n        language: [rust, csharp]\n        category: [links, objects]\n        bits: [32, 64]\n        size: ${{ fromJSON(inputs.sizes || (github.event_name == 'pull_request' && '[1000]') || '[100000, 1000000, 10000000]') }}\n        exclude:\n          # One million blog posts already take hours in C#; ten millions would not fit into a job.\n          - category: objects\n            size: 10000000\n          - category: objects\n            size: 100000000\n    steps:\n      - uses: actions/checkout@v7\n      - if: matrix.language == 'rust'\n        uses: dtolnay/rust-toolchain@stable\n      - if: matrix.language == 'rust'\n        uses: Swatinem/rust-cache@v2\n        with:\n          workspaces: rust\n      - if: matrix.language == 'rust'\n        run: |\n          cargo build --release --manifest-path rust/Cargo.toml\n          echo \"BENCHMARK=rust/target/release/sqlite-vs-doublets\" >> \"$GITHUB_ENV\"\n      - if: matrix.language == 'csharp'\n        uses: actions/setup-dotnet@v6\n        with:\n          global-json-file: csharp/global.json\n      - if: matrix.language == 'csharp'\n        run: |\n          dotnet build -c Release csharp/SQLiteVSDoublets\n          echo \"BENCHMARK=dotnet csharp/SQLiteVSDoublets/bin/Release/net10.0/sqlite-vs-doublets.dll\" >> \"$GITHUB_ENV\"\n      - name: Benchmark\n        run: |\n          name=${{ matrix.category }}-${{ matrix.language }}-${{ matrix.bits }}-${{ matrix.size }}\n          echo \"NAME=$name\" >> \"$GITHUB_ENV\"\n          $BENCHMARK ${{ matrix.category }} ${{ matrix.bits }} ${{ matrix.size }} \\\n            --directory \"$RUNNER_TEMP/storage\" --output \"$RUNNER_TEMP/measured.json\"\n          machine=\"$(. /etc/os-release && echo \"$PRETTY_NAME\"), $(lscpu | sed -n 's/^Model name: *//p' | head -1)\"\n          machine=\"$machine, $(nproc) cores, $(awk '/^MemTotal/ { printf \"%.0f\", $2 / 1048576 }' /proc/meminfo) GiB\"\n          mkdir results\n          jq --arg run_url \"$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID\" \\\n            --arg date \"$(date -u +%Y-%m-%d)\" --arg machine \"$machine\" \\\n            '. + {run_url: $run_url, date: $date, machine: $machine}' \\\n            \"$RUNNER_TEMP/measured.json\" > \"results/$name.json\"\n      - uses: actions/upload-artifact@v7\n        with:\n          name: results-${{ env.NAME }}\n          path: results/${{ env.NAME }}.json\n\n  report:\n    name: Report\n    needs: [report-tests, benchmark]\n    # Publishes the finished tables even if some jobs failed; the missing ones keep their previous results.\n    if: ${{ !cancelled() && needs.report-tests.result == 'success' }}\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    permissions:\n      contents: write\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          ref: ${{ github.event_name == 'pull_request' && github.sha || github.ref_name }}\n      - uses: actions/setup-python@v7\n        with:\n          python-version: '3.13'\n      - run: pip install -r scripts/requirements.txt\n      - uses: actions/download-artifact@v8\n        with:\n          pattern: results-*\n          merge-multiple: true\n          path: ${{ github.event_name == 'pull_request' && format('{0}/results', runner.temp) || 'docs/benchmarks/results' }}\n      - if: github.event_name == 'pull_request'\n        name: Check the report\n        run: python scripts/benchmark_report.py \"$RUNNER_TEMP/results\" >> \"$GITHUB_STEP_SUMMARY\"\n      - if: github.event_name != 'pull_request'\n        name: Publish the report\n        run: |\n          python scripts/benchmark_report.py docs/benchmarks/results \\\n            --readme README.md --readme README.ru.md --charts docs/benchmarks\n          git config user.email 'linksplatform@gmail.com'\n          git config user.name 'LinksPlatformBencher'\n          git add README.md README.ru.md docs/benchmarks\n          git diff --staged --quiet && exit 0\n          git commit -m 'Update benchmark results [skip ci]'\n          for attempt in 1 2 3; do\n            git pull --rebase origin \"$GITHUB_REF_NAME\" && git push origin \"HEAD:$GITHUB_REF_NAME\" && exit 0\n            sleep 10\n          done\n          exit 1\n"
