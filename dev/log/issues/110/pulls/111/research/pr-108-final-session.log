        string.Join(\", \", timings.Select(timing => $\"{timing.Item1} {timing.Item2.TotalNanoseconds / n:F0}\")));\n    }\n}\nE\ngrep -n \"public static.*Lifecycle\\|class DoubletsBlogPosts\\|public DoubletsBlogPosts\" ../../csharp/SQLiteVSDoublets/*.cs"
