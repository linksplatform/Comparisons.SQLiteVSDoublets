        "name": "Bash",
        "input": {
          "command": "cat > src/main.rs <<'EOF'\n//! Minimal reproductions of a `doublets` 0.5.0 split store bug: deleting a link panics\n//! with \"index out of bounds\" in `InternalSourcesRecursionlessTree` after some updates.\nuse doublets::{Doublets, mem::Global, split, unit};\n\ntype Step = (&'static str, u32, u32, u32);\n\nfn run<D: Doublets<u32>>(mut store: D, steps: &[Step]) -> u32 {\n    for &(operation, id, from, to) in steps {\n        match operation {\n            \"create\" => assert_eq!(store.create_link(from, to).unwrap(), id),\n            \"update\" => drop(store.update(id, from, to).unwrap()),\n            _ => drop(store.delete(id).unwrap()),\n        }\n    }\n    store.count()\n}\n\nfn main() {\n    let scenarios: [(&str, Vec<Step>); 5] = [\n        (\"point, no-op update, delete\", vec![(\"create\", 1, 1, 1), (\"update\", 1, 1, 1), (\"delete\", 1, 0, 0)]),\n        (\"point, delete\", vec![(\"create\", 1, 1, 1), (\"delete\", 1, 0, 0)]),\n        (\n            \"no self references, update, delete\",\n            vec![\n                (\"create\", 1, 1, 1),\n                (\"create\", 2, 1, 1),\n                (\"create\", 3, 2, 1),\n                (\"update\", 3, 1, 2),\n                (\"delete\", 3, 0, 0),\n                (\"delete\", 2, 0, 0),\n                (\"delete\", 1, 0, 0),\n            ],\n        ),\n        (\n            \"no self references, no update, delete\",\n            vec![(\"create\", 1, 1, 1), (\"create\", 2, 1, 1), (\"create\", 3, 2, 1), (\"delete\", 3, 0, 0), (\"delete\", 2, 0, 0), (\"delete\", 1, 0, 0)],\n        ),\n        (\n            \"update to self, delete\",\n            vec![(\"create\", 1, 1, 1), (\"create\", 2, 1, 1), (\"update\", 2, 2, 1), (\"delete\", 2, 0, 0), (\"delete\", 1, 0, 0)],\n        ),\n    ];\n    let kind = std::env::args().nth(1).unwrap_or_default();\n    std::panic::set_hook(Box::new(|_| {}));\n    for (name, steps) in scenarios {\n        let result = std::panic::catch_unwind(|| match kind.as_str() {\n            \"unit\" => run(unit::Store::<u32, _>::new(Global::new()).unwrap(), &steps),\n            _ => run(split::Store::<u32, _, _>::new(Global::new(), Global::new()).unwrap(), &steps),\n        });\n        println!(\"{kind:5} {name:40} {}\", if result.is_ok() { \"ok\" } else { \"PANIC\" });\n    }\n}\nEOF\ncargo build --release -q 2>&1 | tail -3; ./target/release/split_store_delete unit; ./target/release/split_store_delete split",
          "description": "Run minimal split-store scenarios"
