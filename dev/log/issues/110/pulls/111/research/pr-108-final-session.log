is cursus porttitor. Praesent hendrerit justo ut sem convallis sollicitudin eu at odio.\",\n   175\t    ];\n   176\t\n   177\t    public static BlogPost BlogPost(ulong i) =>\n   178\t        new($\"Blog post {i}\", Paragraphs[i % 5], September2020 + (SplitMix64(i) % ThirtyDays));\n   179\t\n   180\t    public static ulong BlogPostsChecksum(ulong n)\n   181\t    {\n   182\t        ulong checksum = 0;\n   183\t        for (ulong i = 1; i <= n; i++)\n   184\t        {\n   185\t            checksum += BlogPost(i).Checksum;\n   186\t        }\n   187\t        return checksum;\n   188\t    }\n   189\t\n   190\t    /// <summary>\n   191\t    /// Like <see cref=\"BlogPostsChecksum\"/>, but also checks that the <c>i</c>-th created id returns the <c>i</c>-th post.\n   192\t    /// </summary>\n   193\t    public static ulong BlogPostsByNumberChecksum(ulong n)\n   194\t    {\n   195\t        ulong checksum = 0;\n   196\t        for (ulong i = 1; i <= n; i++)\n   197\t        {\n   198\t            checksum += Mix(i, BlogPost(i).Checksum);\n   199\t        }\n   200\t        return checksum;\n   201\t    }\n   202\t}\n   203\t\n   204\t/// <param name=\"PublicationDate\">Seconds since the Unix epoch.</param>\n   205\tpublic sealed record BlogPost(string Title, string Content, ulong PublicationDate)\n   206\t{\n   207\t    public ulong Checksum => Bytes(Title) + Bytes(Content) + PublicationDate;\n   208\t\n   209\t    private static ulong Bytes(string text)\n   210\t    {\n   211\t        ulong sum = 0;\n   212\t        foreach (var b in Encoding.UTF8.GetBytes(text))\n   213\t        {\n   214\t            sum += b;\n   215\t        }\n   216\t        return sum;\n   217\t    }\n   218\t}",
