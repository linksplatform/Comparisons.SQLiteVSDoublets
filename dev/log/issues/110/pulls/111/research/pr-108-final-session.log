[2026-10-05T00:28:10.826Z] [INFO]         "content": "     1\tuse crate::dataset::BlogPost;\n     2\tuse doublets::{\n     3\t    Doublets,\n     4\t    data::{AddrToRaw, Flow, LinkReference, RawToAddr},\n     5\t};\n     6\tuse rusqlite::{Connection, OptionalExtension, params};\n     7\tuse std::{collections::HashMap, marker::PhantomData, path::Path};\n     8\t\n     9\tpub trait BlogPostsStorage<T> {\n    10\t    fn create(&mut self, post: &BlogPost) -> T;\n    11\t    fn get(&mut self, id: T) -> Option<BlogPost>;\n    12\t    fn each(&mut self, visit: impl FnMut(T, BlogPost));\n    13\t    fn delete(&mut self, id: T);\n    14\t    fn count(&mut self) -> u64;\n    15\t\n    16\t    fn transaction<R>(&mut self, work: impl FnOnce(&mut Self) -> R) -> R {\n    17\t        work(self)\n    18\t    }\n    19\t}\n    20\t\n    21\tpub struct SqliteBlogPosts<T> {\n    22\t    connection: Connection,\n    23\t    id_type: PhantomData<T>,\n    24\t}\n    25\t\n    26\timpl<T: LinkReference> SqliteBlogPosts<T> {\n    27\t    pub fn open(path: impl AsRef<Path>) -> Self {\n    28\t        Self::new(Connection::open(path).unwrap())\n    29\t    }\n    30\t\n    31\t    pub fn in_memory() -> Self {\n    32\t        Self::new(Connection::open_in_memory().unwrap())\n    33\t    }\n    34\t\n    35\t    fn new(connection: Connection) -> Self {\n    36\t        connection\n    37\t            .execute_batch(\n    38\t                \"CREATE TABLE blog_posts (id INTEGER PRIMARY KEY, title TEXT NOT NULL, content TEXT NOT NULL, publication_date INTEGER NOT NULL)\",\n    39\t            )\n    40\t            .unwrap();\n    41\t        Self {\n    42\t            connection,\n    43\t            id_type: PhantomData,\n    44\t        }\n    45\t    }\n    46\t}\n    47\t\n    48\tfn blog_post(row: &rusqlite::Row<'_>) -> rusqlite::Result<BlogPost> {\n    49\t    Ok(BlogPost {\n    50\t        title: row.get(0)?,\n    51\t        content: row.get(1)?,\n    52\t        publication_date: row.get(2)?,\n    53\t    })\n    54\t}\n    55\t\n    56\tfn sql<T: LinkReference>(id: T) -> i64 {\n    57\t    id.try_into().unwrap()\n    58\t}\n    59\t\n    60\timpl<T: LinkReference> BlogPostsStorage<T> for SqliteBlogPosts<T> {\n    61\t    fn create(&mut self, post: &BlogPost) -> T {\n    62\t        let mut statement = self\n    63\t            .connection\n    64\t            .prepare_cached(\n    65\t                \"INSERT INTO blog_posts (title, content, publication_date) VALUES (?1, ?2, ?3)\",\n    66\t            )\n    67\t            .unwrap();\n    68\t        statement\n    69\t            .execute(params![post.title, post.content, post.publication_date])\n    70\t            .unwrap();\n    71\t        T::try_from(self.connection.last_insert_rowid()).unwrap()\n    72\t    }\n    73\t\n    74\t    fn get(&mut self, id: T) -> Option<BlogPost> {\n    75\t        let mut statement = self\n    76\t            .connection\n    77\t            .prepare_cached(\"SELECT title, content, publication_date FROM blog_posts WHERE id = ?1\")\n    78\t            .unwrap();\n    79\t        statement\n    80\t            .query_row([sql(id)], blog_post)\n    81\t            .optional()\n    82\t            .unwrap()\n    83\t    }\n    84\t\n    85\t    fn each(&mut self, mut visit: impl FnMut(T, BlogPost)) {\n    86\t        let mut statement = self\n    87\t            .connection\n    88\t            .prepare_cached(\"SELECT title, content, publication_date, id FROM blog_posts\")\n    89\t            .unwrap();\n    90\t        let mut rows = statement.query([]).unwrap();\n    91\t        while let Some(row) = rows.next().unwrap() {\n    92\t            visit(\n    93\t                T::try_from(row.get::<_, i64>(3).unwrap()).unwrap(),\n    94\t                blog_post(row).unwrap(),\n    95\t            );\n    96\t        }\n    97\t    }\n    98\t\n    99\t    fn delete(&mut self, id: T) {\n   100\t        let mut statement = self\n   101\t            .connection\n   102\t            .prepare_cached(\"DELETE FROM blog_posts WHERE id = ?1\")\n   103\t            .unwrap();\n   104\t        statement.execute([sql(id)]).unwrap();\n   105\t    }\n   106\t\n   107\t    fn count(&mut self) -> u64 {\n   108\t        self.connection\n   109\t            .query_row(\"SELECT COUNT(*) FROM blog_posts\", [], |row| row.get(0))\n   110\t            .unwrap()\n   111\t    }\n   112\t\n   113\t    fn transaction<R>(&mut self, work: impl FnOnce(&mut Self) -> R) -> R {\n   114\t        self.connection.execute_batch(\"BEGIN\").unwrap();\n   115\t        let result = work(self);\n   116\t        self.connection.execute_batch(\"COMMIT\").unwrap();\n   117\t        result\n   118\t    }\n   119\t}\n   120\t\n   121\t/// Stores each blog post as a `(blog_post, itself)` link with `(post, property) -> value` properties,\n   122\t/// strings as balanced-variant sequences of Unicode symbols and dates as raw numbers,\n   123\t/// using the same layout as `Platform.Data.Doublets.Sequences` in C#.\n   124\tpub struct DoubletsBlogPosts<T, D> {\n   125\t    links: D,\n   126\t    unicode_symbol: T,\n   127\t    unicode_sequence: T,\n   128\t    title: T,\n   129\t    content: T,\n   130\t    publication_date: T,\n   131\t    blog_post: T,\n   132\t    cache: Option<SequencesCache<T>>,\n   133\t}\n   134\t\n   135\t#[derive(Default)]\n   136\tstruct SequencesCache<T> {\n   137\t    sequences: HashMap<String, T>,\n   138\t    strings: HashMap<T, String>,\n   139\t}\n   140\t\n   141\timpl<T: LinkReference, D: Doublets<T>> DoubletsBlogPosts<T, D> {\n   142\t    pub fn new(mut links: D, cache_sequences: bool) -> Self {\n   143\t        let meaning_root = links.create_point().unwrap();\n   144\t        let mut marker = || {\n   145\t            let marker = links.create().unwrap();\n   146\t            links.update(marker, meaning_root, marker).unwrap()\n   147\t        };\n   148\t        Self {\n   149\t            unicode_symbol: marker(),\n   150\t            unicode_sequence: marker(),\n   151\t            title: marker(),\n   152\t            content: marker(),\n   153\t            publication_date: marker(),\n   154\t            blog_post: marker(),\n   155\t            cache: cache_sequences.then(SequencesCache::default),\n   156\t            links,\n   157\t        }\n   158\t    }\n   159\t\n   160\t    fn sequence(&mut self, string: &str) -> T {\n   161\t        if let Some(sequence) = self\n   162\t            .cache\n   163\t            .as_ref()\n   164\t            .and_then(|cache| cache.sequences.get(string))\n   165\t        {\n   166\t            return *sequence;\n   167\t        }\n   168\t        if string.is_empty() {\n   169\t            return self.unicode_sequence;\n   170\t        }\n   171\t        let symbols: Vec<T> = string\n   172\t            .encode_utf16()\n   173\t            .map(|char| {\n   174\t                self.links\n   175\t                    .get_or_create(\n   176\t                        AddrToRaw.convert(T::try_from(char).unwrap()),\n   177\t                        self.unicode_symbol,\n   178\t                    )\n   179\t                    .unwrap()\n   180\t            })\n   181\t            .collect();\n   182\t        let balanced = self.balanced_variant(symbols);\n   183\t        let sequence = self\n   184\t            .links\n   185\t            .get_or_create(balanced, self.unicode_sequence)\n   186\t            .unwrap();\n   187\t        if let Some(cache) = &mut self.cache {\n   188\t            cache.sequences.insert(string.to_owned(), sequence);\n   189\t        }\n   190\t        sequence\n   191\t    }\n   192\t\n   193\t    fn balanced_variant(&mut self, mut layer: Vec<T>) -> T {\n   194\t        while layer.len() > 1 {\n   195\t            layer = layer\n   196\t                .chunks(2)\n   197\t                .map(|pair| match *pair {\n   198\t                    [source, target] => self.links.get_or_create(source, target).unwrap(),\n   199\t                    [last] => last,\n   200\t                    _ => unreachable!(),\n   201\t                })\n   202\t                .collect();\n   203\t        }\n   204\t        layer[0]\n   205\t    }\n   206\t\n   207\t    fn string(&mut self, sequence: T) -> String {\n   208\t        if let Some(string) = self\n   209\t            .cache\n   210\t            .as_ref()\n   211\t            .and_then(|cache| cache.strings.get(&sequence))\n   212\t        {\n   213\t            return string.clone();\n   214\t        }\n   215\t        if sequence == self.unicode_sequence {\n   216\t            return String::new();\n   217\t        }\n   218\t        let mut utf16 = Vec::new();\n   219\t        self.walk(self.source(sequence), |symbol| {\n   220\t            utf16.push(RawToAddr.convert(self.source(symbol)).try_into().unwrap());\n   221\t        });\n   222\t        let string = String::from_utf16(&utf16).unwrap();\n   223\t        if let Some(cache) = &mut self.cache {\n   224\t            cache.strings.insert(sequence, string.clone());\n   225\t        }\n   226\t        string\n   227\t    }\n   228\t\n   229\t    /// Visits the symbols of a balanced sequence from left to right, like `RightSequenceWalker` in C#.\n   230\t    fn walk(&self, sequence: T, mut visit: impl FnMut(T)) {\n   231\t        let is_symbol = |link| self.target(link) == self.unicode_symbol;\n   232\t        let mut stack = Vec::new();\n   233\t        let mut element = sequence;\n   234\t        if is_symbol(element) {\n   235\t            return visit(element);\n   236\t        }\n   237\t        loop {\n   238\t            if is_symbol(element) {\n   239\t                let Some(pair) = stack.pop() else { break };\n   240\t                let (source, target) = (self.source(pair), self.target(pair));\n   241\t                for part in [source, target] {\n   242\t                    if is_symbol(part) {\n   243\t                        visit(part);\n   244\t                    }\n   245\t                }\n   246\t                element = target;\n   247\t            } else {\n   248\t                stack.push(element);\n   249\t                element = self.source(element);\n   250\t            }\n   251\t        }\n   252\t    }\n   253\t\n   254\t    fn source(&self, link: T) -> T {\n   255\t        self.links.get_link(link).unwrap().source\n   256\t    }\n   257\t\n   258\t    fn target(&self, link: T) -> T {\n   259\t        self.links.get_link(link).unwrap().target\n   260\t    }\n   261\t\n   262\t    fn set_property(&mut self, object: T, property: T, value: T) {\n   263\t        let object_property = self.links.get_or_create(object, property).unwrap();\n   264\t        let any = self.links.constants().any;\n   265\t        self.links\n   266\t            .delete_query_with([any, object_property, any], |_, _| Flow::Continue)\n   267\t            .unwrap();\n   268\t        self.links.get_or_create(object_property, value).unwrap();\n   269\t    }\n   270\t\n   271\t    fn property(&self, object: T, property: T) -> Option<T> {\n   272\t        let object_property = self.links.search(object, property)?;\n   273\t        let any = self.links.constants().any;\n   274\t        self.links\n   275\t            .single([any, object_property, any])\n   276\t            .map(|value| value.target)\n   277\t    }\n   278\t\n   279\t    fn delete_property(&mut self, object: T, property: T) {\n   280\t        let object_property = self.links.search(object, property).unwrap();\n   281\t        let any = self.links.constants().any;\n   282\t        let value = self.links.single([any, object_property, any]).unwrap();\n   283\t        self.links.delete(value.index).unwrap();\n   284\t        self.links.delete(object_property).unwrap();\n   285\t    }\n   286\t}\n   287\t\n   288\timpl<T: LinkReference, D: Doublets<T>> BlogPostsStorage<T> for DoubletsBlogPosts<T, D> {\n   289\t    fn create(&mut self, post: &BlogPost) -> T {\n   290\t        let blog_post = self.links.create().unwrap();\n   291\t        self.links\n   292\t            .update(blog_post, self.blog_post, blog_post)\n   293\t            .unwrap();\n   294\t        let title = self.sequence(&post.title);\n   295\t        self.set_property(blog_post, self.title, title);\n   296\t        let content = self.sequence(&post.content);\n   297\t        self.set_property(blog_post, self.content, content);\n   298\t        let publication_date = AddrToRaw.convert(T::try_from(post.publication_date).unwrap());\n   299\t        self.set_property(blog_post, self.publication_date, publication_date);\n   300\t        blog_post\n   301\t    }\n   302\t\n   303\t    fn get(&mut self, id: T) -> Option<BlogPost> {\n   304\t        let title = self.property(id, self.title)?;\n   305\t        let content = self.property(id, self.content)?;\n   306\t        let publication_date = self.property(id, self.publication_date)?;\n   307\t        Some(BlogPost {\n   308\t            title: self.string(title),\n   309\t            content: self.string(content),\n   310\t            publication_date: RawToAddr.convert(publication_date).try_into().unwrap(),\n   311\t        })\n   312\t    }\n   313\t\n   314\t    fn each(&mut self, mut visit: impl FnMut(T, BlogPost)) {\n   315\t        let any = self.links.constants().any;\n   316\t        let mut ids = Vec::new();\n   317\t        self.links.each_by([any, self.blog_post, any], |post| {\n   318\t            ids.push(post.index);\n   319\t            Flow::Continue\n   320\t        });\n   321\t        for id in ids {\n   322\t            let post = self.get(id).unwrap();\n   323\t            visit(id, post);\n   324\t        }\n   325\t    }\n   326\t\n   327\t    fn delete(&mut self, id: T) {\n   328\t        for property in [self.title, self.content, self.publication_date] {\n   329\t            self.delete_property(id, property);\n   330\t        }\n   331\t        self.links.delete(id).unwrap();\n   332\t    }\n   333\t\n   334\t    fn count(&mut self) -> u64 {\n   335\t        let any = self.links.constants().any;\n   336\t        self.links\n   337\t            .count_by([any, self.blog_post, any])\n   338\t            .try_into()\n   339\t            .unwrap()\n   340\t    }\n   341\t}\n   342\tusing System.Numerics;\n   343\tusing Microsoft.Data.Sqlite;\n   344\tusing Platform.Collections.Stacks;\n   345\tusing Platform.Converters;\n   346\tusing Platform.Data;\n   347\tusing Platform.Data.Doublets;\n   348\tusing Platform.Data.Doublets.CriterionMatchers;\n   349\tusing Platform.Data.Doublets.PropertyOperators;\n   350\tusing Platform.Data.Doublets.Sequences.Converters;\n   351\tusing Platform.Data.Doublets.Sequences.Unicode;\n   352\tusing Platform.Data.Doublets.Sequences.Walkers;\n   353\tusing Platform.Data.Numbers.Raw;\n   354\t\n   355\tnamespace Comparisons.SQLiteVSDoublets;\n   356\t\n   357\tpublic interface IBlogPostsStorage<T> : IDisposable where T : struct\n   358\t{\n   359\t    T Create(BlogPost post);\n   360\t    BlogPost? Get(T id);\n   361\t    void Each(Action<T, BlogPost> visit);\n   362\t    void Delete(T id);\n   363\t    ulong Count();\n   364\t\n   365\t    TResult Transaction<TResult>(Func<TResult> work) => work();\n   366\t}\n   367\t\n   368\tpublic sealed class SQLiteBlogPosts<T> : SQLiteStorage, IBlogPostsStorage<T> where T : struct, IBinaryInteger<T>\n   369\t{\n   370\t    private readonly SqliteCommand _create;\n   371\t    private readonly SqliteCommand _get;\n   372\t    private readonly SqliteCommand _each;\n   373\t    private readonly SqliteCommand _delete;\n   374\t\n   375\t    public static SQLiteBlogPosts<T> Open(string path) => new(path);\n   376\t\n   377\t    public static SQLiteBlogPosts<T> InMemory() => new(\":memory:\");\n   378\t\n   379\t    private SQLiteBlogPosts(string path) : base(path, \"blog_posts\",\n   380\t        \"CREATE TABLE blog_posts (id INTEGER PRIMARY KEY, title TEXT NOT NULL, content TEXT NOT NULL, publication_date INTEGER NOT NULL)\")\n   381\t    {\n   382\t        _create = Command(\n   383\t            \"INSERT INTO blog_posts (title, content, publication_date) VALUES ($title, $content, $publication_date) RETURNING id\",\n   384\t            (\"$title\", SqliteType.Text), (\"$content\", SqliteType.Text), (\"$publication_date\", SqliteType.Integer));\n   385\t        _get = Command(\"SELECT title, content, publication_date FROM blog_posts WHERE id = $id\", (\"$id\", SqliteType.Integer));\n   386\t        _each = Command(\"SELECT title, content, publication_date, id FROM blog_posts\");\n   387\t        _delete = Command(\"DELETE FROM blog_posts WHERE id = $id\", (\"$id\", SqliteType.Integer));\n   388\t    }\n   389\t\n   390\t    private static BlogPost BlogPost(SqliteDataReader reader) =>\n   391\t        new(reader.GetString(0), reader.GetString(1), (ulong)reader.GetInt64(2));\n   392\t\n   393\t    public T Create(BlogPost post)\n   394\t    {\n   395\t        _create.Parameters[0].Value = post.Title;\n   396\t        _create.Parameters[1].Value = post.Content;\n   397\t        _create.Parameters[2].Value = (long)post.PublicationDate;\n   398\t        return T.CreateChecked((long)_create.ExecuteScalar()!);\n   399\t    }\n   400\t\n   401\t    public BlogPost? Get(T id)\n   402\t    {\n   403\t        _get.Parameters[0].Value = long.CreateChecked(id);\n   404\t        using var reader = _get.ExecuteReader();\n   405\t        return reader.Read() ? BlogPost(reader) : null;\n   406\t    }\n   407\t\n   408\t    public void Each(Action<T, BlogPost> visit)\n   409\t    {\n   410\t        using var reader = _each.ExecuteReader();\n   411\t        while (reader.Read())\n   412\t        {\n   413\t            visit(T.CreateChecked(reader.GetInt64(3)), BlogPost(reader));\n   414\t        }\n   415\t    }\n   416\t\n   417\t    public void Delete(T id)\n   418\t    {\n   419\t        _delete.Parameters[0].Value = long.CreateChecked(id);\n   420\t        _delete.ExecuteNonQuery(