[2026-10-05T00:28:08.571Z] [INFO]         "content": "     1\t//! Runs every storage through the same lifecycle on a fresh store per repetition:\n     2\t//! a timed batch per operation, each validated against the expected count and checksum.\n     3\t\n     4\tuse crate::{\n     5\t    dataset::{self, blog_post, link, mix, scattered},\n     6\t    links::{DoubletsLinks, Link, LinksStorage, SqliteLinks},\n     7\t    memory::{Whole, volatile},\n     8\t    objects::{BlogPostsStorage, DoubletsBlogPosts, SqliteBlogPosts},\n     9\t};\n    10\tuse doublets::{\n    11\t    data::{LinkReference, LinksConstants},\n    12\t    mem::FileMapped,\n    13\t    split, unit,\n    14\t};\n    15\tuse serde_json::{Value, json};\n    16\tuse std::{\n    17\t    fs,\n    18\t    path::{Path, PathBuf},\n    19\t    time::{Duration, Instant},\n    20\t};\n    21\t\n    22\tpub const LINKS_VARIANTS: [&str; 6] = [\n    23\t    \"SQLite_Memory\",\n    24\t    \"SQLite_File\",\n    25\t    \"Doublets_United_Volatile\",\n    26\t    \"Doublets_United_NonVolatile\",\n    27\t    \"Doublets_Split_Volatile\",\n    28\t    \"Doublets_Split_NonVolatile\",\n    29\t];\n    30\t\n    31\tpub const OBJECTS_VARIANTS: [&str; 10] = [\n    32\t    \"SQLite_Memory\",\n    33\t    \"SQLite_File\",\n    34\t    \"Doublets_United_Volatile_Cached\",\n    35\t    \"Doublets_United_Volatile_Uncached\",\n    36\t    \"Doublets_United_NonVolatile_Cached\",\n    37\t    \"Doublets_United_NonVolatile_Uncached\",\n    38\t    \"Doublets_Split_Volatile_Cached\",\n    39\t    \"Doublets_Split_Volatile_Uncached\",\n    40\t    \"Doublets_Split_NonVolatile_Cached\",\n    41\t    \"Doublets_Split_NonVolatile_Uncached\",\n    42\t];\n    43\t\n    44\tpub const WARM_UP_SIZE: u64 = 10_000;\n    45\t\n    46\ttype Timings = Vec<(&'static str, Duration)>;\n    47\t\n    48\t/// Count and order-sensitive checksum of the records an operation has seen.\n    49\t#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\n    50\tpub struct Tally {\n    51\t    pub count: u64,\n    52\t    pub checksum: u64,\n    53\t}\n    54\t\n    55\timpl Tally {\n    56\t    fn add(&mut self, checksum: u64) {\n    57\t        self.count += 1;\n    58\t        self.checksum = self.checksum.wrapping_add(checksum);\n    59\t    }\n    60\t\n    61\t    fn add_link<T: LinkReference>(&mut self, link: Link<T>) {\n    62\t        self.add(dataset::link_checksum(\n    63\t            uint(link.id),\n    64\t            uint(link.from),\n    65\t            uint(link.to),\n    66\t        ));\n    67\t    }\n    68\t\n    69\t    fn of(count: u64, checksum: u64) -> Self {\n    70\t        Self { count, checksum }\n    71\t    }\n    72\t}\n    73\t\n    74\tfn timed(\n    75\t    timings: &mut Timings,\n    76\t    operation: &'static str,\n    77\t    expected: Tally,\n    78\t    work: impl FnOnce() -> Tally,\n    79\t) {\n    80\t    let start = Instant::now();\n    81\t    let actual = work();\n    82\t    timings.push((operation, start.elapsed()));\n    83\t    assert_eq!(actual, expected, \"{operation} returned unexpected records\");\n    84\t}\n    85\t\n    86\tfn int<T: LinkReference>(value: u64) -> T {\n    87\t    T::try_from(value).unwrap()\n    88\t}\n    89\t\n    90\tfn uint<T: LinkReference>(value: T) -> u64 {\n    91\t    value.try_into().unwrap()\n    92\t}\n    93\t\n    94\tpub fn links_lifecycle<T: LinkReference, S: LinksStorage<T>>(\n    95\t    storage: &mut S,\n    96\t    n: u64,\n    97\t    created: &mut dyn FnMut(),\n    98\t) -> Timings {\n    99\t    let expected = Tally::of(n, dataset::links_checksum(n, false));\n   100\t    let mut timings = Timings::new();\n   101\t\n   102\t    timed(&mut timings, \"create\", expected, || {\n   103\t        storage.transaction(|links| {\n   104\t            let mut tally = Tally::default();\n   105\t            for i in 1..=n {\n   106\t                let (from, to) = link(i);\n   107\t                let id = links.create(int(from), int(to));\n   108\t                tally.add_link(Link {\n   109\t                    id,\n   110\t                    from: int(from),\n   111\t                    to: int(to),\n   112\t                });\n   113\t            }\n   114\t            tally\n   115\t        })\n   116\t    });\n   117\t    created();\n   118\t\n   119\t    timed(&mut timings, \"query_all\", expected, || {\n   120\t        storage.transaction(|links| {\n   121\t            let mut tally = Tally::default();\n   122\t            links.each(|link| tally.add_link(link));\n   123\t            tally\n   124\t        })\n   125\t    });\n   126\t    timed(&mut timings, \"query_by_id\", expected, || {\n   127\t        storage.transaction(|links| {\n   128\t            let mut tally = Tally::default();\n   129\t            for id in scattered(n) {\n   130\t                tally.add_link(links.get(int(id)).unwrap());\n   131\t            }\n   132\t            tally\n   133\t        })\n   134\t    });\n   135\t    timed(&mut timings, \"query_by_from_to\", expected, || {\n   136\t        storage.transaction(|links| {\n   137\t            let mut tally = Tally::default();\n   138\t            for i in scattered(n) {\n   139\t                let (from, to) = link(i);\n   140\t                let id = links.search(int(from), int(to)).unwrap();\n   141\t                tally.add_link(Link {\n   142\t                    id,\n   143\t                    from: int(from),\n   144\t                    to: int(to),\n   145\t                });\n   146\t            }\n   147\t            tally\n   148\t        })\n   149\t    });\n   150\t    timed(&mut timings, \"query_by_from\", expected, || {\n   151\t        storage.transaction(|links| {\n   152\t            let mut tally = Tally::default();\n   153\t            for from in scattered(n) {\n   154\t                links.each_with_from(int(from), |link| tally.add_link(link));\n   155\t            }\n   156\t            tally\n   157\t        })\n   158\t    });\n   159\t    timed(&mut timings, \"query_by_to\", expected, || {\n   160\t        storage.transaction(|links| {\n   161\t            let mut tally = Tally::default();\n   162\t            for to in scattered(n) {\n   163\t                links.each_with_to(int(to), |link| tally.add_link(link));\n   164\t            }\n   165\t            tally\n   166\t        })\n   167\t    });\n   168\t\n   169\t    let swapped = Tally::of(n, dataset::links_checksum(n, true));\n   170\t    timed(&mut timings, \"update\", swapped, || {\n   171\t        storage.transaction(|links| {\n   172\t            let mut tally = Tally::default();\n   173\t            for id in scattered(n) {\n   174\t                let (from, to) = link(id);\n   175\t                links.update(int(id), int(to), int(from));\n   176\t                tally.add(dataset::link_checksum(id, to, from));\n   177\t            }\n   178\t            tally\n   179\t        })\n   180\t    });\n   181\t    let mut stored = Tally::default();\n   182\t    storage.each(|link| stored.add_link(link));\n   183\t    assert_eq!(stored, swapped, \"update did not swap every link\");\n   184\t\n   185\t    timed(&mut timings, \"delete\", Tally::of(n, 0), || {\n   186\t        storage.transaction(|links| {\n   187\t            let mut tally = Tally::default();\n   188\t            for id in scattered(n) {\n   189\t                links.delete(int(id));\n   190\t                tally.add(0);\n   191\t            }\n   192\t            tally\n   193\t        })\n   194\t    });\n   195\t    assert_eq!(storage.count(), 0, \"delete left links behind\");\n   196\t    timings\n   197\t}\n   198\t\n   199\tpub fn objects_lifecycle<T: LinkReference, S: BlogPostsStorage<T>>(\n   200\t    storage: &mut S,\n   201\t    n: u64,\n   202\t    created: &mut dyn FnMut(),\n   203\t) -> Timings {\n   204\t    let expected = Tally::of(n, dataset::blog_posts_checksum(n));\n   205\t    let mut timings = Timings::new();\n   206\t    let mut ids = Vec::with_capacity(n as usize);\n   207\t\n   208\t    timed(&mut timings, \"create\", expected, || {\n   209\t        storage.transaction(|posts| {\n   210\t            let mut tally = Tally::default();\n   211\t            for i in 1..=n {\n   212\t                let post = blog_post(i);\n   213\t                ids.push(posts.create(&post));\n   214\t                tally.add(post.checksum());\n   215\t            }\n   216\t            tally\n   217\t        })\n   218\t    });\n   219\t    created();\n   220\t\n   221\t    timed(&mut timings, \"read_all\", expected, || {\n   222\t        storage.transaction(|posts| {\n   223\t            let mut tally = Tally::default();\n   224\t            posts.each(|_, post| tally.add(post.checksum()));\n   225\t            tally\n   226\t        })\n   227\t    });\n   228\t    timed(\n   229\t        &mut timings,\n   230\t        \"read_by_id\",\n   231\t        Tally::of(n, dataset::blog_posts_by_number_checksum(n)),\n   232\t        || {\n   233\t            storage.transaction(|posts| {\n   234\t                let mut tally = Tally::default();\n   235\t                for i in scattered(n) {\n   236\t                    let post = posts.get(ids[i as usize - 1]).unwrap();\n   237\t                    tally.add(mix(i, post.checksum()));\n   238\t                }\n   239\t                tally\n   240\t            })\n   241\t        },\n   242\t    );\n   243\t    timed(&mut timings, \"delete\", Tally::of(n, 0), || {\n   244\t        storage.transaction(|posts| {\n   245\t            let mut tally = Tally::default();\n   246\t            for i in scattered(n) {\n   247\t                posts.delete(ids[i as usize - 1]);\n   248\t                tally.add(0);\n   249\t            }\n   250\t            tally\n   251\t        })\n   252\t    });\n   253\t    assert_eq!(storage.count(), 0, \"delete left blog posts behind\");\n   254\t    timings\n   255\t}\n   256\t\n   257\tpub struct Measurement {\n   258\t    pub variant: &'static str,\n   259\t    pub file_bytes: Option<u64>,\n   260\t    pub operations: Vec<(&'static str, Vec<f64>)>,\n   261\t}\n   262\t\n   263\timpl Measurement {\n   264\t    pub fn to_json(&self) -> Value {\n   265\t        let operations: serde_json::Map<String, Value> = self\n   266\t            .operations\n   267\t            .iter()\n   268\t            .map(|(operation, samples)| {\n   269\t                let mut sorted = samples.clone();\n   270\t                sorted.sort_by(f64::total_cmp);\n   271\t                let middle = sorted.len() / 2;\n   272\t                let median = if sorted.len() % 2 == 0 {\n   273\t                    (sorted[middle - 1] + sorted[middle]) / 2.0\n   274\t                } else {\n   275\t                    sorted[middle]\n   276\t                };\n   277\t                let summary = json!({\n   278\t                    \"median_ns\": median,\n   279\t                    \"min_ns\": sorted[0],\n   280\t                    \"max_ns\": sorted[sorted.len() - 1],\n   281\t                    \"samples_ns\": samples,\n   282\t                });\n   283\t                (operation.to_string(), summary)\n   284\t            })\n   285\t            .collect();\n   286\t        json!({ \"variant\": self.variant, \"file_bytes\": self.file_bytes, \"operations\": operations })\n   287\t    }\n   288\t}\n   289\t\n   290\tfn directory_bytes(directory: &Path) -> u64 {\n   291\t    fs::read_dir(directory)\n   292\t        .unwrap()\n   293\t        .map(|entry| entry.unwrap().metadata().unwrap().len())\n   294\t        .sum()\n   295\t}\n   296\t\n   297\t/// Times `lifecycle` on `repetitions` fresh stores opened in empty directories, after one discarded warm-up.\n   298\tfn measure<S>(\n   299\t    variant: &'static str,\n   300\t    n: u64,\n   301\t    repetitions: usize,\n   302\t    directory: &Path,\n   303\t    open: impl Fn(&Path) -> S,\n   304\t    lifecycle: fn(&mut S, u64, &mut dyn FnMut()) -> Timings,\n   305\t) -> Measurement {\n   306\t    let mut measurement = Measurement {\n   307\t        variant,\n   308\t        file_bytes: None,\n   309\t        operations: Vec::new(),\n   310\t    };\n   311\t    for repetition in 0..=repetitions {\n   312\t        let size = if repetition == 0 {\n   313\t            n.min(WARM_UP_SIZE)\n   314\t        } else {\n   315\t            n\n   316\t        };\n   317\t        let workspace = directory.join(format!(\"{variant}-{repetition}\"));\n   318\t        fs::create_dir_all(&workspace).unwrap();\n   319\t        let mut storage = open(&workspace);\n   320\t        let mut file_bytes = 0;\n   321\t        let timings = lifecycle(&mut storage, size, &mut || {\n   322\t            file_bytes = directory_bytes(&workspace)\n   323\t        });\n   324\t        drop(storage);\n   325\t        fs::remove_dir_all(&workspace).unwrap();\n   326\t        if repetition == 0 {\n   327\t            continue;\n   328\t        }\n   329\t        eprintln!(\"{variant} #{repetition}: {}\", summary(&timings, n));\n   330\t        measurement.file_bytes = (file_bytes > 0).then_some(file_bytes);\n   331\t        for (operation, elapsed) in timings {\n   332\t            let ns_per_operation = elapsed.as_nanos() as f64 / n as f64;\n   333\t            match measurement\n   334\t                .operations\n   335\t                .iter_mut()\n   336\t                .find(|(name, _)| *name == operation)\n   337\t            {\n   338\t                Some((_, samples)) => samples.push(ns_per_operation),\n   339\t                None => measurement\n   340\t                    .operations\n   341\t                    .push((operation, vec![ns_per_operation])),\n   342\t            }\n   343\t        }\n   344\t    }\n   345\t    measurement\n   346\t}\n   347\t\n   348\tfn summary(timings: &Timings, n: u64) -> String {\n   349\t    timings\n   350\t        .iter()\n   351\t        .map(|(operation, elapsed)| {\n   352\t            format!(\n   353\t                \"{operation} {:.0} ns/op\",\n   354\t                elapsed.as_nanos() as f64 / n as f64\n   355\t            )\n   356\t        })\n   357\t        .collect::<Vec<_>>()\n   358\t        .join(\", \")\n   359\t}\n   360\t\n   361\tfn file(directory: &Path, name: &str) -> PathBuf {\n   362\t    directory.join(name)\n   363\t}\n   364\t\n   365\tfn mapped<P>(directory: &Path, name: &str) -> Whole<FileMapped<P>> {\n   366\t    crate::memory::mapped(file(directory, name))\n   367\t}\n   368\t\n   369\tpub fn measure_links<T: LinkReference>(\n   370\t    variant: &'static str,\n   371\t    n: u64,\n   372\t    repetitions: usize,\n   373\t    directory: &Path,\n   374\t) -> Measurement {\n   375\t    match variant {\n   376\t        \"SQLite_Memory\" => measure(\n   377\t            variant,\n   378\t            n,\n   379\t            repetitions,\n   380\t            directory,\n   381\t            |_| SqliteLinks::<T>::in_memory(),\n   382\t            links_lifecycle,\n   383\t        ),\n   384\t        \"SQLite_File\" => measure(\n   385\t            variant,\n   386\t            n,\n   387\t            repetitions,\n   388\t            directory,\n   389\t            |dir| SqliteLinks::<T>::open(file(dir, \"links.db\")),\n   390\t            links_lifecycle,\n   391\t        ),\n   392\t        \"Doublets_United_Volatile\" => measure(\n   393\t            variant,\n   394\t            n,\n   395\t            repetitions,\n   396\t            directory,\n   397\t            |_| DoubletsLinks::new(unit::Store::<T, _>::new(volatile()).unwrap()),\n   398\t            links_lifecycle,\n   399\t        ),\n   400\t        \"Doublets_United_NonVolatile\" => measure(\n   401\t            variant,\n   402\t            n,\n   403\t            repetitions,\n   404\t            directory,\n   405\t            |dir| DoubletsLinks::new(unit::Store::<T, _>::new(mapped(dir, \"links.links\")).unwrap()),\n   406\t            links_lifecycle,\n   407\t        ),\n   408\t        \"Doublets_Split_Volatile\" => measure(\n   409\t            variant,\n   410\t            n,\n   411\t            repetitions,\n   412\t            directory,\n   413\t            |_| DoubletsLinks::new(split::Store::<T, _, _>::new(volatile(), volatile()).unwrap()),\n   414\t            links_lifecycle,\n   415\t        ),\n   416\t        \"Doublets_Split_NonVolatile\" => measure(\n   417\t            variant,\n   418\t            n,\n   419\t            repetitions,\n   420\t            directory,\n   421\t            |dir| {\n   422\t                DoubletsLinks::new(\n   423\t                    split::Store::<T, _, _>::new(\n   424\t                        mapped(dir, \"data.links\"),\n   425\t                        mapped(dir, \"index.links\"),\n   426\t                    )\n   427\t                    .unwrap(),\n   428\t                )\n   429\t            },\n   430\t            links_lifecycle,\n   431\t        ),\n   432\t        _ => panic!(\"unknown links variant {variant}\"),\n   433\t    }\n   434\t}\n   435\t\n   436\tpub fn measure_objects<T: LinkReference>(\n   437\t    variant: &'static str,\n   438\t    n: u64,\n   439\t    repetitions: usize,\n   440\t    directory: &Path,\n   441\t) -> Measurement {\n   442\t    let cached = variant.ends_with(\"_Cached\");\n   443\t    match variant\n   444\t        .trim_end_matches(\"_Cached\")\n   445\t        .trim_end_matches(\"_Uncached\")\n   446\t    {\n   447\t        \"SQLite_Memory\" => measure(\n   448\t            variant,\n   449\t            n,\n   450\t            repetitions,\n   451\t            directory,\n   452\t            |_| SqliteBlogPosts::<T>::in_memory(),\n   453\t            objects_lifecycle,\n   454\t        ),\n   455\t        \"SQLite_File\" => measure(\n   456\t            variant,\n   457\t            n,\n   458\t            repetitions,\n   459\t            directory,\n   460\t            |dir| SqliteBlogPosts::<T>::open(file(dir, \"blog_posts.db\")),\n   461\t            objects_lifecycle,\n   462\t        ),\n   463\t        \"Doublets_United_Volatile\" => measure(\n   464\t            variant,\n   465\t            n,\n   466\t            repetitions,\n   467\t            directory,\n   468\t            |_| {\n   469\t                DoubletsBlogPosts::new(\n   470\t                    unit::Store::<T, _>::with_constants(volatile(), LinksConstants::external())\n   471\t                        .unwrap(),\n   472\t                    cached,\n   473\t                )\n   474\t            },\n   475\t            objects_lifecycle,\n   476\t        ),\n   477\t        \"Doublets_United_NonVolatile\" => measure(\n   478\t            variant,\n   479\t            n,\n   480\t            repetitions,\n   481\t            directory,\n   482\t            |dir| {\n   483\t                DoubletsBlogPosts::new(\n   484\t                    unit::Store::<T, _>::with_constants(\n   485\t                        mapped(dir, \"links.links\"),\n   486\t                        LinksConstants::external(),\n   487\t                    )\n   488\t                    .unwrap(),\n   489\t                    cached,\n   490\t                )\n   491\t            },\n   492\t            objects_lifecycle,\n   493\t        ),\n   494\t        \"Doublets_Split_Volatile\" => measure(\n   495\t            variant,\n   496\t            n,\n   497\t            repetitions,\n   498\t            directory,\n   499\t            |_| {\n   500\t                DoubletsBlogPosts::new(\n   501\t                    split::Store::<T, _, _>::with_constants(\n   502\t                        volatile(),\n   503\t                        volatile(),\n   504\t                        LinksConstants::external(),\n   505\t                    )\n   506\t                    .unwrap(),\n   507\t                    cached,\n   508\t                )\n   509\t            },\n   510\t            objects_lifecycle,\n   511\t        ),\n   512\t        \"Doublets_Split_NonVolatile\" => measure(\n   513\t            variant,\n   514\t            n,\n   515\t            repetitions,\n   516\t            directory,\n   517\t            |dir| {\n   518\t                DoubletsBlogPosts::new(\n   519\t                    split::Store::<T, _, _>::with_constants(\n   520\t                        mapped(dir, \"data.links\"),\n   521\t                        mapped(dir, \"index.links\"),\n   522\t                        LinksConstants::external(),\n   523\t                    )\n   524\t                    .unwrap(),\n   525\t                    cached,\n   526\t                )\n   527\t            },\n   528\t            objects_lifecycle,\n   529\t        ),\n   530\t        _ => panic!(\"unknown objects variant {variant}\"),\n   531\t    }\n   532\t}",
