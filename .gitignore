# Root level gitignore for the repository
# C# specific gitignore is in csharp/.gitignore
# C++ specific files
cpp/build/
cpp/*.o
cpp/*.a
cpp/*.so
cpp/*.exe

# Common temporary files
__pycache__/
.venv/
*.py[cod]
*.tmp
*.log
!dev/log/issues/**/*.log
*.swp
*~
.DS_Store

# Rust build output
target/

# .NET build output
bin/
obj/

# Raw investigation files are preserved in the verified compressed archive.
/dev/log/issues/110/pulls/111/ci-logs/
/dev/log/issues/110/pulls/111/github/
/dev/log/issues/110/pulls/111/research/
/dev/log/issues/110/pulls/111/templates/
/dev/log/issues/110/pulls/111/validation/
