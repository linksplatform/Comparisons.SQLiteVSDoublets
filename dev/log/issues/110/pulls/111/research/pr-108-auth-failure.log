[2026-10-04T17:13:51.453Z] [INFO]                 "+                var id = storage.Create(Int(from), Int(to));",
[2026-10-04T17:13:51.453Z] [INFO]                 "+                tally.AddLink(new Link<T>(id, Int(from), Int(to)));",
[2026-10-04T17:13:51.453Z] [INFO]                 "+            }",
[2026-10-04T17:13:51.453Z] [INFO]                 "+            return tally;",
[2026-10-04T17:13:51.453Z] [INFO]                 "+        }));",
[2026-10-04T17:13:51.453Z] [INFO]                 "+        created();",
[2026-10-04T17:13:51.453Z] [INFO]                 "+",
[2026-10-04T17:13:51.453Z] [INFO]                 "+        Timed(timings, \"query_all\", expected, () => storage.Transaction(() =>",
[2026-10-04T17:13:51.453Z] [INFO]                 "+        {",
