[2026-10-04T16:49:46.162Z] [INFO]       "content": "//! Runs every storage through the same lifecycle on a fresh store per repetition:\n//! a timed batch per operation, each validated against the expected count and checksum.\n\nuse crate::{\n    dataset::{self, blog_post, link, mix, scattered},\n    links::{LinksStorage, SqliteLinks},\n    objects::{BlogPostsStorage, DoubletsBlogPosts, SqliteBlogPosts},\n};\nuse doublets::{\n    data::LinkReference,\n    mem::{FileMapped, Global},\n    split, unit,\n};\nuse serde_json::{Value, json};\nuse std::{\n    fs,\n    path::{Path, PathBuf},\n    time::{Duration, Instant},\n};\n\npub const LINKS_VARIANTS: [&str; 6] = [\n    \"SQLite_Memory\",\n    \"SQLite_File\",\n    \"Doublets_United_Volatile\",\n    \"Doublets_United_NonVolatile\",\n    \"Doublets_Split_Volatile\",\n    \"Doublets_Split_NonVolatile\",\n];\n\npub const OBJECTS_VARIANTS: [&str; 10] = [\n    \"SQLite_Memory\",\n    \"SQLite_File\",\n    \"Doublets_United_Volatile_Cached\",\n    \"Doublets_United_Volatile_Uncached\",\n    \"Doublets_United_NonVolatile_Cached\",\n    \"Doublets_United_NonVolatile_Uncached\",\n    \"Doublets_Split_Volatile_Cached\",\n    \"Doublets_Split_Volatile_Uncached\",\n    \"Doublets_Split_NonVolatile_Cached\",\n    \"Doublets_Split_NonVolatile_Uncached\",\n];\n\npub const WARM_UP_SIZE: u64 = 10_000;\n\ntype Timings = Vec<(&'static str, Duration)>;\n\nfn timed(timings: &mut Timings, operation: &'static str, expected: (u64, u64), work: impl FnOnce() -> (u64, u64)) {\n    let start = Instant::now();\n    let actual = work();\n    timings.push((operation, start.elapsed()));\n    assert_eq!(actual, expected, \"{operation} returned an unexpected (count, checksum)\");\n}\n\nfn int<T: LinkReference>(value: u64) -> T {\n    T::try_from(value).unwrap()\n}\n\nfn uint<T: LinkReference>(value: T) -> u64 {\n    value.try_into().unwrap()\n}\n\npub fn links_lifecycle<T: LinkReference>(storage: &mut impl LinksStorage<T>, n: u64, created: impl FnOnce()) -> Timings {\n    let expected = (n, dataset::links_checksum(n, false));\n    let checksum = |link: crate::links::Link<T>| dataset::link_checksum(uint(link.id), uint(link.from), uint(link.to));\n    let mut timings = Timings::new();\n\n    timed(&mut timings, \"create\", expected, || {\n        storage.transaction(|links| {\n            (1..=n).fold((0, 0), |(count, sum), i| {\n                let (from, to) = link(i);\n                let id = links.create(int(from), int(to));\n                (count + 1, sum.wrapping_add(dataset::link_checksum(uint(id), from, to)))\n            })\n        })\n    });\n    created();\n\n    let mut each = |visit: &mut dyn FnMut(&mut dyn FnMut(crate::links::Link<T>))| {\n        let (mut count, mut sum) = (0, 0u64);\n        visit(&mut |link| {\n            count += 1;\n            sum = sum.wrapping_add(checksum(link));\n        });\n        (count, sum)\n    };\n    timed(&mut timings, \"query_all\", expected, || storage.transaction(|links| each(&mut |visit| links.each(visit))));\n    timed(&mut timings, \"query_by_id\", expected, || {\n        storage.transaction(|links| each(&mut |visit| scattered(n).for_each(|id| visit(links.get(int(id)).unwrap()))))\n    });\n    timed(&mut timings, \"query_by_from_to\", expected, || {\n        storage.transaction(|links| {\n            each(&mut |visit| {\n                for i in scattered(n) {\n                    let (from, to) = link(i);\n                    let id = links.search(int(from), int(to)).unwrap();\n                    visit(crate::links::Link { id, from: int(from), to: int(to) });\n                }\n            })\n        })\n    });\n    timed(&mut timings, \"query_by_from\", expected, || {\n        storage.transaction(|links| each(&mut |visit| scattered(n).for_each(|from| links.each_with_from(int(from), &mut *visit))))\n    });\n    timed(&mut timings, \"query_by_to\", expected, || {\n        storage.transaction(|links| each(&mut |visit| scattered(n).for_each(|to| links.each_with_to(int(to), &mut *visit))))\n    });\n\n    let swapped = (n, dataset::links_checksum(n, true));\n    timed(&mut timings, \"update\", swapped, || {\n        storage.transaction(|links| {\n            scattered(n).fold((0, 0), |(count, sum), id| {\n                let (from, to) = link(id);\n                links.update(int(id), int(to), int(from));\n                (count + 1, sum.wrapping_add(dataset::link_checksum(id, to, from)))\n            })\n        })\n    });\n    assert_eq!(each(&mut |visit| storage.each(visit)), swapped, \"update did not swap every link\");\n\n    timed(&mut timings, \"delete\", (n, 0), || {\n        storage.transaction(|links| {\n            scattered(n).fold((0, 0), |(count, sum), id| {\n                links.delete(int(id));\n                (count + 1, sum)\n            })\n        })\n    });\n    assert_eq!(storage.count(), 0, \"delete left links behind\");\n    timings\n}\n\npub fn objects_lifecycle<T: LinkReference>(storage: &mut impl BlogPostsStorage<T>, n: u64, created: impl FnOnce()) -> Timings {\n    let expected = (n, dataset::blog_posts_checksum(n));\n    let mut timings = Timings::new();\n    let mut ids = Vec::with_capacity(n as usize);\n\n    timed(&mut timings, \"create\", expected, || {\n        storage.transaction(|posts| {\n            (1..=n).fold((0, 0), |(count, sum), i| {\n                let post = blog_post(i);\n                ids.push(posts.create(&post));\n                (count + 1, sum + post.checksum())\n            })\n        })\n    });\n    created();\n\n    timed(&mut timings, \"read_all\", expected, || {\n        storage.transaction(|posts| {\n            let (mut count, mut sum) = (0, 0);\n            posts.each(|_, post| {\n                count += 1;\n                sum += post.checksum();\n            });\n            (count, sum)\n        })\n    });\n    timed(&mut timings, \"read_by_id\", (n, dataset::blog_posts_by_number_checksum(n)), || {\n        storage.transaction(|posts| {\n            scattered(n).fold((0, 0u64), |(count, sum), i| {\n                let post = posts.get(ids[i as usize - 1]).unwrap();\n                (count + 1, sum.wrapping_add(mix(i, post.checksum())))\n            })\n        })\n    });\n    timed(&mut timings, \"delete\", (n, 0), || {\n        storage.transaction(|posts| {\n            scattered(n).fold((0, 0), |(count, sum), i| {\n                posts.delete(ids[i as usize - 1]);\n                (count + 1, sum)\n            })\n        })\n    });\n    assert_eq!(storage.count(), 0, \"delete left blog posts behind\");\n    timings\n}\n\npub struct Measurement {\n    pub variant: &'static str,\n    pub file_bytes: Option<u64>,\n    pub operations: Vec<(&'static str, Vec<f64>)>,\n}\n\nimpl Measurement {\n    pub fn to_json(&self) -> Value {\n        let operations: serde_json::Map<String, Value> = self\n            .operations\n            .iter()\n            .map(|(operation, samples)| {\n                let mut sorted = samples.clone();\n                sorted.sort_by(f64::total_cmp);\n                let middle = sorted.len() / 2;\n                let median =\n                    if sorted.len() % 2 == 0 { (sorted[middle - 1] + sorted[middle]) / 2.0 } else { sorted[middle] };\n                let summary = json!({\n                    \"median_ns\": median,\n                    \"min_ns\": sorted[0],\n                    \"max_ns\": sorted[sorted.len() - 1],\n                    \"samples_ns\": samples,\n                });\n                (operation.to_string(), summary)\n            })\n            .collect();\n        json!({ \"variant\": self.variant, \"file_bytes\": self.file_bytes, \"operations\": operations })\n    }\n}\n\nfn directory_bytes(directory: &Path) -> u64 {\n    fs::read_dir(directory).unwrap().map(|entry| entry.unwrap().metadata().unwrap().len()).sum()\n}\n\n/// Times `lifecycle` on `repetitions` fresh stores opened in empty directories, after one discarded warm-up.\nfn measure<S>(\n    variant: &'static str,\n    n: u64,\n    repetitions: usize,\n    directory: &Path,\n    open: impl Fn(&Path) -> S,\n    lifecycle: impl Fn(&mut S, u64, &mut dyn FnMut()) -> Timings,\n) -> Measurement {\n    let mut measurement = Measurement { variant, file_bytes: None, operations: Vec::new() };\n    for repetition in 0..=repetitions {\n        let size = if repetition == 0 { n.min(WARM_UP_SIZE) } else { n };\n        let workspace = directory.join(format!(\"{variant}-{repetition}\"));\n        fs::create_dir_all(&workspace).unwrap();\n        let mut storage = open(&workspace);\n        let mut file_bytes = 0;\n        let timings = lifecycle(&mut storage, size, &mut || file_bytes = directory_bytes(&workspace));\n        drop(storage);\n        fs::remove_dir_all(&workspace).unwrap();\n        if repetition == 0 {\n            continue;\n        }\n        eprintln!(\"{variant} #{repetition}: {}\", summary(&timings, n));\n        measurement.file_bytes = (file_bytes > 0).then_some(file_bytes);\n        for (operation, elapsed) in timings {\n            let ns_per_operation = elapsed.as_nanos() as f64 / n as f64;\n            match measurement.operations.iter_mut().find(|(name, _)| *name == operation) {\n                Some((_, samples)) => samples.push(ns_per_operation),\n                None => measurement.operations.push((operation, vec![ns_per_operation])),\n            }\n        }\n    }\n    measurement\n}\n\nfn summary(timings: &Timings, n: u64) -> String {\n    timings\n        .iter()\n        .map(|(operation, elapsed)| format!(\"{operation} {:.0} ns/op\", elapsed.as_nanos() as f64 / n as f64))\n        .collect::<Vec<_>>()\n        .join(\", \")\n}\n\nfn file(directory: &Path, name: &str) -> PathBuf {\n    directory.join(name)\n}\n\nfn mapped<P>(directory: &Path, name: &str) -> FileMapped<P> {\n    FileMapped::from_path(file(directory, name)).unwrap()\n}\n\npub fn measure_links<T: LinkReference>(variant: &'static str, n: u64, repetitions: usize, directory: &Path) -> Measurement {\n    let lifecycle = |storage: &mut _, n, created: &mut dyn FnMut()| links_lifecycle::<T>(storage, n, created);\n    match variant {\n        \"SQLite_Memory\" => measure(variant, n, repetitions, directory, |_| SqliteLinks::<T>::in_memory(), lifecycle),\n        \"SQLite_File\" => measure(variant, n, repetitions, directory, |dir| SqliteLinks::<T>::open(file(dir, \"links.db\")), lifecycle),\n        \"Doublets_United_Volatile\" => {\n            measure(variant, n, repetitions, directory, |_| unit::Store::<T, _>::new(Global::new()).unwrap(), lifecycle)\n        }\n        \"Doublets_United_NonVolatile\" => measure(\n            variant,\n            n,\n            repetitions,\n            directory,\n            |dir| unit::Store::<T, _>::new(mapped(dir, \"links.links\")).unwrap(),\n            lifecycle,\n        ),\n        \"Doublets_Split_Volatile\" => measure(\n            variant,\n            n,\n            repetitions,\n            directory,\n            |_| split::Store::<T, _, _>::new(Global::new(), Global::new()).unwrap(),\n            lifecycle,\n        ),\n        \"Doublets_Split_NonVolatile\" => measure(\n            variant,\n            n,\n            repetitions,\n            directory,\n            |dir| split::Store::<T, _, _>::new(mapped(dir, \"data.links\"), mapped(dir, \"index.links\")).unwrap(),\n            lifecycle,\n        ),\n        _ => panic!(\"unknown links variant {variant}\"),\n    }\n}\n\npub fn measure_objects<T: LinkReference>(variant: &'static str, n: u64, repetitions: usize, directory: &Path) -> Measurement {\n    let lifecycle = |storage: &mut _, n, created: &mut dyn FnMut()| objects_lifecycle::<T>(storage, n, created);\n    let cached = variant.ends_with(\"_Cached\");\n    match variant.trim_end_matches(\"_Cached\").trim_end_matches(\"_Uncached\") {\n        \"SQLite_Memory\" => measure(variant, n, repetitions, directory, |_| SqliteBlogPosts::<T>::in_memory(), lifecycle),\n        \"SQLite_File\" => {\n            measure(variant, n, repetitions, directory, |dir| SqliteBlogPosts::<T>::open(file(dir, \"blog_posts.db\")), lifecycle)\n        }\n        \"Doublets_United_Volatile\" => measure(\n            variant,\n            n,\n            repetitions,\n            directory,\n            |_| DoubletsBlogPosts::new(unit::Store::<T, _>::new(Global::new()).unwrap(), cached),\n            lifecycle,\n        ),\n        \"Doublets_United_NonVolatile\" => measure(\n            variant,\n            n,\n            repetitions,\n            directory,\n            |dir| DoubletsBlogPosts::new(unit::Store::<T, _>::new(mapped(dir, \"links.links\")).unwrap(), cached),\n            lifecycle,\n        ),\n        \"Doublets_Split_Volatile\" => measure(\n            variant,\n            n,\n            repetitions,\n            directory,\n            |_| DoubletsBlogPosts::new(split::Store::<T, _, _>::new(Global::new(), Global::new()).unwrap(), cached),\n            lifecycle,\n        ),\n        \"Doublets_Split_NonVolatile\" => measure(\n            variant,\n            n,\n            repetitions,\n            directory,\n            |dir| {\n                DoubletsBlogPosts::new(\n                    split::Store::<T, _, _>::new(mapped(dir, \"data.links\"), mapped(dir, \"index.links\")).unwrap(),\n                    cached,\n                )\n            },\n            lifecycle,\n        ),\n        _ => panic!(\"unknown objects variant {variant}\"),\n    }\n}\n"
