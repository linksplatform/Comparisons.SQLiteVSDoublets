[2026-10-04T17:54:56.492Z] [INFO]           "+        reports[key] = report",
[2026-10-04T17:54:56.492Z] [INFO]           "+    return reports",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           "-OPERATIONS = LINK_OPERATIONS + OBJECT_OPERATIONS",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           "-# Benchmarked backends: identifier, label and chart color.",
[2026-10-04T17:54:56.492Z] [INFO]           "-DOUBLETS_VARIANTS = (",
[2026-10-04T17:54:56.492Z] [INFO]           "-    (\"Doublets_United_Volatile\", \"Doublets United Volatile\", \"salmon\"),",
[2026-10-04T17:54:56.492Z] [INFO]           "-    (\"Doublets_United_NonVolatile\", \"Doublets United NonVolatile\", \"red\"),",
[2026-10-04T17:54:56.492Z] [INFO]           "-    (\"Doublets_Split_Volatile\", \"Doublets Split Volatile\", \"lightgreen\"),",
[2026-10-04T17:54:56.492Z] [INFO]           "-    (\"Doublets_Split_NonVolatile\", \"Doublets Split NonVolatile\", \"green\"),",
[2026-10-04T17:54:56.492Z] [INFO]           "-)",
[2026-10-04T17:54:56.492Z] [INFO]           "+def baseline(variant):",
[2026-10-04T17:54:56.492Z] [INFO]           "+    \"\"\"Doublets are compared with SQLite of the same durability: volatile with memory, non-volatile with file.\"\"\"",
[2026-10-04T17:54:56.492Z] [INFO]           "+    if variant.startswith(\"SQLite\"):",
[2026-10-04T17:54:56.492Z] [INFO]           "+        return None",
[2026-10-04T17:54:56.492Z] [INFO]           "+    return \"SQLite_File\" if \"_NonVolatile\" in variant else \"SQLite_Memory\"",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           "-SQLITE_VARIANTS = (",
[2026-10-04T17:54:56.492Z] [INFO]           "-    (\"SQLite_Memory\", \"SQLite Memory\", \"lightblue\"),",
[2026-10-04T17:54:56.492Z] [INFO]           "-    (\"SQLite_File\", \"SQLite File\", \"royalblue\"),",
[2026-10-04T17:54:56.492Z] [INFO]           "-)",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           "-VARIANTS = DOUBLETS_VARIANTS + SQLITE_VARIANTS",
[2026-10-04T17:54:56.492Z] [INFO]           "+def duration(nanoseconds):",
[2026-10-04T17:54:56.492Z] [INFO]           "+    for unit, scale in ((\"s\", 1e9), (\"ms\", 1e6), (\"µs\", 1e3)):",
[2026-10-04T17:54:56.492Z] [INFO]           "+        if nanoseconds >= scale:",
[2026-10-04T17:54:56.492Z] [INFO]           "+            return f\"{nanoseconds / scale:.3g} {unit}\"",
[2026-10-04T17:54:56.492Z] [INFO]           "+    return f\"{nanoseconds:.3g} ns\"",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           "-# Doublets cells are annotated relative to the fastest SQLite measurement of",
[2026-10-04T17:54:56.492Z] [INFO]           "-# the same operation, the same way Comparisons.Neo4jVSDoublets annotates",
[2026-10-04T17:54:56.492Z] [INFO]           "-# against the fastest of the two Neo4j modes.",
[2026-10-04T17:54:56.492Z] [INFO]           "-BASELINES = tuple(key for key, _label, _color in SQLITE_VARIANTS)",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           "+def size(count):",
[2026-10-04T17:54:56.492Z] [INFO]           "+    return f\"{count:,}\"",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           "-def empty_results(operations=OPERATIONS):",
[2026-10-04T17:54:56.492Z] [INFO]           "-    \"\"\"Build an empty ``{operation: {variant: nanoseconds}}`` mapping.\"\"\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    return {op: {} for op, _label in operations}",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           "+def file_size(count):",
[2026-10-04T17:54:56.492Z] [INFO]           "+    return \"—\" if count is None else f\"{count / 2**20:.1f} MiB\"",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           "-def has_any_results(results):",
[2026-10-04T17:54:56.492Z] [INFO]           "-    \"\"\"Return ``True`` when at least one measurement was parsed.\"\"\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    return any(measurements for measurements in results.values())",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           "+def comparison(measured, reference, text):",
[2026-10-04T17:54:56.492Z] [INFO]           "+    \"\"\"How `measured` compares with `reference`; overlapping sample ranges are not called a difference.\"\"\"",
[2026-10-04T17:54:56.492Z] [INFO]           "+    if measured[\"min_ns\"] <= reference[\"max_ns\"] and reference[\"min_ns\"] <= measured[\"max_ns\"]:",
[2026-10-04T17:54:56.492Z] [INFO]           "+        return text[\"same\"]",
[2026-10-04T17:54:56.492Z] [INFO]           "+    if measured[\"median_ns\"] <= reference[\"median_ns\"]:",
[2026-10-04T17:54:56.492Z] [INFO]           "+        return text[\"faster\"].format(ratio=f\"{reference['median_ns'] / measured['median_ns']:.3g}\")",
[2026-10-04T17:54:56.492Z] [INFO]           "+    return text[\"slower\"].format(ratio=f\"{measured['median_ns'] / reference['median_ns']:.3g}\")",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           "-def missing_measurements(results, operations=OPERATIONS, variants=VARIANTS):",
[2026-10-04T17:54:56.492Z] [INFO]           "-    \"\"\"List expected ``operation/variant`` pairs absent from parsed output.\"\"\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    missing = []",
[2026-10-04T17:54:56.492Z] [INFO]           "-    for operation, _operation_label in operations:",
[2026-10-04T17:54:56.492Z] [INFO]           "-        measured = results.get(operation, {})",
[2026-10-04T17:54:56.492Z] [INFO]           "-        for variant, _variant_label, _color in variants:",
[2026-10-04T17:54:56.492Z] [INFO]           "-            if not measured.get(variant):",
[2026-10-04T17:54:56.492Z] [INFO]           "-                missing.append(f\"{operation}/{variant}\")",
[2026-10-04T17:54:56.492Z] [INFO]           "-    return missing",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           "-",
[2026-10-04T17:54:56.492Z] [INFO]           "-def baseline_of(measurements, baselines=BASELINES):",
[2026-10-04T17:54:56.492Z] [INFO]           "-    \"\"\"Fastest baseline (SQLite) measurement of a single operation, 0 if none.\"\"\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    values = [measurements.get(key, 0) for key in baselines]",
[2026-10-04T17:54:56.492Z] [INFO]           "-    values = [value for value in values if value]",
[2026-10-04T17:54:56.492Z] [INFO]           "-    return min(values) if values else 0",
[2026-10-04T17:54:56.492Z] [INFO]           "-",
[2026-10-04T17:54:56.492Z] [INFO]           "-",
[2026-10-04T17:54:56.492Z] [INFO]           "-def format_speedup(value, baseline):",
[2026-10-04T17:54:56.492Z] [INFO]           "-    \"\"\"Annotate ``value`` with how it compares to the ``baseline`` measurement.\"\"\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    if not value:",
[2026-10-04T17:54:56.492Z] [INFO]           "-        return \"N/A\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    if not baseline:",
[2026-10-04T17:54:56.492Z] [INFO]           "-        return f\"{value}\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    if value <= baseline:",
[2026-10-04T17:54:56.492Z] [INFO]           "-        return f\"{value} ({baseline / value:.1f}x faster)\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    return f\"{value} ({value / baseline:.1f}x slower)\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-",
[2026-10-04T17:54:56.492Z] [INFO]           "-",
[2026-10-04T17:54:56.492Z] [INFO]           "-def format_results_table(results, operations=OPERATIONS, variants=VARIANTS, baselines=BASELINES):",
[2026-10-04T17:54:56.492Z] [INFO]           "-    \"\"\"Render the Markdown results table (all numbers in nanoseconds).\"\"\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    labels = [label for _key, label, _color in variants]",
[2026-10-04T17:54:56.492Z] [INFO]           "-    cells_by_variant = []",
[2026-10-04T17:54:56.492Z] [INFO]           "-    for key, _label, _color in variants:",
[2026-10-04T17:54:56.492Z] [INFO]           "-        column = []",
[2026-10-04T17:54:56.492Z] [INFO]           "-        for op, _op_label in operations:",
[2026-10-04T17:54:56.492Z] [INFO]           "-            measurements = results.get(op, {})",
[2026-10-04T17:54:56.492Z] [INFO]           "-            value = measurements.get(key, 0)",
[2026-10-04T17:54:56.492Z] [INFO]           "-            if key in baselines:",
[2026-10-04T17:54:56.492Z] [INFO]           "-                column.append(str(value) if value else \"N/A\")",
[2026-10-04T17:54:56.492Z] [INFO]           "-            else:",
[2026-10-04T17:54:56.492Z] [INFO]           "-                column.append(format_speedup(value, baseline_of(measurements, baselines)))",
[2026-10-04T17:54:56.492Z] [INFO]           "-        cells_by_variant.append(column)",
[2026-10-04T17:54:56.492Z] [INFO]           "-",
[2026-10-04T17:54:56.492Z] [INFO]           "-    widths = [",
[2026-10-04T17:54:56.492Z] [INFO]           "-        max(len(label), *(len(cell) for cell in column))",
[2026-10-04T17:54:56.492Z] [INFO]           "-        for label, column in zip(labels, cells_by_variant)",
[2026-10-04T17:54:56.492Z] [INFO]           "-    ]",
[2026-10-04T17:54:56.492Z] [INFO]           "-    operation_width = max(len(\"Operation\"), *(len(label) for _key, label in operations))",
[2026-10-04T17:54:56.492Z] [INFO]           "-",
[2026-10-04T17:54:56.492Z] [INFO]           "-    header = \"| \" + \"Operation\".ljust(operation_width) + \" | \"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    header += \" | \".join(label.ljust(width) for label, width in zip(labels, widths))",
[2026-10-04T17:54:56.492Z] [INFO]           "-    header += \" |\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    separator = \"|\" + \"-\" * (operation_width + 2)",
[2026-10-04T17:54:56.492Z] [INFO]           "-    separator += \"\".join(\"|\" + \"-\" * (width + 2) for width in widths) + \"|\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-",
[2026-10-04T17:54:56.492Z] [INFO]           "-    lines = [header, separator]",
[2026-10-04T17:54:56.492Z] [INFO]           "-    for index, (_op, op_label) in enumerate(operations):",
[2026-10-04T17:54:56.492Z] [INFO]           "-        row = \"| \" + op_label.ljust(operation_width) + \" | \"",
[2026-10-04T17:54:56.492Z] [INFO]           "-        row += \" | \".join(",
[2026-10-04T17:54:56.492Z] [INFO]           "-            column[index].ljust(width) for column, width in zip(cells_by_variant, widths)",
[2026-10-04T17:54:56.492Z] [INFO]           "-        )",
[2026-10-04T17:54:56.492Z] [INFO]           "-        row += \" |\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-        lines.append(row)",
[2026-10-04T17:54:56.492Z] [INFO]           "-",
[2026-10-04T17:54:56.492Z] [INFO]           "+def table(report, text):",
[2026-10-04T17:54:56.492Z] [INFO]           "+    operations = OPERATIONS[report[\"category\"]]",
[2026-10-04T17:54:56.492Z] [INFO]           "+    by_variant = {result[\"variant\"]: result for result in report[\"results\"]}",
[2026-10-04T17:54:56.492Z] [INFO]           "+    header = [text[\"storage\"], *(text[\"operations\"][operation] for operation in operations), text[\"file_size\"]]",
[2026-10-04T17:54:56.492Z] [INFO]           "+    lines = [\"| \" + \" | \".join(header) + \" |\", \"|\" + \"---|\" + \"---:|\" * (len(header) - 1)]",
[2026-10-04T17:54:56.492Z] [INFO]           "+    for variant, result in by_variant.items():",
[2026-10-04T17:54:56.492Z] [INFO]           "+        reference = by_variant.get(baseline(variant))",
[2026-10-04T17:54:56.492Z] [INFO]           "+        cells = [variant.replace(\"_\", \" \")]",
[2026-10-04T17:54:56.492Z] [INFO]           "+        for operation in operations:",
[2026-10-04T17:54:56.492Z] [INFO]           "+            measured = result[\"operations\"][operation]",
[2026-10-04T17:54:56.492Z] [INFO]           "+            cell = duration(measured[\"median_ns\"])",
[2026-10-04T17:54:56.492Z] [INFO]           "+            if reference is not None:",
[2026-10-04T17:54:56.492Z] [INFO]           "+                cell += f\" ({comparison(measured, reference['operations'][operation], text)})\"",
[2026-10-04T17:54:56.492Z] [INFO]           "+            cells.append(cell)",
[2026-10-04T17:54:56.492Z] [INFO]           "+        cells.append(file_size(result[\"file_bytes\"]))",
[2026-10-04T17:54:56.492Z] [INFO]           "+        lines.append(\"| \" + \" | \".join(cells) + \" |\")",
[2026-10-04T17:54:56.492Z] [INFO]           "     return \"\\n\".join(lines)",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           "-def build_provenance(",
[2026-10-04T17:54:56.492Z] [INFO]           "-    benchmark_links=None,",
[2026-10-04T17:54:56.492Z] [INFO]           "-    background_links=None,",
[2026-10-04T17:54:56.492Z] [INFO]           "-    object_count=None,",
[2026-10-04T17:54:56.492Z] [INFO]           "-    generated_at=None,",
[2026-10-04T17:54:56.492Z] [INFO]           "-    language=None,",
[2026-10-04T17:54:56.492Z] [INFO]           "-):",
[2026-10-04T17:54:56.492Z] [INFO]           "-    \"\"\"Describe how and when the committed results were produced.\"\"\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    benchmark_links = benchmark_links or os.environ.get(\"BENCHMARK_LINK_COUNT\", \"1000\")",
[2026-10-04T17:54:56.492Z] [INFO]           "-    background_links = background_links or os.environ.get(\"BACKGROUND_LINK_COUNT\", \"3000\")",
[2026-10-04T17:54:56.492Z] [INFO]           "-    if object_count is not False:",
[2026-10-04T17:54:56.492Z] [INFO]           "-        object_count = object_count or os.environ.get(\"BENCHMARK_OBJECT_COUNT\", \"1000\")",
[2026-10-04T17:54:56.492Z] [INFO]           "-    generated_at = generated_at or datetime.now(timezone.utc).strftime(\"%Y-%m-%d %H:%M UTC\")",
[2026-10-04T17:54:56.492Z] [INFO]           "+def provenance(report, text):",
[2026-10-04T17:54:56.492Z] [INFO]           "+    count = report[\"repetitions\"]",
[2026-10-04T17:54:56.492Z] [INFO]           "+    repetitions = text[\"repetitions\"].get(count) or text[\"repetitions_many\"].format(count=count)",
[2026-10-04T17:54:56.492Z] [INFO]           "+    run = report.get(\"run_url\")",
[2026-10-04T17:54:56.492Z] [INFO]           "+    source = text[\"run\"].format(url=run, date=report.get(\"date\", \"\")) if run else text[\"local\"]",
[2026-10-04T17:54:56.492Z] [INFO]           "+    machine = report.get(\"machine\", \"\")",
[2026-10-04T17:54:56.492Z] [INFO]           "+    return text[\"provenance\"].format(",
[2026-10-04T17:54:56.492Z] [INFO]           "+        repetitions=repetitions, sqlite=report[\"sqlite_version\"], machine=machine, source=source",
[2026-10-04T17:54:56.492Z] [INFO]           "+    ).replace(\", ,\", \",\")",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           "-    source = \"a local benchmark run\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    repository = os.environ.get(\"GITHUB_REPOSITORY\")",
[2026-10-04T17:54:56.492Z] [INFO]           "-    run_id = os.environ.get(\"GITHUB_RUN_ID\")",
[2026-10-04T17:54:56.492Z] [INFO]           "-    if repository and run_id:",
[2026-10-04T17:54:56.492Z] [INFO]           "-        source = (",
[2026-10-04T17:54:56.492Z] [INFO]           "-            f\"[GitHub Actions run {run_id}]\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-            f\"(https://github.com/{repository}/actions/runs/{run_id})\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-        )",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           "-    prefix = f\"_Generated {generated_at}\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    if language:",
[2026-10-04T17:54:56.492Z] [INFO]           "-        prefix += f\" for {language}\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    quantities = (",
[2026-10-04T17:54:56.492Z] [INFO]           "-        f\"{benchmark_links} benchmarked links, \"",
[2026-10-04T17:54:56.492Z] [INFO]           "-        f\"{background_links} background links\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    )",
[2026-10-04T17:54:56.492Z] [INFO]           "-    if object_count is not False:",
[2026-10-04T17:54:56.492Z] [INFO]           "-        quantities += f\", {object_count} objects\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    return f\"{prefix} by {source} — {quantities}._\"",
[2026-10-04T17:54:56.492Z] [INFO]           "+def chart_name(category, language, bits):",
[2026-10-04T17:54:56.492Z] [INFO]           "+    return f\"{category}-{language.lower().replace('#', 'sharp')}-{bits}.png\"",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           "-def render_results_section(results, provenance=None, **table_options):",
[2026-10-04T17:54:56.492Z] [INFO]           "-    \"\"\"Render a results section: provenance line plus the results table.\"\"\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    provenance = provenance if provenance is not None else build_provenance()",
[2026-10-04T17:54:56.492Z] [INFO]           "-    return f\"{provenance}\\n\\n{format_results_table(results, **table_options)}\"",
[2026-10-04T17:54:56.492Z] [INFO]           "+def section(reports, language_code, charts_link):",
[2026-10-04T17:54:56.492Z] [INFO]           "+    \"\"\"The Markdown results section in the category -> language -> bits -> size hierarchy.\"\"\"",
[2026-10-04T17:54:56.492Z] [INFO]           "+    text = TEXT[language_code]",
[2026-10-04T17:54:56.492Z] [INFO]           "+    lines = []",
[2026-10-04T17:54:56.492Z] [INFO]           "+    for category in CATEGORIES:",
[2026-10-04T17:54:56.492Z] [INFO]           "+        lines += [f\"## {text['category'][category]}\", \"\"]",
[2026-10-04T17:54:56.492Z] [INFO]           "+        for language in LANGUAGES:",
[2026-10-04T17:54:56.492Z] [INFO]           "+            lines += [f\"### {text['language'].format(language=language)}\", \"\"]",
[2026-10-04T17:54:56.492Z] [INFO]           "+            for bits in BITS:",
[2026-10-04T17:54:56.492Z] [INFO]           "+                lines += [f\"#### {text['bits'].format(bits=bits)}\", \"\"]",
[2026-10-04T17:54:56.492Z] [INFO]           "+                sizes = sorted(key[3] for key in reports if key[:3] == (category, language, bits))",
[2026-10-04T17:54:56.492Z] [INFO]           "+                if not sizes:",
[2026-10-04T17:54:56.492Z] [INFO]           "+                    lines += [text[\"missing\"], \"\"]",
[2026-10-04T17:54:56.492Z] [INFO]           "+                    continue",
[2026-10-04T17:54:56.492Z] [INFO]           "+                for count in sizes:",
[2026-10-04T17:54:56.492Z] [INFO]           "+                    report = reports[(category, language, bits, count)]",
[2026-10-04T17:54:56.492Z] [INFO]           "+                    lines += [",
[2026-10-04T17:54:56.492Z] [INFO]           "+                        f\"##### {text['size'][category].format(size=size(count))}\",",
[2026-10-04T17:54:56.492Z] [INFO]           "+                        \"\",",
[2026-10-04T17:54:56.492Z] [INFO]           "+                        provenance(report, text),",
[2026-10-04T17:54:56.492Z] [INFO]           "+                        \"\",",
[2026-10-04T17:54:56.492Z] [INFO]           "+                        table(report, text),",
[2026-10-04T17:54:56.492Z] [INFO]           "+                        \"\",",
[2026-10-04T17:54:56.492Z] [INFO]           "+                    ]",
[2026-10-04T17:54:56.492Z] [INFO]           "+                if charts_link is not None:",
[2026-10-04T17:54:56.492Z] [INFO]           "+                    name = chart_name(category, language, bits)",
[2026-10-04T17:54:56.492Z] [INFO]           "+                    title = text[\"chart\"].format(language=language, bits=bits, category=category)",
[2026-10-04T17:54:56.492Z] [INFO]           "+                    lines += [f\"![{title}]({charts_link}/{name})\", \"\"]",
[2026-10-04T17:54:56.492Z] [INFO]           "+    return \"\\n\".join(lines).rstrip() + \"\\n\"",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           "-def update_markers(path, section, start_marker, end_marker):",
[2026-10-04T17:54:56.492Z] [INFO]           "-    \"\"\"Replace a marked Markdown section and report whether it changed.\"\"\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    with open(path, \"r\", encoding=\"utf-8\") as handle:",
[2026-10-04T17:54:56.492Z] [INFO]           "-        document = handle.read()",
[2026-10-04T17:54:56.492Z] [INFO]           "+def replace_section(document, generated):",
[2026-10-04T17:54:56.492Z] [INFO]           "+    pattern = re.compile(re.escape(START_MARKER) + \".*?\" + re.escape(END_MARKER), re.DOTALL)",
[2026-10-04T17:54:56.492Z] [INFO]           "+    if not pattern.search(document):",
[2026-10-04T17:54:56.492Z] [INFO]           "+        raise ValueError(f\"{START_MARKER} ... {END_MARKER} markers are missing\")",
[2026-10-04T17:54:56.492Z] [INFO]           "+    return pattern.sub(lambda _: f\"{START_MARKER}\\n{generated}{END_MARKER}\", document)",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           "-    if start_marker not in document or end_marker not in document:",
[2026-10-04T17:54:56.492Z] [INFO]           "-        raise ValueError(f\"{path} does not contain the {start_marker} / {end_marker} markers\")",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           "-    pattern = re.compile(",
[2026-10-04T17:54:56.492Z] [INFO]           "-        re.escape(start_marker) + r\".*?\" + re.escape(end_marker),",
[2026-10-04T17:54:56.492Z] [INFO]           "-        re.DOTALL,",
[2026-10-04T17:54:56.492Z] [INFO]           "-    )",
[2026-10-04T17:54:56.492Z] [INFO]           "-    replacement = f\"{start_marker}\\n{section}\\n{end_marker}\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    updated = pattern.sub(lambda _match: replacement, document, count=1)",
[2026-10-04T17:54:56.492Z] [INFO]           "+def charts(reports, directory):",
[2026-10-04T17:54:56.492Z] [INFO]           "+    \"\"\"One logarithmic bar chart per category, language and bits, with a panel per size.\"\"\"",
[2026-10-04T17:54:56.492Z] [INFO]           "+    import matplotlib",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           "-    if updated == document:",
[2026-10-04T17:54:56.492Z] [INFO]           "-        return False",
[2026-10-04T17:54:56.492Z] [INFO]           "+    matplotlib.use(\"Agg\")",
[2026-10-04T17:54:56.492Z] [INFO]           "+    import matplotlib.pyplot as plt",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           "-    with open(path, \"w\", encoding=\"utf-8\") as handle:",
[2026-10-04T17:54:56.492Z] [INFO]           "-        handle.write(updated)",
[2026-10-04T17:54:56.492Z] [INFO]           "-    return True",
[2026-10-04T17:54:56.492Z] [INFO]           "+    directory.mkdir(parents=True, exist_ok=True)",
[2026-10-04T17:54:56.492Z] [INFO]           "+    written = []",
[2026-10-04T17:54:56.492Z] [INFO]           "+    for category in CATEGORIES:",
[2026-10-04T17:54:56.492Z] [INFO]           "+        operations = OPERATIONS[category]",
[2026-10-04T17:54:56.492Z] [INFO]           "+        labels = [TEXT[\"en\"][\"operations\"][operation] for operation in operations]",
[2026-10-04T17:54:56.492Z] [INFO]           "+        for language in LANGUAGES:",
[2026-10-04T17:54:56.492Z] [INFO]           "+            for bits in BITS:",
[2026-10-04T17:54:56.492Z] [INFO]           "+                sizes = sorted(key[3] for key in reports if key[:3] == (category, language, bits))",
[2026-10-04T17:54:56.492Z] [INFO]           "+                if not sizes:",
[2026-10-04T17:54:56.492Z] [INFO]           "+                    continue",
[2026-10-04T17:54:56.492Z] [INFO]           "+                figure, axes = plt.subplots(",
[2026-10-04T17:54:56.492Z] [INFO]           "+                    1, len(sizes), figsize=(6 * len(sizes), 5), squeeze=False, sharey=False",
[2026-10-04T17:54:56.492Z] [INFO]           "+                )",
[2026-10-04T17:54:56.492Z] [INFO]           "+                for axis, count in zip(axes[0], sizes):",
[2026-10-04T17:54:56.492Z] [INFO]           "+                    results = reports[(category, language, bits, count)][\"results\"]",
[2026-10-04T17:54:56.492Z] [INFO]           "+                    width = 0.8 / len(results)",
[2026-10-04T17:54:56.492Z] [INFO]           "+                    for index, result in enumerate(results):",
[2026-10-04T17:54:56.492Z] [INFO]           "+                        axis.bar(",
[2026-10-04T17:54:56.492Z] [INFO]           "+                            [position + index * width for position in range(len(operations))],",
[2026-10-04T17:54:56.492Z] [INFO]           "+                            [result[\"operations\"][operation][\"median_ns\"] for operation in operations],",
[2026-10-04T17:54:56.492Z] [INFO]           "+                            width,",
[2026-10-04T17:54:56.492Z] [INFO]           "+                            label=result[\"variant\"].replace(\"_\", \" \"),",
[2026-10-04T17:54:56.492Z] [INFO]           "+                            color=plt.get_cmap(\"tab10\")(index % 10),",
[2026-10-04T17:54:56.492Z] [INFO]           "+                        )",
[2026-10-04T17:54:56.492Z] [INFO]           "+                    axis.set_yscale(\"log\")",
[2026-10-04T17:54:56.492Z] [INFO]           "+                    axis.set_title(TEXT[\"en\"][\"size\"][category].format(size=size(count)))",
[2026-10-04T17:54:56.492Z] [INFO]           "+                    axis.set_ylabel(\"median ns per operation (log scale)\")",
[2026-10-04T17:54:56.492Z] [INFO]           "+                    axis.set_xticks([position + 0.4 - width / 2 for position in range(len(operations))])",
[2026-10-04T17:54:56.492Z] [INFO]           "+                    axis.set_xticklabels(labels, rotation=30, ha=\"right\")",
[2026-10-04T17:54:56.492Z] [INFO]           "+                    axis.grid(axis=\"y\", which=\"major\", alpha=0.3)",
[2026-10-04T17:54:56.492Z] [INFO]           "+                axes[0][0].legend(fontsize=\"small\")",
[2026-10-04T17:54:56.492Z] [INFO]           "+                figure.suptitle(TEXT[\"en\"][\"chart\"].format(language=language, bits=bits, category=category))",
[2026-10-04T17:54:56.492Z] [INFO]           "+                figure.tight_layout()",
[2026-10-04T17:54:56.492Z] [INFO]           "+                path = directory / chart_name(category, language, bits)",
[2026-10-04T17:54:56.492Z] [INFO]           "+                figure.savefig(path, dpi=80)",
[2026-10-04T17:54:56.492Z] [INFO]           "+                plt.close(figure)",
[2026-10-04T17:54:56.492Z] [INFO]           "+                written.append(path)",
[2026-10-04T17:54:56.492Z] [INFO]           "+    return written",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           "-def _series(results, variant, operations):",
[2026-10-04T17:54:56.492Z] [INFO]           "-    \"\"\"Measurements of one variant across all operations, 0 when missing.\"\"\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    return [results.get(op, {}).get(variant, 0) for op, _label in operations]",
[2026-10-04T17:54:56.492Z] [INFO]           "+def main(arguments=None):",
[2026-10-04T17:54:56.492Z] [INFO]           "+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])",
[2026-10-04T17:54:56.492Z] [INFO]           "+    parser.add_argument(\"results\", type=Path, help=\"directory with the JSON reports\")",
[2026-10-04T17:54:56.492Z] [INFO]           "+    parser.add_argument(\"--readme\", type=Path, action=\"append\", default=[], help=\"README to update in place\")",
[2026-10-04T17:54:56.492Z] [INFO]           "+    parser.add_argument(\"--charts\", type=Path, help=\"directory for the charts, relative to the READMEs\")",
[2026-10-04T17:54:56.492Z] [INFO]           "+    options = parser.parse_args(arguments)",
[2026-10-04T17:54:56.492Z] [INFO]           "+    reports = load(options.results)",
[2026-10-04T17:54:56.492Z] [INFO]           "+    if options.charts is not None:",
[2026-10-04T17:54:56.492Z] [INFO]           "+        charts(reports, options.charts)",
[2026-10-04T17:54:56.492Z] [INFO]           "+    for readme in options.readme:",
[2026-10-04T17:54:56.492Z] [INFO]           "+        language_code = \"ru\" if readme.name.endswith(\".ru.md\") else \"en\"",
[2026-10-04T17:54:56.492Z] [INFO]           "+        link = None if options.charts is None else options.charts.resolve().relative_to(readme.resolve().parent).as_posix()",
[2026-10-04T17:54:56.492Z] [INFO]           "+        document = readme.read_text(encoding=\"utf-8\")",
[2026-10-04T17:54:56.492Z] [INFO]           "+        readme.write_text(replace_section(document, section(reports, language_code, link)), encoding=\"utf-8\")",
[2026-10-04T17:54:56.492Z] [INFO]           "+    if not options.readme:",
[2026-10-04T17:54:56.492Z] [INFO]           "+        print(section(reports, \"en\", None))",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           " ",
[2026-10-04T17:54:56.492Z] [INFO]           "-def _ensure_min_visible(values, minimum):",
[2026-10-04T17:54:56.492Z] [INFO]           "-    \"\"\"Keep non-zero bars at least ``minimum`` wide so they stay visible.\"\"\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    return [max(value, minimum) if value > 0 else 0 for value in values]",
[2026-10-04T17:54:56.492Z] [INFO]           "-",
[2026-10-04T17:54:56.492Z] [INFO]           "-",
[2026-10-04T17:54:56.492Z] [INFO]           "-def _plot(results, path, title, log_scale, operations, variants):",
[2026-10-04T17:54:56.492Z] [INFO]           "-    positions = np.arange(len(operations))",
[2026-10-04T17:54:56.492Z] [INFO]           "-    width = 0.8 / len(variants)",
[2026-10-04T17:54:56.492Z] [INFO]           "-    figure, axes = plt.subplots(figsize=(12, 8))",
[2026-10-04T17:54:56.492Z] [INFO]           "-",
[2026-10-04T17:54:56.492Z] [INFO]           "-    series = {key: _series(results, key, operations) for key, _label, _color in variants}",
[2026-10-04T17:54:56.492Z] [INFO]           "-",
[2026-10-04T17:54:56.492Z] [INFO]           "-    if log_scale:",
[2026-10-04T17:54:56.492Z] [INFO]           "-        plotted = series",
[2026-10-04T17:54:56.492Z] [INFO]           "-    else:",
[2026-10-04T17:54:56.492Z] [INFO]           "-        # On a linear scale Doublets bars are invisible next to SQLite, so give",
[2026-10-04T17:54:56.492Z] [INFO]           "-        # every non-zero measurement a minimum visible width (~0.5% of the",
[2026-10-04T17:54:56.492Z] [INFO]           "-        # maximum), matching the sibling benchmark charts.",
[2026-10-04T17:54:56.492Z] [INFO]           "-        all_values = [value for values in series.values() for value in values]",
[2026-10-04T17:54:56.492Z] [INFO]           "-        max_value = max(all_values) if all_values else 1",
[2026-10-04T17:54:56.492Z] [INFO]           "-        minimum = max_value * 0.005",
[2026-10-04T17:54:56.492Z] [INFO]           "-        plotted = {key: _ensure_min_visible(values, minimum) for key, values in series.items()}",
[2026-10-04T17:54:56.492Z] [INFO]           "-",
[2026-10-04T17:54:56.492Z] [INFO]           "-    offset_base = (len(variants) - 1) / 2",
[2026-10-04T17:54:56.492Z] [INFO]           "-    for index, (key, label, color) in enumerate(variants):",
[2026-10-04T17:54:56.492Z] [INFO]           "-        offset = (index - offset_base) * width",
[2026-10-04T17:54:56.492Z] [INFO]           "-        axes.barh(positions + offset, plotted[key], width, label=label, color=color)",
[2026-10-04T17:54:56.492Z] [INFO]           "-",
[2026-10-04T17:54:56.492Z] [INFO]           "-    axes.set_xlabel(\"Time (ns) – log scale\" if log_scale else \"Time (ns)\")",
[2026-10-04T17:54:56.492Z] [INFO]           "-    axes.set_title(title)",
[2026-10-04T17:54:56.492Z] [INFO]           "-    axes.set_yticks(positions)",
[2026-10-04T17:54:56.492Z] [INFO]           "-    axes.set_yticklabels([label for _op, label in operations])",
[2026-10-04T17:54:56.492Z] [INFO]           "-    if log_scale:",
[2026-10-04T17:54:56.492Z] [INFO]           "-        axes.set_xscale(\"log\")",
[2026-10-04T17:54:56.492Z] [INFO]           "-    axes.legend()",
[2026-10-04T17:54:56.492Z] [INFO]           "-    figure.tight_layout()",
[2026-10-04T17:54:56.492Z] [INFO]           "-",
[2026-10-04T17:54:56.492Z] [INFO]           "-    directory = os.path.dirname(path)",
[2026-10-04T17:54:56.492Z] [INFO]           "-    if directory:",
[2026-10-04T17:54:56.492Z] [INFO]           "-        os.makedirs(directory, exist_ok=True)",
[2026-10-04T17:54:56.492Z] [INFO]           "-    figure.savefig(path)",
[2026-10-04T17:54:56.492Z] [INFO]           "-    plt.close(figure)",
[2026-10-04T17:54:56.492Z] [INFO]           "-    print(f\"Generated {path}\")",
[2026-10-04T17:54:56.492Z] [INFO]           "-",
[2026-10-04T17:54:56.492Z] [INFO]           "-",
[2026-10-04T17:54:56.492Z] [INFO]           "-def generate_charts(",
[2026-10-04T17:54:56.492Z] [INFO]           "-    results,",
[2026-10-04T17:54:56.492Z] [INFO]           "-    prefix,",
[2026-10-04T17:54:56.492Z] [INFO]           "-    title,",
[2026-10-04T17:54:56.492Z] [INFO]           "-    output_dir=\"\",",
[2026-10-04T17:54:56.492Z] [INFO]           "-    operations=OPERATIONS,",
[2026-10-04T17:54:56.492Z] [INFO]           "-    variants=VARIANTS,",
[2026-10-04T17:54:56.492Z] [INFO]           "-):",
[2026-10-04T17:54:56.492Z] [INFO]           "-    \"\"\"Generate linear/log charts and return their paths when available.\"\"\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    if not HAS_MATPLOTLIB:",
[2026-10-04T17:54:56.492Z] [INFO]           "-        return []",
[2026-10-04T17:54:56.492Z] [INFO]           "-",
[2026-10-04T17:54:56.492Z] [INFO]           "-    linear = os.path.join(output_dir, f\"{prefix}.png\") if output_dir else f\"{prefix}.png\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    logarithmic = (",
[2026-10-04T17:54:56.492Z] [INFO]           "-        os.path.join(output_dir, f\"{prefix}_log_scale.png\")",
[2026-10-04T17:54:56.492Z] [INFO]           "-        if output_dir",
[2026-10-04T17:54:56.492Z] [INFO]           "-        else f\"{prefix}_log_scale.png\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    )",
[2026-10-04T17:54:56.492Z] [INFO]           "-    _plot(results, linear, title, False, operations, variants)",
[2026-10-04T17:54:56.492Z] [INFO]           "-    _plot(results, logarithmic, title, True, operations, variants)",
[2026-10-04T17:54:56.492Z] [INFO]           "-    return [linear, logarithmic]",
[2026-10-04T17:54:56.492Z] [INFO]           "-",
[2026-10-04T17:54:56.492Z] [INFO]           "-",
[2026-10-04T17:54:56.492Z] [INFO]           "-def copy_charts(charts, docs_dir):",
[2026-10-04T17:54:56.492Z] [INFO]           "-    \"\"\"Copy generated charts into the documentation directory.\"\"\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    if not docs_dir:",
[2026-10-04T17:54:56.492Z] [INFO]           "-        return []",
[2026-10-04T17:54:56.492Z] [INFO]           "-    os.makedirs(docs_dir, exist_ok=True)",
[2026-10-04T17:54:56.492Z] [INFO]           "-    copied = []",
[2026-10-04T17:54:56.492Z] [INFO]           "-    for chart in charts:",
[2026-10-04T17:54:56.492Z] [INFO]           "-        if os.path.exists(chart):",
[2026-10-04T17:54:56.492Z] [INFO]           "-            destination = os.path.join(docs_dir, os.path.basename(chart))",
[2026-10-04T17:54:56.492Z] [INFO]           "-            shutil.copyfile(chart, destination)",
[2026-10-04T17:54:56.492Z] [INFO]           "-            copied.append(destination)",
[2026-10-04T17:54:56.492Z] [INFO]           "-            print(f\"Copied {chart} -> {destination}\")",
[2026-10-04T17:54:56.492Z] [INFO]           "-    return copied",
[2026-10-04T17:54:56.492Z] [INFO]           "-",
[2026-10-04T17:54:56.492Z] [INFO]           "-",
[2026-10-04T17:54:56.492Z] [INFO]           "-def report_input_excerpt(path, lines=20):",
[2026-10-04T17:54:56.492Z] [INFO]           "-    \"\"\"Describe the tail of ``path`` so an unparsable run can be diagnosed.\"\"\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-    if not os.path.exists(path):",
[2026-10-04T17:54:56.492Z] [INFO]           "-        return f\"{path} does not exist\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-",
[2026-10-04T17:54:56.492Z] [INFO]           "-    with open(path, \"r\", encoding=\"utf-8\") as handle:",
[2026-10-04T17:54:56.492Z] [INFO]           "-        content = handle.read()",
[2026-10-04T17:54:56.492Z] [INFO]           "-",
[2026-10-04T17:54:56.492Z] [INFO]           "-    if not content.strip():",
[2026-10-04T17:54:56.492Z] [INFO]           "-        return f\"{path} is empty\"",
[2026-10-04T17:54:56.492Z] [INFO]           "-",
[2026-10-04T17:54:56.492Z] [INFO]           "-    tail = content.splitlines()[-lines:]",
[2026-10-04T17:54:56.492Z] [INFO]           "-    return \"\\n\".join([f\"Last {len(tail)} line(s) of {path}:\", *tail])",
[2026-10-04T17:54:56.492Z] [INFO]           "+if __name__ == \"__main__\":",
[2026-10-04T17:54:56.492Z] [INFO]           "+    main()"
[2026-10-04T17:54:56.492Z] [INFO]         ]
[2026-10-04T17:54:56.492Z] [INFO]       }
