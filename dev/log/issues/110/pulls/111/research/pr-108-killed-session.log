ps) in scenarios {\n        let result = std::panic::catch_unwind(|| match kind.as_str() {\n            \"unit\" => run(unit::Store::<u32, _>::new(Global::new()).unwrap(), &steps),\n            _ => run(split::Store::<u32, _, _>::new(Global::new(), Global::new()).unwrap(), &steps),\n        });\n        println!(\"{kind:5} {name:40} {}\", if result.is_ok() { \"ok\" } else { \"PANIC\" });\n    }\n}\nEOF\ncargo build --release -q 2>&1 | tail -3; ./target/release/split_store_delete unit; ./target/release/split_store_delete split",
      "description": "Run minimal split-store scenarios"
    }
  },
