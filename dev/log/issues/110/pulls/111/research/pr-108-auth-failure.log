[2026-10-04T17:13:51.453Z] [INFO]                 "+        {",
[2026-10-04T17:13:51.453Z] [INFO]                 "+            throw new InvalidOperationException(message);",
[2026-10-04T17:13:51.453Z] [INFO]                 "+        }",
[2026-10-04T17:13:51.453Z] [INFO]                 "+    }",
