[2026-10-05T01:06:59.684Z] [INFO]                 "+                let title = format!(\"Blog post {i}\");",
[2026-10-05T01:06:59.684Z] [INFO]                 "+                let id: i64 = match name {",
[2026-10-05T01:06:59.684Z] [INFO]                 "+                    \"execute + last_insert_rowid\" => {",
[2026-10-05T01:06:59.684Z] [INFO]                 "+                        statement.execute((&title, &content)).unwrap();",
[2026-10-05T01:06:59.684Z] [INFO]                 "+                        connection.last_insert_rowid()",
[2026-10-05T01:06:59.684Z] [INFO]                 "+                    }",
[2026-10-05T01:06:59.684Z] [INFO]                 "+                    \"query_row RETURNING id\" => statement.query_row((&title, &content), |row| row.get(0)).unwrap(),",
[2026-10-05T01:06:59.684Z] [INFO]                 "+                    _ => {",
[2026-10-05T01:06:59.684Z] [INFO]                 "+                        let mut rows = statement.query((&title, &content)).unwrap();",
[2026-10-05T01:06:59.684Z] [INFO]                 "+                        let id = rows.next().unwrap().unwrap().get(0).unwrap();",
[2026-10-05T01:06:59.684Z] [INFO]                 "+                        assert!(rows.next().unwrap().is_none());",
[2026-10-05T01:06:59.684Z] [INFO]                 "+                        id",
[2026-10-05T01:06:59.684Z] [INFO]                 "+                    }",
[2026-10-05T01:06:59.684Z] [INFO]                 "+                };",
[2026-10-05T01:06:59.684Z] [INFO]                 "+                assert_eq!(id, i);",
[2026-10-05T01:06:59.684Z] [INFO]                 "+            }",
[2026-10-05T01:06:59.684Z] [INFO]                 "+            println!(\"{name}: {:.0} ns/insert\", start.elapsed().as_nanos() as f64 / N as f64);",
[2026-10-05T01:06:59.684Z] [INFO]                 "+        }",
[2026-10-05T01:06:59.684Z] [INFO]                 "+    }",
[2026-10-05T01:06:59.684Z] [INFO]                 "+}"
[2026-10-05T01:06:59.684Z] [INFO]               ]
[2026-10-05T01:06:59.684Z] [INFO]             }
