[2026-10-05T00:28:10.141Z] [INFO]         "content": "     1\tuse doublets::{\n     2\t    Doublets,\n     3\t    data::{Flow, LinkReference},\n     4\t};\n     5\tuse rusqlite::{Connection, OptionalExtension, params};\n     6\tuse std::{marker::PhantomData, path::Path};\n     7\t\n     8\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n     9\tpub struct Link<T> {\n    10\t    pub id: T,\n    11\t    pub from: T,\n    12\t    pub to: T,\n    13\t}\n    14\t\n    15\tpub trait LinksStorage<T> {\n    16\t    fn create(&mut self, from: T, to: T) -> T;\n    17\t    fn update(&mut self, id: T, from: T, to: T);\n    18\t    fn delete(&mut self, id: T);\n    19\t    fn get(&self, id: T) -> Option<Link<T>>;\n    20\t    fn search(&self, from: T, to: T) -> Option<T>;\n    21\t    fn each(&self, visit: impl FnMut(Link<T>));\n    22\t    fn each_with_from(&self, from: T, visit: impl FnMut(Link<T>));\n    23\t    fn each_with_to(&self, to: T, visit: impl FnMut(Link<T>));\n    24\t    fn count(&self) -> u64;\n    25\t\n    26\t    fn transaction<R>(&mut self, work: impl FnOnce(&mut Self) -> R) -> R {\n    27\t        work(self)\n    28\t    }\n    29\t}\n    30\t\n    31\tpub struct SqliteLinks<T> {\n    32\t    connection: Connection,\n    33\t    id_type: PhantomData<T>,\n    34\t}\n    35\t\n    36\timpl<T: LinkReference> SqliteLinks<T> {\n    37\t    pub fn open(path: impl AsRef<Path>) -> Self {\n    38\t        Self::new(Connection::open(path).unwrap())\n    39\t    }\n    40\t\n    41\t    pub fn in_memory() -> Self {\n    42\t        Self::new(Connection::open_in_memory().unwrap())\n    43\t    }\n    44\t\n    45\t    fn new(connection: Connection) -> Self {\n    46\t        connection\n    47\t            .execute_batch(\n    48\t                r#\"\n    49\t                CREATE TABLE links (id INTEGER PRIMARY KEY, \"from\" INTEGER NOT NULL, \"to\" INTEGER NOT NULL);\n    50\t                CREATE INDEX links_from_to ON links (\"from\", \"to\");\n    51\t                CREATE INDEX links_to_from ON links (\"to\", \"from\");\n    52\t                \"#,\n    53\t            )\n    54\t            .unwrap();\n    55\t        Self {\n    56\t            connection,\n    57\t            id_type: PhantomData,\n    58\t        }\n    59\t    }\n    60\t\n    61\t    fn each_where(\n    62\t        &self,\n    63\t        sql: &str,\n    64\t        parameters: impl rusqlite::Params,\n    65\t        mut visit: impl FnMut(Link<T>),\n    66\t    ) {\n    67\t        let mut statement = self.connection.prepare_cached(sql).unwrap();\n    68\t        let mut rows = statement.query(parameters).unwrap();\n    69\t        while let Some(row) = rows.next().unwrap() {\n    70\t            visit(Link {\n    71\t                id: id(row.get(0).unwrap()),\n    72\t                from: id(row.get(1).unwrap()),\n    73\t                to: id(row.get(2).unwrap()),\n    74\t            });\n    75\t        }\n    76\t    }\n    77\t}\n    78\t\n    79\tfn sql<T: LinkReference>(id: T) -> i64 {\n    80\t    id.try_into().unwrap()\n    81\t}\n    82\t\n    83\tfn id<T: LinkReference>(sql: i64) -> T {\n    84\t    T::try_from(sql).unwrap()\n    85\t}\n    86\t\n    87\timpl<T: LinkReference> LinksStorage<T> for SqliteLinks<T> {\n    88\t    fn create(&mut self, from: T, to: T) -> T {\n    89\t        let mut statement = self\n    90\t            .connection\n    91\t            .prepare_cached(r#\"INSERT INTO links (\"from\", \"to\") VALUES (?1, ?2)\"#)\n    92\t            .unwrap();\n    93\t        statement.execute(params![sql(from), sql(to)]).unwrap();\n    94\t        id(self.connection.last_insert_rowid())\n    95\t    }\n    96\t\n    97\t    fn update(&mut self, link: T, from: T, to: T) {\n    98\t        let mut statement = self\n    99\t            .connection\n   100\t            .prepare_cached(r#\"UPDATE links SET \"from\" = ?2, \"to\" = ?3 WHERE id = ?1\"#)\n   101\t            .unwrap();\n   102\t        statement\n   103\t            .execute(params![sql(link), sql(from), sql(to)])\n   104\t            .unwrap();\n   105\t    }\n   106\t\n   107\t    fn delete(&mut self, link: T) {\n   108\t        let mut statement = self\n   109\t            .connection\n   110\t            .prepare_cached(\"DELETE FROM links WHERE id = ?1\")\n   111\t            .unwrap();\n   112\t        statement.execute([sql(link)]).unwrap();\n   113\t    }\n   114\t\n   115\t    fn get(&self, link: T) -> Option<Link<T>> {\n   116\t        let mut statement = self\n   117\t            .connection\n   118\t            .prepare_cached(r#\"SELECT \"from\", \"to\" FROM links WHERE id = ?1\"#)\n   119\t            .unwrap();\n   120\t        statement\n   121\t            .query_row([sql(link)], |row| {\n   122\t                Ok(Link {\n   123\t                    id: link,\n   124\t                    from: id(row.get(0)?),\n   125\t                    to: id(row.get(1)?),\n   126\t                })\n   127\t            })\n   128\t            .optional()\n   129\t            .unwrap()\n   130\t    }\n   131\t\n   132\t    fn search(&self, from: T, to: T) -> Option<T> {\n   133\t        let mut statement = self\n   134\t            .connection\n   135\t            .prepare_cached(r#\"SELECT id FROM links WHERE \"from\" = ?1 AND \"to\" = ?2\"#)\n   136\t            .unwrap();\n   137\t        statement\n   138\t            .query_row([sql(from), sql(to)], |row| row.get(0).map(id))\n   139\t            .optional()\n   140\t            .unwrap()\n   141\t    }\n   142\t\n   143\t    fn each(&self, visit: impl FnMut(Link<T>)) {\n   144\t        self.each_where(r#\"SELECT id, \"from\", \"to\" FROM links\"#, [], visit);\n   145\t    }\n   146\t\n   147\t    fn each_with_from(&self, from: T, visit: impl FnMut(Link<T>)) {\n   148\t        self.each_where(\n   149\t            r#\"SELECT id, \"from\", \"to\" FROM links WHERE \"from\" = ?1\"#,\n   150\t            [sql(from)],\n   151\t            visit,\n   152\t        );\n   153\t    }\n   154\t\n   155\t    fn each_with_to(&self, to: T, visit: impl FnMut(Link<T>)) {\n   156\t        self.each_where(\n   157\t            r#\"SELECT id, \"from\", \"to\" FROM links WHERE \"to\" = ?1\"#,\n   158\t            [sql(to)],\n   159\t            visit,\n   160\t        );\n   161\t    }\n   162\t\n   163\t    fn count(&self) -> u64 {\n   164\t        self.connection\n   165\t            .query_row(\"SELECT COUNT(*) FROM links\", [], |row| row.get(0))\n   166\t            .unwrap()\n   167\t    }\n   168\t\n   169\t    fn transaction<R>(&mut self, work: impl FnOnce(&mut Self) -> R) -> R {\n   170\t        self.connection.execute_batch(\"BEGIN\").unwrap();\n   171\t        let result = work(self);\n   172\t        self.connection.execute_batch(\"COMMIT\").unwrap();\n   173\t        result\n   174\t    }\n   175\t}\n   176\t\n   177\tfn link<T: LinkReference>(link: doublets::Link<T>) -> Link<T> {\n   178\t    Link {\n   179\t        id: link.index,\n   180\t        from: link.source,\n   181\t        to: link.target,\n   182\t    }\n   183\t}\n   184\t\n   185\tpub struct DoubletsLinks<T, D> {\n   186\t    store: D,\n   187\t    id_type: PhantomData<T>,\n   188\t}\n   189\t\n   190\timpl<T: LinkReference, D: Doublets<T>> DoubletsLinks<T, D> {\n   191\t    pub fn new(store: D) -> Self {\n   192\t        Self {\n   193\t            store,\n   194\t            id_type: PhantomData,\n   195\t        }\n   196\t    }\n   197\t}\n   198\t\n   199\timpl<T: LinkReference, D: Doublets<T>> LinksStorage<T> for DoubletsLinks<T, D> {\n   200\t    fn create(&mut self, from: T, to: T) -> T {\n   201\t        self.store.create_link(from, to).unwrap()\n   202\t    }\n   203\t\n   204\t    fn update(&mut self, id: T, from: T, to: T) {\n   205\t        // doublets 0.5.0 split stores lose a link updated to reference itself unless it starts\n   206\t        // from the empty state `create_link` uses, see experiments/split_store_delete\n   207\t        if from == id || to == id {\n   208\t            self.store\n   209\t                .update(id, T::from_byte(0), T::from_byte(0))\n   210\t                .unwrap();\n   211\t        }\n   212\t        self.store.update(id, from, to).unwrap();\n   213\t    }\n   214\t\n   215\t    fn delete(&mut self, id: T) {\n   216\t        self.store.delete(id).unwrap();\n   217\t    }\n   218\t\n   219\t    fn get(&self, id: T) -> Option<Link<T>> {\n   220\t        self.store.get_link(id).map(link)\n   221\t    }\n   222\t\n   223\t    fn search(&self, from: T, to: T) -> Option<T> {\n   224\t        self.store.search(from, to)\n   225\t    }\n   226\t\n   227\t    fn each(&self, mut visit: impl FnMut(Link<T>)) {\n   228\t        self.store.each(|found| {\n   229\t            visit(link(found));\n   230\t            Flow::Continue\n   231\t        });\n   232\t    }\n   233\t\n   234\t    fn each_with_from(&self, from: T, mut visit: impl FnMut(Link<T>)) {\n   235\t        let any = self.store.constants().any;\n   236\t        self.store.each_by([any, from, any], |found| {\n   237\t            visit(link(found));\n   238\t            Flow::Continue\n   239\t        });\n   240\t    }\n   241\t\n   242\t    fn each_with_to(&self, to: T, mut visit: impl FnMut(Link<T>)) {\n   243\t        let any = self.store.constants().any;\n   244\t        self.store.each_by([any, any, to], |found| {\n   245\t            visit(link(found));\n   246\t            Flow::Continue\n   247\t        });\n   248\t    }\n   249\t\n   250\t    fn count(&self) -> u64 {\n   251\t        self.store.count().try_into().unwrap()\n   252\t    }\n   253\t}\n   254\tusing System.Numerics;\n   255\tusing Microsoft.Data.Sqlite;\n   256\tusing Platform.Data;\n   257\tusing Platform.Data.Doublets;\n   258\t\n   259\tnamespace Comparisons.SQLiteVSDoublets;\n   260\t\n   261\tpublic readonly record struct Link<T>(T Id, T From, T To);\n   262\t\n   263\tpublic interface ILinksStorage<T> : IDisposable where T : struct\n   264\t{\n   265\t    T Create(T from, T to);\n   266\t    void Update(T id, T from, T to);\n   267\t    void Delete(T id);\n   268\t    Link<T>? Get(T id);\n   269\t    T? Search(T from, T to);\n   270\t    void Each(Action<Link<T>> visit);\n   271\t    void EachWithFrom(T from, Action<Link<T>> visit);\n   272\t    void EachWithTo(T to, Action<Link<T>> visit);\n   273\t    ulong Count();\n   274\t\n   275\t    TResult Transaction<TResult>(Func<TResult> work) => work();\n   276\t}\n   277\t\n   278\tpublic sealed class SQLiteLinks<T> : SQLiteStorage, ILinksStorage<T> where T : struct, IBinaryInteger<T>\n   279\t{\n   280\t    private static readonly (string, SqliteType) IdParameter = (\"$id\", SqliteType.Integer);\n   281\t    private static readonly (string, SqliteType) FromParameter = (\"$from\", SqliteType.Integer);\n   282\t    private static readonly (string, SqliteType) ToParameter = (\"$to\", SqliteType.Integer);\n   283\t\n   284\t    private readonly SqliteCommand _create;\n   285\t    private readonly SqliteCommand _update;\n   286\t    private readonly SqliteCommand _delete;\n   287\t    private readonly SqliteCommand _get;\n   288\t    private readonly SqliteCommand _search;\n   289\t    private readonly SqliteCommand _each;\n   290\t    private readonly SqliteCommand _eachWithFrom;\n   291\t    private readonly SqliteCommand _eachWithTo;\n   292\t\n   293\t    public static SQLiteLinks<T> Open(string path) => new(path);\n   294\t\n   295\t    public static SQLiteLinks<T> InMemory() => new(\":memory:\");\n   296\t\n   297\t    private SQLiteLinks(string path) : base(path, \"links\", \"\"\"\n   298\t        CREATE TABLE links (id INTEGER PRIMARY KEY, \"from\" INTEGER NOT NULL, \"to\" INTEGER NOT NULL);\n   299\t        CREATE INDEX links_from_to ON links (\"from\", \"to\");\n   300\t        CREATE INDEX links_to_from ON links (\"to\", \"from\");\n   301\t        \"\"\")\n   302\t    {\n   303\t        _create = Command(\"\"\"INSERT INTO links (\"from\", \"to\") VALUES ($from, $to) RETURNING id\"\"\", FromParameter, ToParameter);\n   304\t        _update = Command(\"\"\"UPDATE links SET \"from\" = $from, \"to\" = $to WHERE id = $id\"\"\", IdParameter, FromParameter, ToParameter);\n   305\t        _delete = Command(\"DELETE FROM links WHERE id = $id\", IdParameter);\n   306\t        _get = Command(\"\"\"SELECT \"from\", \"to\" FROM links WHERE id = $id\"\"\", IdParameter);\n   307\t        _search = Command(\"\"\"SELECT id FROM links WHERE \"from\" = $from AND \"to\" = $to\"\"\", FromParameter, ToParameter);\n   308\t        _each = Command(\"\"\"SELECT id, \"from\", \"to\" FROM links\"\"\");\n   309\t        _eachWithFrom = Command(\"\"\"SELECT id, \"from\", \"to\" FROM links WHERE \"from\" = $from\"\"\", FromParameter);\n   310\t        _eachWithTo = Command(\"\"\"SELECT id, \"from\", \"to\" FROM links WHERE \"to\" = $to\"\"\", ToParameter);\n   311\t    }\n   312\t\n   313\t    private static T Id(long sql) => T.CreateChecked(sql);\n   314\t\n   315\t    private static SqliteCommand With(SqliteCommand command, params ReadOnlySpan<T> values)\n   316\t    {\n   317\t        for (var i = 0; i < values.Length; i++)\n   318\t        {\n   319\t            command.Parameters[i].Value = long.CreateChecked(values[i]);\n   320\t        }\n   321\t        return command;\n   322\t    }\n   323\t\n   324\t    public T Create(T from, T to) => Id((long)With(_create, from, to).ExecuteScalar()!);\n   325\t\n   326\t    public void Update(T id, T from, T to) => With(_update, id, from, to).ExecuteNonQuery();\n   327\t\n   328\t    public void Delete(T id) => With(_delete, id).ExecuteNonQuery();\n   329\t\n   330\t    public Link<T>? Get(T id)\n   331\t    {\n   332\t        using var reader = With(_get, id).ExecuteReader();\n   333\t        return reader.Read() ? new Link<T>(id, Id(reader.GetInt64(0)), Id(reader.GetInt64(1))) : null;\n   334\t    }\n   335\t\n   336\t    public T? Search(T from, T to) => With(_search, from, to).ExecuteScalar() is long id ? Id(id) : null;\n   337\t\n   338\t    public void Each(Action<Link<T>> visit) => Read(_each, visit);\n   339\t\n   340\t    public void EachWithFrom(T from, Action<Link<T>> visit) => Read(With(_eachWithFrom, from), visit);\n   341\t\n   342\t    public void EachWithTo(T to, Action<Link<T>> visit) => Read(With(_eachWithTo, to), visit);\n   343\t\n   344\t    private static void Read(SqliteCommand command, Action<Link<T>> visit)\n   345\t    {\n   346\t        using var reader = command.ExecuteReader();\n   347\t        while (reader.Read())\n   348\t        {\n   349\t            visit(new Link<T>(Id(reader.GetInt64(0)), Id(reader.GetInt64(1)), Id(reader.GetInt64(2))));\n   350\t        }\n   351\t    }\n   352\t}\n   353\t\n   354\tpublic sealed class DoubletsLinks<T>(ILinks<T> links) : ILinksStorage<T>\n   355\t    where T : struct, IUnsignedNumber<T>, IComparisonOperators<T, T, bool>\n   356\t{\n   357\t    private readonly T _any = links.Constants.Any;\n   358\t    private readonly T _continue = links.Constants.Continue;\n   359\t\n   360\t    public T Create(T from, T to) => links.CreateAndUpdate(from, to);\n   361\t\n   362\t    public void Update(T id, T from, T to) => links.Update(id, from, to);\n   363\t\n   364\t    public void Delete(T id) => links.Delete(id, handler: null);\n   365\t\n   366\t    public Link<T>? Get(T id) => links.Exists(id) ? Link(links.GetLink(id)!) : null;\n   367\t\n   368\t    public T? Search(T from, T to) => links.SearchOrDefault(from, to) is var id && id != T.Zero ? id : null;\n   369\t\n   370\t    public void Each(Action<Link<T>> visit) => Each(visit, _any, _any, _any);\n   371\t\n   372\t    public void EachWithFrom(T from, Action<Link<T>> visit) => Each(visit, _any, from, _any);\n   373\t\n   374\t    public void EachWithTo(T to, Action<Link<T>> visit) => Each(visit, _any, _any, to);\n   375\t\n   376\t    private void Each(Action<Link<T>> visit, params T[] query) => links.Each(link =>\n   377\t    {\n   378\t        visit(Link(link!));\n   379\t        return _continue;\n   380\t    }, query);\n   381\t\n   382\t    private static Link<T> Link(IList<T> link) => new(link[0], link[1], link[2]);\n   383\t\n   384\t    public ulong Count() => ulong.CreateChecked(links.Count());\n   385\t\n   386\t    public void Dispose() => (links as IDisposable)?.Dispose();\n   387\t}\n   388\t//! Usage: sqlite-vs-doublets <links|objects> <32|64> <size> [--work N | --repetitions N]\n   389\t//!        [--variants A,B] [--directory DIR] [--output FILE]\n   390\t//!\n   391\t//! Repetitions default to `work / size` clamped to `1..=MAX_REPETITIONS`, so smaller sizes get more,\n   392\t//! but not endless, repetitions. Objects get less work, because one blog post takes hundreds of links.\n   393\t\n   394\tuse doublets::data::LinkReference;\n   395\tuse serde_json::json;\n   396\tuse sqlite_vs_doublets::harness::{self, LINKS_VARIANTS, Measurement, OBJECTS_VARIANTS};\n   397\tuse std::{collections::HashMap, env, fs, path::Path};\n   398\t\n   399\tconst LINKS_WORK: u64 = 3_000_000;\n   400\tconst OBJECTS_WORK: u64 = 500_000;\n   401\tconst MAX_REPETITIONS: u64 = 10;\n   402\t\n   403\tfn main() {\n   404\t    let arguments: Vec<String> = env::args().skip(1).collect();\n   405\t    let [category, bits, size] = [0, 1, 2].map(|index| {\n   406\t        arguments\n   407\t            .get(index)\n   408\t            .expect(\"missing positional argument\")\n   409\t            .as_str()\n   410\t    });\n   411\t    let options: HashMap<&str, &str> = arguments[3..]\n   412\t        .chunks(2)\n   413\t        .map(|pair| (pair[0].trim_start_matches(\"--\"), pair[1].as_str()))\n   414\t        .collect();\n   415\t    let size: u64 = size.replace('_', \"\").parse().unwrap();\n   416\t    let default_work = if category == \"links\" {\n   417\t        LINKS_WORK\n   418\t    } else {\n   419\t        OBJECTS_WORK\n   420\t    };\n   421\t    let work: u64 = options\n   422\t        .get(\"work\")\n   423\t        .map_or(default_work, |work| work.replace('_', \"\").parse().unwrap());\n   424\t    let repetitions: usize = options\n   425\t        .get(\"repetitions\")\n   426\t        .map_or((work / size).clamp(1, MAX_REPETITIONS) as usize, |count| {\n   427\t            count.parse().unwrap()\n   428\t        });\n   429\t    let all_variants: &[&'static str] = if category == \"links\" {\n   430\t        &LINKS_VARIANTS\n   431\t    } else {\n   432\t        &OBJECTS_VARIANTS\n   433\t    };\n   434\t    let variants: Vec<&'static str> = match options.get(\"variants\") {\n   435\t        Some(names) => names\n   436\t            .split(',')\n   437\t            .map(|name| {\n   438\t                *all_variants\n   439\t                    .iter()\n   440\t                    .find(|known| **known == name)\n   441\t                    .expect(name)\n   442\t            })\n   443\t            .collect(),\n   444\t        None => all_variants.to_vec(),\n   445\t    };\n   446\t    let directory = options\n   447\t        .get(\"directory\")\n   448\t        .map_or_else(env::temp_dir, |directory| directory.into());\n   449\t\n   450\t    let measurements: Vec<Measurement> = match bits {\n   451\t        \"32\" => measure::<u32>(category, &variants, size, repetitions, &directory),\n   452\t        \"64\" => measure::<u64>(category, &variants, size, repetitions, &directory),\n   453\t        _ => panic!(\"bits must be 32 or 64\"),\n   454\t    };\n   455\t    let report = json!({\n   456\t        \"language\": \"Rust\",\n   457\t        \"category\": category,\n   458\t        \"bits\": bits.parse::<u32>().unwrap(),\n   459\t        \"size\": size,\n   460\t        \"repetitions\": repetitions,\n   461\t        \"warm_up_size\": size.min(harness::WARM_UP_SIZE),\n   462\t        \"sqlite_version\": rusqlite::version(),\n   463\t        \"results\": measurements.iter().map(Measurement::to_json).collect::<Vec<_>>(),\n   464\t    });\n   465\t    let report = serde_json::to_string_pretty(&report).unwrap();\n   466\t    match options.get(\"output\") {\n   467\t        Some(path) => fs::write(path, report).unwrap(),\n   468\t        None => println!(\"{report}\"),\n   469\t    }\n   470\t}\n   471\t\n   472\tfn measure<T: LinkReference>(\n   473\t    category: &str,\n   474\t    variants: &[&'static str],\n   475\t    size: u64,\n   476\t    repetitions: usize,\n   477\t    directory: &Path,\n   478\t) -> Vec<Measurement> {\n   479\t    variants\n   480\t        .iter()\n   481\t        .map(|variant| match category {\n   482\t            \"links\" => harness::measure_links::<T>(variant, size, repetitions, directory),\n   483\t            \"objects\" => harness::measure_objects::<T>(variant, size, repetitions, directory),\n   484\t            _ => panic!(\"category must be links or objects\"),\n   485\t        })\n   486\t        .collect()\n   487\t}\n   488\t//! Works around a `doublets` 0.5.0 and `platform-mem` 0.3.0 mismatch: stores take the slice returned by\n   489\t//! `RawMem::grow` for their whole memory, but the memories return only the grown part. A fresh store then\n   490\t//! sees 2^20 − 8,192 = 1,040,384 links of its 2^20 and panics with \"index out of bounds\" when it creates\n   491\t//! more, and any later growth would leave it with an empty memory. [`Whole`] returns the whole memory.\n   492\t\n   493\tuse doublets::mem::{FileMapped, Global, RawMem, Result};\n   494\tuse std::{mem::MaybeUninit, path::Path};\n   495\t\n   496\tpub struct Whole<M>(pub M);\n   497\t\n   498\timpl<M: RawMem> RawMem for Whole<M> {\n   499\t    type Item = M::Item;\n   500\t\n   501\t    fn allocated(&self) -> &[Self::Item] {\n   502\t        self.0.allocated()\n   503\t    }\n   504\t\n   505\t    fn allocated_mut(&mut self) -> &mut [Self::Item] {\n   506\t        self.0.allocated_mut()\n   507\t    }\n   508\t\n   509\t    unsafe fn grow(\n   510\t        &mut self,\n   511\t        addition: usize,\n   512\t        fill: impl FnOnce(usize, (&mut [Self::Item], &mut [MaybeUninit<Self::Item>])),\n   513\t    ) -> Result<&mut [Self::Item]> {\n   514\t        // SAFETY: the caller's contract is passed on unchanged.\n   515\t        unsafe { self.0.grow(addition, fill)? };\n   516\t        Ok(self.0.allocated_mut())\n   517\t    }\n   518\t\n   519\t    fn shrink(&mut self, cap: usize) -> Result<()> {\n   520\t        self.0.shrink(cap)\n   521\t    }\n   522\t\n   523\t    fn size_hint(&self) -> Option<usize> {\n   524\t        self.0.size_hint()\n   525\t    }\n   526\t}\n   527\t\n   528\t/// Memory of the volatile stores.\n   529\tpub fn volatile<T>() -> Whole<Global<T>> {\n   530\t    Whole(Global::new())\n   531\t}\n   532\t\n   533\t/// Memory of the non-volatile stores, mapped from `path`.\n   534\tpub fn mapped<T>(path: impl AsRef<Path>) -> Whole<FileMapped<T>> {\n   535\t    Whole(FileMapped::from_path(path).unwrap())\n   536\t}\n   537\t\n   538\t#[cfg(test)]\n   539\tmod tests {\n   540\t    use super::*;\n   541\t\n   542\t    #[test]\n   543\t    fn grow_returns_the_whole_memory() {\n   544\t        let mut memory = Global::<u64>::new();\n   545\t        memory.grow_filled(2, 1).unwrap();\n   546\t        assert_eq!(memory.grow_filled(3, 2).unwrap(), [2, 2, 2]);\n   547\t        let mut memory = volatile::<u64>();\n   548\t        memory.grow_filled(2, 1).unwrap();\n   549\t        assert_eq!(memory.grow_filled(3, 2).unwrap(), [1, 1, 2, 2, 2]);\n   550\t    }\n   551\t}",
