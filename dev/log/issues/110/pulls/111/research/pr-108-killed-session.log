              "lines": [
                "-// Shows which links match (any, post_property, any) when a blog post is deleted from a Doublets store.",
                "-using Comparisons.SQLiteVSDoublets;",
                "-using Platform.Data;",
                "-using Platform.Data.Doublets;",
                "-using Platform.Data.Doublets.Memory.United.Generic;",
                "-using Platform.Memory;",
                "-",
                "-var links = new UnitedMemoryLinks<ulong>(new HeapResizableDirectMemory());",
                "-var posts = new DoubletsBlogPosts<ulong>(links, cacheSequences: args.Contains(\"--cached\"));",
                "-var ids = Enumerable.Range(1, 3).Select(i => posts.Create(Dataset.BlogPost((ulong)i))).ToList();",
                "-var any = links.Constants.Any;",
                "-foreach (var id in ids)",
                "-{",
                "-    for (ulong property = 4; property <= 6; property++)",
                "-    {",
                "-        var objectProperty = links.SearchOrDefault(id, property);",
                "-        var matches = new List<string>();",
                "-        links.Each(link => { matches.Add($\"({link![0]}: {link[1]} {link[2]})\"); return links.Constants.Continue; }, any, objectProperty, any);",
                "-        Console.WriteLine($\"post {id} property {property}: ({id}, {property}) = {objectProperty}, values {string.Join(\" \", matches)}\");",
                "-        var calls = new List<string>();",
                "-        links.Each(new Platform.Data.Doublets.Link<ulong>(any, objectProperty, any), link => { calls.Add(link is null ? \"null\" : $\"({link[0]}: {link[1]} {link[2]})\"); return links.Constants.Continue; });",
                "-        var single = links.SingleOrDefault([any, objectProperty, any]);",
                "-        Console.WriteLine($\"  IList-query handler calls {string.Join(\" \", calls)}; SingleOrDefault {(single is null ? \"null\" : single[0])}\");",
                "-    }",
                "-}",
                "-foreach (var id in ids)",
                "-{",
                "-    Console.WriteLine($\"deleting {id}\");",
                "-    for (ulong property = 4; property <= 6; property++)",
                "-    {",
                "-        var objectProperty = links.SearchOrDefault(id, property);",
                "-        var value = links.SingleOrDefault([any, objectProperty, any]);",
                "-        Console.WriteLine($\"  ({id}, {property}) = {objectProperty}, value {(value is null ? \"null\" : value[0])}, count {links.Count()}\");",
                "-        if (value is null)",
                "-        {",
                "-            var found = new List<string>();",
                "-            links.Each(link => { found.Add($\"({link![0]}: {link[1]} {link[2]})\"); return links.Constants.Continue; }, any, id, any);",
