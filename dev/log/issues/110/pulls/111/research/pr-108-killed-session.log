        "content": "== Converters/BalancedVariantConverter.cs\n#pragma warning disable CS1591 // Missing XML comment for publicly visible type or member\nnamespace Platform.Data.Doublets.Sequences.Converters\n{\n    public class BalancedVariantConverter<TLinkAddress> : LinksListToSequenceConverterBase<TLinkAddress> where TLinkAddress : struct, IUnsignedNumber<TLinkAddress>, IComparisonOperators<TLinkAddress, TLinkAddress, bool>\n    {\n        public BalancedVariantConverter(ILinks<TLinkAddress> links) : base(links) { }\n        public override TLinkAddress Convert(IList<TLinkAddress>? sequence)\n        {\n            var length = sequence.Count;\n            if (length < 1)\n            {\n                return TLinkAddress.Zero;\n            }\n            if (length == 1)\n            {\n                return sequence[0];\n            }\n            // Make copy of next layer\n            if (length > 2)\n            {\n                // TODO: Try to use stackalloc (which at the moment is not working with generics) but will be possible with Sigil\n                var halvedSequence = new TLinkAddress[(length / 2) + (length % 2)];\n                HalveSequence(halvedSequence, sequence, length);\n                sequence = halvedSequence;\n                length = halvedSequence.Length;\n            }\n            // Keep creating layer after layer\n            while (length > 2)\n            {\n                HalveSequence(sequence, sequence, length);\n                length = (length / 2) + (length % 2);\n            }\n            return _links.GetOrCreate(sequence[0], sequence[1]);\n        }\n        private void HalveSequence(IList<TLinkAddress>? destination, IList<TLinkAddress>? source, int length)\n        {\n            var loopedLength = length - (length % 2);\n            for (var i = 0; i < loopedLength; i += 2)\n            {\n                destination[i / 2] = _links.GetOrCreate(source[i], source[i + 1]);\n            }\n            if (length > loopedLength)\n            {\n                destination[length / 2] = source[length - 1];\n            }\n        }\n    }\n}\n== Unicode/StringToUnicodeSequenceConverter.cs\n#pragma warning disable CS1591 // Missing XML comment for publicly visible type or member\nnamespace Platform.Data.Doublets.Sequences.Unicode\n{\n    public class StringToUnicodeSequenceConverter<TLinkAddress> : LinksOperatorBase<TLinkAddress>, IConverter<string, TLinkAddress> where TLinkAddress : struct, IUnsignedNumber<TLinkAddress>, IComparisonOperators<TLinkAddress, TLinkAddress, bool>\n    {\n        private readonly IConverter<string, IList<TLinkAddress>?> _stringToUnicodeSymbolListConverter;\n        private readonly IConverter<IList<TLinkAddress>, TLinkAddress> _unicodeSymbolListToSequenceConverter;\n        public StringToUnicodeSequenceConverter(ILinks<TLinkAddress> links, IConverter<string, IList<TLinkAddress>?> stringToUnicodeSymbolListConverter, IConverter<IList<TLinkAddress>, TLinkAddress> unicodeSymbolListToSequenceConverter) : base(links)\n        {\n            _stringToUnicodeSymbolListConverter = stringToUnicodeSymbolListConverter;\n            _unicodeSymbolListToSequenceConverter = unicodeSymbolListToSequenceConverter;\n        }\n        public StringToUnicodeSequenceConverter(ILinks<TLinkAddress> links, IConverter<string, IList<TLinkAddress>?> stringToUnicodeSymbolListConverter, ISequenceIndex<TLinkAddress> index, IConverter<IList<TLinkAddress>, TLinkAddress> listToSequenceLinkConverter, TLinkAddress unicodeSequenceMarker)\n            : this(links, stringToUnicodeSymbolListConverter, new UnicodeSymbolsListToUnicodeSequenceConverter<TLinkAddress>(links, index, listToSequenceLinkConverter, unicodeSequenceMarker)) { }\n        public StringToUnicodeSequenceConverter(ILinks<TLinkAddress> links, IConverter<char, TLinkAddress> charToUnicodeSymbolConverter, ISequenceIndex<TLinkAddress> index, IConverter<IList<TLinkAddress>, TLinkAddress> listToSequenceLinkConverter, TLinkAddress unicodeSequenceMarker)\n            : this(links, new StringToUnicodeSymbolsListConverter<TLinkAddress>(charToUnicodeSymbolConverter), index, listToSequenceLinkConverter, unicodeSequenceMarker) { }\n        public StringToUnicodeSequenceConverter(ILinks<TLinkAddress> links, IConverter<char, TLinkAddress> charToUnicodeSymbolConverter, IConverter<IList<TLinkAddress>, TLinkAddress> listToSequenceLinkConverter, TLinkAddress unicodeSequenceMarker)\n            : this(links, charToUnicodeSymbolConverter, new Unindex<TLinkAddress>(), listToSequenceLinkConverter, unicodeSequenceMarker) { }\n        public StringToUnicodeSequenceConverter(ILinks<TLinkAddress> links, IConverter<string, IList<TLinkAddress>?> stringToUnicodeSymbolListConverter, IConverter<IList<TLinkAddress>, TLinkAddress> listToSequenceLinkConverter, TLinkAddress unicodeSequenceMarker)\n            : this(links, stringToUnicodeSymbolListConverter, new Unindex<TLinkAddress>(), listToSequenceLinkConverter, unicodeSequenceMarker) { }\n        public TLinkAddress Convert(string source)\n        {\n            var elements = _stringToUnicodeSymbolListConverter.Convert(source);\n            return _unicodeSymbolListToSequenceConverter.Convert(elements);\n        }\n    }\n}\n== Unicode/UnicodeSequenceToStringConverter.cs\n#pragma warning disable CS1591 // Missing XML comment for publicly visible type or member\nnamespace Platform.Data.Doublets.Sequences.Unicode\n{\n    public class UnicodeSequenceToStringConverter<TLinkAddress> : LinksOperatorBase<TLinkAddress>, IConverter<TLinkAddress, string> where TLinkAddress : struct, IUnsignedNumber<TLinkAddress>, IComparisonOperators<TLinkAddress, TLinkAddress, bool>\n    {\n        private readonly ICriterionMatcher<TLinkAddress> _unicodeSequenceCriterionMatcher;\n        private readonly ISequenceWalker<TLinkAddress> _sequenceWalker;\n        private readonly IConverter<TLinkAddress, char> _unicodeSymbolToCharConverter;\n        private readonly TLinkAddress _unicodeSequenceMarker;\n        public UnicodeSequenceToStringConverter(ILinks<TLinkAddress> links, ICriterionMatcher<TLinkAddress> unicodeSequenceCriterionMatcher, ISequenceWalker<TLinkAddress> sequenceWalker, IConverter<TLinkAddress, char> unicodeSymbolToCharConverter, TLinkAddress unicodeSequenceMarker) : base(links)\n        {\n            _unicodeSequenceCriterionMatcher = unicodeSequenceCriterionMatcher;\n            _sequenceWalker = sequenceWalker;\n            _unicodeSymbolToCharConverter = unicodeSymbolToCharConverter;\n            _unicodeSequenceMarker = unicodeSequenceMarker;\n        }\n        public UnicodeSequenceToStringConverter(ILinks<TLinkAddress> links, ISequenceWalker<TLinkAddress> sequenceWalker, IConverter<TLinkAddress, char> unicodeSymbolToCharConverter, TLinkAddress unicodeSequenceMarker): this(links, new UnicodeSequenceMatcher<TLinkAddress>(links, unicodeSequenceMarker), sequenceWalker, unicodeSymbolToCharConverter, unicodeSequenceMarker){}\n        public string Convert(TLinkAddress source)\n        {\n            if (!_unicodeSequenceCriterionMatcher.IsMatched(source))\n            {\n                throw new ArgumentOutOfRangeException(nameof(source), source, \"Specified link is not a unicode sequence.\");\n            }\n            if((_unicodeSequenceMarker == source))\n            {\n                return String.Empty;\n            }\n            var sequence = _links.GetSource(source);\n            var sb = new StringBuilder();\n            foreach(var character in _sequenceWalker.Walk(sequence))\n            {\n                sb.Append(_unicodeSymbolToCharConverter.Convert(character));\n            }\n            return sb.ToString();\n        }\n    }\n}\n== Walkers/RightSequenceWalker.cs\n#pragma warning disable CS1591 // Missing XML comment for publicly visible type or member\nnamespace Platform.Data.Doublets.Sequences.Walkers\n{\n    public class RightSequenceWalker<TLinkAddress> : SequenceWalkerBase<TLinkAddress> where TLinkAdd