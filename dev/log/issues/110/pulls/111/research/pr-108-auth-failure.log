[2026-10-04T16:46:33.776Z] [INFO]                 "-            count,",
[2026-10-04T16:46:33.776Z] [INFO]                 "-            \"SQLite_File\",",
[2026-10-04T16:46:33.776Z] [INFO]                 "-            sqlite_vs_doublets::benched::SqliteFileBenched,",
[2026-10-04T16:46:33.776Z] [INFO]                 "-            $prepare,",
[2026-10-04T16:46:33.776Z] [INFO]                 "-            $operation",
