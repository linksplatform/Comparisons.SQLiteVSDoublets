[2026-10-04T16:29:11.398Z] [INFO]     "stdout": "using System.IO;\nusing System.Collections.Generic;\nusing Platform.IO;\nusing Platform.Diagnostics;\nusing Comparisons.SQLiteVSDoublets.Model;\n\nnamespace Comparisons.SQLiteVSDoublets\n{\n    /// <summary>\n    /// <para>\n    /// Represents the test run.\n    /// </para>\n    /// <para></para>\n    /// </summary>\n    public abstract class TestRun\n    {\n        /// <summary>\n        /// <para>\n        /// Gets the db filename value.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public string DbFilename { get; }\n        /// <summary>\n        /// <para>\n        /// Gets the results value.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public TestRunResults Results { get; }\n        /// <summary>\n        /// <para>\n        /// Gets the read blog posts value.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public List<BlogPost> ReadBlogPosts { get; }\n\n        /// <summary>\n        /// <para>\n        /// Initializes a new <see cref=\"TestRun\"/> instance.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        /// <param name=\"dbFilename\">\n        /// <para>A db filename.</para>\n        /// <para></para>\n        /// </param>\n        protected TestRun(string dbFilename)\n        {\n            DbFilename = dbFilename;\n            Results = new TestRunResults();\n            ReadBlogPosts = new List<BlogPost>();\n        }\n\n        /// <summary>\n        /// <para>\n        /// Runs this instance.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public void Run()\n        {\n            if (File.Exists(DbFilename))\n            {\n                DeleteDatabase();\n            }\n            Results.PrepareTime = Performance.Measure(Prepare);\n            Results.DbSizeAfterPrepare = GetDatabaseSizeInBytes();\n            Results.ListCreationTime = Performance.Measure(CreateList);\n            Results.DbSizeAfterCreation = GetDatabaseSizeInBytes();\n            Results.ListReadingTime = Performance.Measure(ReadList);\n            Results.DbSizeAfterReading = GetDatabaseSizeInBytes();\n            Results.ListDeletionTime = Performance.Measure(DeleteList);\n            Results.DbSizeAfterDeletion = GetDatabaseSizeInBytes();\n            DeleteDatabase();\n        }\n\n        /// <summary>\n        /// <para>\n        /// Gets the database size in bytes.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        /// <returns>\n        /// <para>The long</para>\n        /// <para></para>\n        /// </returns>\n        protected virtual long GetDatabaseSizeInBytes()\n        {\n            return FileHelpers.GetSize(DbFilename);\n        }\n\n        /// <summary>\n        /// <para>\n        /// Deletes the database.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        protected virtual void DeleteDatabase()\n        {\n            File.Delete(DbFilename);\n        }\n\n        /// <summary>\n        /// <para>\n        /// Prepares this instance.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public abstract void Prepare();\n\n        /// <summary>\n        /// <para>\n        /// Creates the list.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public abstract void CreateList();\n\n        /// <summary>\n        /// <para>\n        /// Reads the list.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public abstract void ReadList();\n\n        /// <summary>\n        /// <para>\n        /// Deletes the list.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public abstract void DeleteList();\n    }\n}\nusing System;\nusing System.Text;\n\nnamespace Comparisons.SQLiteVSDoublets\n{\n    /// <summary>\n    /// <para>\n    /// Represents the test run results.\n    /// </para>\n    /// <para></para>\n    /// </summary>\n    public class TestRunResults\n    {\n        /// <summary>\n        /// <para>\n        /// Gets or sets the prepare time value.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public TimeSpan PrepareTime { get; set; }\n        /// <summary>\n        /// <para>\n        /// Gets or sets the db size after prepare value.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public long DbSizeAfterPrepare { get; set; }\n        /// <summary>\n        /// <para>\n        /// Gets or sets the list creation time value.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public TimeSpan ListCreationTime { get; set; }\n        /// <summary>\n        /// <para>\n        /// Gets or sets the db size after creation value.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public long DbSizeAfterCreation { get; set; }\n        /// <summary>\n        /// <para>\n        /// Gets or sets the list reading time value.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public TimeSpan ListReadingTime { get; set; }\n        /// <summary>\n        /// <para>\n        /// Gets or sets the db size after reading value.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public long DbSizeAfterReading { get; set; }\n        /// <summary>\n        /// <para>\n        /// Gets or sets the list deletion time value.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public TimeSpan ListDeletionTime { get; set; }\n        /// <summary>\n        /// <para>\n        /// Gets or sets the db size after deletion value.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public long DbSizeAfterDeletion { get; set; }\n\n        /// <summary>\n        /// <para>\n        /// Returns the string.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        /// <returns>\n        /// <para>The string</para>\n        /// <para></para>\n        /// </returns>\n        public override string ToString()\n        {\n            var sb = new StringBuilder();\n            if (DbSizeAfterPrepare != 0)\n            {\n                sb.AppendLine($\"Prepare execution time: {PrepareTime}, db size after prepare: {DbSizeAfterPrepare}.\");\n            }\n            else\n            {\n                sb.AppendLine($\"Prepare execution time: {PrepareTime}.\");\n            }\n            if (DbSizeAfterCreation != 0)\n            {\n                sb.AppendLine($\"Create list execution time: {ListCreationTime}, db size after list creation: {DbSizeAfterCreation}.\");\n            }\n            else\n            {\n                sb.AppendLine($\"Create list execution time: {ListCreationTime}.\");\n            }\n            if (DbSizeAfterReading != 0)\n            {\n                sb.AppendLine($\"Read list execution time: {ListReadingTime}, db size after list reading: {DbSizeAfterReading}.\");\n            }\n            else\n            {\n                sb.AppendLine($\"Read list execution time: {ListReadingTime}.\");\n            }\n            if (DbSizeAfterDeletion != 0)\n            {\n                sb.AppendLine($\"Delete list execution time: {ListDeletionTime}, db size after list deletion: {DbSizeAfterDeletion}.\");\n            }\n            else\n            {\n                sb.AppendLine($\"Delete list execution time: {ListDeletionTime}.\");\n            }\n            return sb.ToString();\n        }\n    }\n}\nusing System;\nusing System.IO;\nusing System.Linq;\nusing BenchmarkDotNet.Columns;\nusing BenchmarkDotNet.Reports;\nusing BenchmarkDotNet.Running;\n\nnamespace Comparisons.SQLiteVSDoublets\n{\n    /// <summary>\n    /// <para>\n    /// Represents the size after creation column.\n    /// </para>\n    /// <para></para>\n    /// </summary>\n    /// <seealso cref=\"IColumn\"/>\n    public class SizeAfterCreationColumn : IColumn\n    {\n        /// <summary>\n        /// <para>\n        /// The sq lite vs doublets.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public static readonly string DbSizeOutputFolder = Path.Combine(Path.GetTempPath(), nameof(Comparisons), nameof(SQLiteVSDoublets));\n\n        /// <summary>\n        /// <para>\n        /// Gets the id value.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public string Id => nameof(SizeAfterCreationColumn);\n\n        /// <summary>\n        /// <para>\n        /// Gets the column name value.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public string ColumnName => \"SizeAfterCreation\";\n\n        /// <summary>\n        /// <para>\n        /// Gets the legend value.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public string Legend => \"Allocated memory on disk after all records are created (1KB = 1024B)\";\n\n        /// <summary>\n        /// <para>\n        /// Gets the unit type value.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public UnitType UnitType => UnitType.Size;\n\n        /// <summary>\n        /// <para>\n        /// Gets the always show value.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public bool AlwaysShow => true;\n\n        /// <summary>\n        /// <para>\n        /// Gets the category value.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public ColumnCategory Category => ColumnCategory.Metric;\n\n        /// <summary>\n        /// <para>\n        /// Gets the priority in category value.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public int PriorityInCategory => 0;\n\n        /// <summary>\n        /// <para>\n        /// Gets the is numeric value.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public bool IsNumeric => true;\n\n        /// <summary>\n        /// <para>\n        /// Determines whether this instance is available.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        /// <param name=\"summary\">\n        /// <para>The summary.</para>\n        /// <para></para>\n        /// </param>\n        /// <returns>\n        /// <para>The bool</para>\n        /// <para></para>\n        /// </returns>\n        public bool IsAvailable(Summary summary) => true;\n\n        /// <summary>\n        /// <para>\n        /// Determines whether this instance is default.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        /// <param name=\"summary\">\n        /// <para>The summary.</para>\n        /// <para></para>\n        /// </param>\n        /// <param name=\"benchmarkCase\">\n        /// <para>The benchmark case.</para>\n        /// <para></para>\n        /// </param>\n        /// <returns>\n        /// <para>The bool</para>\n        /// <para></para>\n        /// </returns>\n        public bool IsDefault(Summary summary, BenchmarkCase benchmarkCase) => false;\n\n        /// <summary>\n        /// <para>\n        /// Gets the value using the specified summary.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        /// <param name=\"summary\">\n        /// <para>The summary.</para>\n        /// <para></para>\n        /// </param>\n        /// <param name=\"benchmarkCase\">\n        /// <para>The benchmark case.</para>\n        /// <para></para>\n        /// </param>\n        /// <returns>\n        /// <para>The string</para>\n        /// <para></para>\n        /// </returns>\n        public string GetValue(Summary summary, BenchmarkCase benchmarkCase) => GetValue(summary, benchmarkCase, SummaryStyle.Default);\n\n        /// <summary>\n        /// <para>\n        /// Gets the value using the specified summary.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        /// <param name=\"summary\">\n        /// <para>The summary.</para>\n        /// <para></para>\n        /// </param>\n        /// <param name=\"benchmarkCase\">\n        /// <para>The benchmark case.</para>\n        /// <para></para>\n        /// </param>\n        /// <param name=\"style\">\n        /// <para>The style.</para>\n        /// <para></para>\n        /// </param>\n        /// <returns>\n        /// <para>The string</para>\n        /// <para></para>\n        /// </returns>\n        public string GetValue(Summary summary, BenchmarkCase benchmarkCase, SummaryStyle style)\n        {\n            var benchmarkName = benchmarkCase.Descriptor.WorkloadMethod.Name.ToLower();\n            var parameter = benchmarkCase.Parameters.Items.FirstOrDefault(x => x.Name == \"N\");\n            if (parameter == null)\n            {\n                return \"no parameter\";\n            }\n            var N = Convert.ToInt32(parameter.Value);\n            var filename = Path.Combine(DbSizeOutputFolder, $\"disk-size.{benchmarkName}.{N}.txt\");\n            return File.Exists(filename) ? File.ReadAllText(filename) : \"no file\";\n        }\n\n        /// <summary>\n        /// <para>\n        /// Returns the string.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        /// <returns>\n        /// <para>The string</para>\n        /// <para></para>\n        /// </returns>\n        public override string ToString() => ColumnName;\n    }\n}\nusing System.Reflection;\nusing Microsoft.EntityFrameworkCore;\nusing Comparisons.SQLiteVSDoublets.Model;\n\nnamespace Comparisons.SQLiteVSDoublets.SQLite\n{\n    /// <summary>\n    /// <para>\n    /// Represents the sq lite db context.\n    /// </para>\n    /// <para></para>\n    /// </summary>\n    /// <seealso cref=\"DbContext\"/>\n    public class SQLiteDbContext : DbContext\n    {\n        /// <summary>\n        /// <para>\n        /// The db filename.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        private readonly string _dbFilename;\n\n        /// <summary>\n        /// <para>\n        /// Gets or sets the blog posts value.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public DbSet<BlogPost> BlogPosts { get; set; }\n\n        /// <summary>\n        /// <para>\n        /// Initializes a new <see cref=\"SQLiteDbContext\"/> instance.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        /// <param name=\"dbFilename\">\n        /// <para>A db filename.</para>\n        /// <para></para>\n        /// </param>\n        public SQLiteDbContext(string dbFilename) => _dbFilename = dbFilename;\n\n        /// <summary>\n        /// <para>\n        /// Ons the configuring using the specified options builder.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        /// <param name=\"optionsBuilder\">\n        /// <para>The options builder.</para>\n        /// <para></para>\n        /// </param>\n        protected override void OnConfiguring(DbContextOptionsBuilder optionsBuilder)\n        {\n            optionsBuilder.UseSqlite($\"Filename={_dbFilename}\", options =>\n            {\n                options.MigrationsAssembly(Assembly.GetExecutingAssembly().FullName);\n            });\n            base.OnConfiguring(optionsBuilder);\n        }\n\n        /// <summary>\n        /// <para>\n        /// Ons the model creating using the specified model builder.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        /// <param name=\"modelBuilder\">\n        /// <para>The model builder.</para>\n        /// <para></para>\n        /// </param>\n        protected override void OnModelCreating(ModelBuilder modelBuilder)\n        {\n            modelBuilder.Entity<BlogPost>().ToTable(\"BlogPosts\", \"test\");\n            modelBuilder.Entity<BlogPost>(entity =>\n            {\n                entity.HasKey(e => e.Id);\n                entity.HasIndex(e => e.Title).IsUnique();\n                entity.Property(e => e.PublicationDateTime).HasDefaultValueSql(\"CURRENT_TIMESTAMP\");\n            });\n            base.OnModelCreating(modelBuilder);\n        }\n    }\n}\nusing System.Linq;\nusing Comparisons.SQLiteVSDoublets.Model;\n\nnamespace Comparisons.SQLiteVSDoublets.SQLite\n{\n    /// <summary>\n    /// <para>\n    /// Represents the sq lite test run.\n    /// </para>\n    /// <para></para>\n    /// </summary>\n    /// <seealso cref=\"TestRun\"/>\n    public class SQLiteTestRun : TestRun\n    {\n        /// <summary>\n        /// <para>\n        /// Initializes a new <see cref=\"SQLiteTestRun\"/> instance.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        /// <param name=\"dbFilename\">\n        /// <para>A db filename.</para>\n        /// <para></para>\n        /// </param>\n        public SQLiteTestRun(string dbFilename) : base(dbFilename) { }\n\n        /// <summary>\n        /// <para>\n        /// Prepares this instance.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public override void Prepare()\n        {\n            using var dbContext = new SQLiteDbContext(DbFilename);\n            dbContext.Database.EnsureCreated();\n        }\n\n        /// <summary>\n        /// <para>\n        /// Creates the list.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public override void CreateList()\n        {\n            using var dbContext = new SQLiteDbContext(DbFilename);\n            dbContext.BlogPosts.AddRange(BlogPosts.List);\n            dbContext.SaveChanges();\n        }\n\n        /// <summary>\n        /// <para>\n        /// Reads the list.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public override void ReadList()\n        {\n            using var dbContext = new SQLiteDbContext(DbFilename);\n            foreach (var blogPost in dbContext.BlogPosts)\n            {\n                ReadBlogPosts.Add(blogPost);\n            }\n        }\n\n        /// <summary>\n        /// <para>\n        /// Deletes the list.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public override void DeleteList()\n        {\n            using var dbContext = new SQLiteDbContext(DbFilename);\n            var blogPostsToDelete = dbContext.BlogPosts.ToList();\n            dbContext.BlogPosts.RemoveRange(blogPostsToDelete);\n            dbContext.SaveChanges();\n        }\n    }\n}\nusing System.Collections.Generic;\nusing System.Linq;\nusing Platform.Disposables;\nusing Platform.Collections.Lists;\nusing Platform.Collections.Stacks;\nusing Platform.Converters;\nusing Platform.Memory;\nusing Platform.Data;\nusing Platform.Data.Numbers.Raw;\nusing Platform.Data.Doublets;\nusing Platform.Data.Doublets.Decorators;\nusing Platform.Data.Doublets.PropertyOperators;\nusing Platform.Data.Doublets.CriterionMatchers;\nusing Platform.Data.Doublets.Sequences;\nusing Platform.Data.Doublets.Sequences.Unicode;\nusing Platform.Data.Doublets.Sequences.Time;\nusing Platform.Data.Doublets.Sequences.Walkers;\nusing Platform.Data.Doublets.Sequences.Converters;\nusing Platform.Data.Doublets.Sequences.CriterionMatchers;\nusing Platform.Data.Doublets.Sequences.Numbers.Raw;\nusing Platform.Data.Doublets.Memory.Split.Generic;\nusing Comparisons.SQLiteVSDoublets.Model;\nusing TLinkAddress = System.UInt32;\n\nnamespace Comparisons.SQLiteVSDoublets.Doublets\n{\n    /// <summary>\n    /// <para>\n    /// Represents the doublets db context.\n    /// </para>\n    /// <para></para>\n    /// </summary>\n    /// <seealso cref=\"DisposableBase\"/>\n    public class DoubletsDbContext : DisposableBase\n    {\n        /// <summary>\n        /// <para>\n        /// The meaning root.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        private readonly TLinkAddress _meaningRoot;\n        /// <summary>\n        /// <para>\n        /// The unicode symbol marker.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        private readonly TLinkAddress _unicodeSymbolMarker;\n        /// <summary>\n        /// <para>\n        /// The unicode sequence marker.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        private readonly TLinkAddress _unicodeSequenceMarker;\n        /// <summary>\n        /// <para>\n        /// The title property marker.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        private readonly TLinkAddress _titlePropertyMarker;\n        /// <summary>\n        /// <para>\n        /// The content property marker.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        private readonly TLinkAddress _contentPropertyMarker;\n        /// <summary>\n        /// <para>\n        /// The publication date time property marker.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        private readonly TLinkAddress _publicationDateTimePropertyMarker;\n        /// <summary>\n        /// <para>\n        /// The blog post marker.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        private readonly TLinkAddress _blogPostMarker;\n        /// <summary>\n        /// <para>\n        /// The default link property operator.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        private readonly PropertiesOperator<TLinkAddress> _defaultLinkPropertyOperator;\n        /// <summary>\n        /// <para>\n        /// The number to address converter.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        private readonly RawNumberToAddressConverter<TLinkAddress> _numberToAddressConverter;\n        /// <summary>\n        /// <para>\n        /// The address to number converter.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        private readonly AddressToRawNumberConverter<TLinkAddress> _addressToNumberConverter;\n        /// <summary>\n        /// <para>\n        /// The long raw number to date time converter.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        private readonly LongRawNumberSequenceToDateTimeConverter<TLinkAddress> _longRawNumberToDateTimeConverter;\n        /// <summary>\n        /// <para>\n        /// The date time to long raw number converter.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        private readonly DateTimeToLongRawNumberSequenceConverter<TLinkAddress> _dateTimeToLongRawNumberConverter;\n        /// <summary>\n        /// <para>\n        /// The string to unicode sequence converter.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        private readonly IConverter<string, TLinkAddress> _stringToUnicodeSequenceConverter;\n        /// <summary>\n        /// <para>\n        /// The unicode sequence to string converter.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        private readonly IConverter<TLinkAddress, string> _unicodeSequenceToStringConverter;\n        /// <summary>\n        /// <para>\n        /// The disposable links.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        private readonly ILinks<TLinkAddress> _disposableLinks;\n        /// <summary>\n        /// <para>\n        /// The links.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        private readonly ILinks<TLinkAddress> _links;\n\n        /// <summary>\n        /// <para>\n        /// Initializes a new <see cref=\"DoubletsDbContext\"/> instance.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        /// <param name=\"dataDBFilename\">\n        /// <para>A data db filename.</para>\n        /// <para></para>\n        /// </param>\n        /// <param name=\"indexDBFilename\">\n        /// <para>A index db filename.</para>\n        /// <para></para>\n        /// </param>\n        public DoubletsDbContext(string dataDBFilename, string indexDBFilename)\n        {\n            var dataMemory = new FileMappedResizableDirectMemory(dataDBFilename);\n            var indexMemory = new FileMappedResizableDirectMemory(indexDBFilename);\n\n            var linksConstants = new LinksConstants<TLinkAddress>(enableExternalReferencesSupport: true);\n\n            // Init the links storage\n            _disposableLinks = new SplitMemoryLinks<TLinkAddress>(dataMemory, indexMemory);\n            _links = _disposableLinks;\n\n            // Set up constant links (markers, aka mapped links)\n            TLinkAddress currentMappingLinkIndex = 1;\n            _meaningRoot = GetOrCreateMeaningRoot(currentMappingLinkIndex++);\n            _unicodeSymbolMarker = GetOrCreateNextMapping(currentMappingLinkIndex++);\n            _unicodeSequenceMarker = GetOrCreateNextMapping(currentMappingLinkIndex++);\n            _titlePropertyMarker = GetOrCreateNextMapping(currentMappingLinkIndex++);\n            _contentPropertyMarker = GetOrCreateNextMapping(currentMappingLinkIndex++);\n            _publicationDateTimePropertyMarker = GetOrCreateNextMapping(currentMappingLinkIndex++);\n            _blogPostMarker = GetOrCreateNextMapping(currentMappingLinkIndex++);\n\n            // Create properties operator that is able to control reading and writing properties for any link (object)\n            _defaultLinkPropertyOperator = new PropertiesOperator<TLinkAddress>(_links);\n\n            // Create converters that are able to convert link's address (UInt64 value) to a raw number represented with another UInt64 value and back\n            _numberToAddressConverter = new RawNumberToAddressConverter<TLinkAddress>();\n            _addressToNumberConverter = new AddressToRawNumberConverter<TLinkAddress>();\n\n            // Create converters for dates\n            _longRawNumberToDateTimeConverter = new LongRawNumberSequenceToDateTimeConverter<TLinkAddress>(new LongRawNumberSequenceToNumberConverter<TLinkAddress, long>(_links, _numberToAddressConverter));\n            _dateTimeToLongRawNumberConverter = new DateTimeToLongRawNumberSequenceConverter<TLinkAddress>(new NumberToLongRawNumberSequenceConverter<long, TLinkAddress>(_links, _addressToNumberConverter));\n\n            // Create converters that are able to convert string to unicode sequence stored as link and back\n            var balancedVariantConverter = new BalancedVariantConverter<TLinkAddress>(_links);\n            var unicodeSymbolCriterionMatcher = new TargetMatcher<TLinkAddress>(_links, _unicodeSymbolMarker);\n            var unicodeSequenceCriterionMatcher = new TargetMatcher<TLinkAddress>(_links, _unicodeSequenceMarker);\n            var charToUnicodeSymbolConverter = new CharToUnicodeSymbolConverter<TLinkAddress>(_links, _addressToNumberConverter, _unicodeSymbolMarker);\n            var unicodeSymbolToCharConverter = new UnicodeSymbolToCharConverter<TLinkAddress>(_links, _numberToAddressConverter, unicodeSymbolCriterionMatcher);\n            var sequenceWalker = new RightSequenceWalker<TLinkAddress>(_links, new DefaultStack<TLinkAddress>(), unicodeSymbolCriterionMatcher.IsMatched);\n            _stringToUnicodeSequenceConverter = new CachingConverterDecorator<string, TLinkAddress>(new StringToUnicodeSequenceConverter<TLinkAddress>(_links, charToUnicodeSymbolConverter, balancedVariantConverter, _unicodeSequenceMarker));\n            _unicodeSequenceToStringConverter = new CachingConverterDecorator<TLinkAddress, string>(new UnicodeSequenceToStringConverter<TLinkAddress>(_links, unicodeSequenceCriterionMatcher, sequenceWalker, unicodeSymbolToCharConverter, _unicodeSequenceMarker));\n        }\n\n        /// <summary>\n        /// <para>\n        /// Gets the or create meaning root using the specified meaning root index.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        /// <param name=\"meaningRootIndex\">\n        /// <para>The meaning root index.</para>\n        /// <para></para>\n        /// </param>\n        /// <returns>\n        /// <para>The link address</para>\n        /// <para></para>\n        /// </returns>\n        private TLinkAddress GetOrCreateMeaningRoot(TLinkAddress meaningRootIndex) => _links.Exists(meaningRootIndex) ? meaningRootIndex : _links.CreatePoint();\n\n        /// <summary>\n        /// <para>\n        /// Gets the or create next mapping using the specified current mapping index.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        /// <param name=\"currentMappingIndex\">\n        /// <para>The current mapping index.</para>\n        /// <para></para>\n        /// </param>\n        /// <returns>\n        /// <para>The link address</para>\n        /// <para></para>\n        /// </returns>\n        private TLinkAddress GetOrCreateNextMapping(TLinkAddress currentMappingIndex) => _links.Exists(currentMappingIndex) ? currentMappingIndex : _links.CreateAndUpdate(_meaningRoot, _links.Constants.Itself);\n\n        /// <summary>\n        /// <para>\n        /// Converts the to string using the specified sequence.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        /// <param name=\"sequence\">\n        /// <para>The sequence.</para>\n        /// <para></para>\n        /// </param>\n        /// <returns>\n        /// <para>The string</para>\n        /// <para></para>\n        /// </returns>\n        public string ConvertToString(TLinkAddress sequence) => _unicodeSequenceToStringConverter.Convert(sequence);\n\n        /// <summary>\n        /// <para>\n        /// Converts the to sequence using the specified string.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        /// <param name=\"@string\">\n        /// <para>The string.</para>\n        /// <para></para>\n        /// </param>\n        /// <returns>\n        /// <para>The link address</para>\n        /// <para></para>\n        /// </returns>\n        public TLinkAddress ConvertToSequence(string @string) => _stringToUnicodeSequenceConverter.Convert(@string);\n\n        /// <summary>\n        /// <para>\n        /// Gets the blog posts value.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        public IList<BlogPost> BlogPosts => GetBlogPosts();\n\n        /// <summary>\n        /// <para>\n        /// Gets the blog posts.\n        /// </para>\n        /// <para></para>\n        /// </summary>\n        /// <returns>\n        /// <para>A list of blog post</para>\n        /// <para></para>\n        /// </returns>\n        public IList<BlogPost> GetBlogPosts()\n        {\n            var list = new List<IList<TLinkAddress>>();\n            var listFiller = new ListFiller<IList<TLinkAddress>, TLinkAddress>(list, _links.Constants.Continue);\n            // Load all links that match the query: (any: _blogPostMarker",
