[2026-10-04T18:12:04.959Z] [INFO]         "content": "# Root level gitignore for the repository\n# C# specific gitignore is in csharp/.gitignore\n# C++ specific files\ncpp/build/\ncpp/*.o\ncpp/*.a\ncpp/*.so\ncpp/*.exe\n\n# Common temporary files\n__pycache__/\n*.py[cod]\n*.tmp\n*.log\n*.swp\n*~\n.DS_Store\n\n# Rust build output\ntarget/\n\n# .NET build output\nbin/\nobj/\nSQLite_Memory #1: create 16022 ns/op, read_all 4524 ns/op, read_by_id 9625 ns/op, delete 11345 ns/op\nSQLite_File #1: create 19461 ns/op, read_all 9744 ns/op, read_by_id 17730 ns/op, delete 28941 ns/op\nDoublets_United_Volatile_Cached #1: create 75661 ns/op, read_all 64841 ns/op, read_by_id 8028 ns/op, delete 52565 ns/op\n// Profiles which ILinks calls make C# Doublets blog post creation grow with the number of stored posts.\n// Usage: dotnet run -c Release -- <united|split> <n> [united index tree type] [internal]\n// Wraps the store in a decorator that counts and times Each, Count, Create, Update and Delete calls and\n// prints them per created post for the first and the last tenth of the posts.\nusing System.Diagnostics;\nusing Comparisons.SQLiteVSDoublets;\nusing Platform.Data;\nusing Platform.Data.Doublets;\nusing Platform.Data.Doublets.Memory;\nusing Platform.Data.Doublets.Memory.United.Generic;\nusing Platform.Delegates;\nusing Platform.Memory;\n\nvar kind = args[0];\nvar n = int.Parse(args[1]);\nConsole.WriteLine($\"tree types: {string.Join(\", \", Enum.GetNames<IndexTreeType>())}\");\nILinks<ulong> store = kind == \"united\"\n    ? new UnitedMemoryLinks<ulong>(new HeapResizableDirectMemory(), UnitedMemoryLinks<ulong>.DefaultLinksSizeStep,\n        new LinksConstants<ulong>(args.Length <= 3 || args[3] != \"internal\"), args.Length > 2 ? Enum.Parse<IndexTreeType>(args[2]) : IndexTreeType.Default)\n    : Harness.Split<ulong>(new HeapResizableDirectMemory(), new HeapResizableDirectMemory(), external: true);\n----\n// Measures how attaching links to one shared \"hub\" link scales in the C# united and split stores.\n// Usage: dotnet run -c Release\n// For each store, constants (internal-only or with external references), and hub side (source or target), creates\n// n links (hub, new) or (new, hub) and prints the time per link for the last thousand links.\nusing System.Diagnostics;\nusing Comparisons.SQLiteVSDoublets;\nusing Platform.Data;\nusing Platform.Data.Doublets;\nusing Platform.Memory;\n\nforeach (var kind in new[] { \"united\", \"split\" })\nforeach (var external in new[] { false, true })\nforeach (var side in new[] { \"source\", \"target\" })\n{\n    var line = $\"{kind,-6} external={external,-5} hub={side,-6}:\";\n    foreach (var n in new[] { 2_000, 8_000, 32_000 })\n    {\n        ILinks<ulong> links = kind == \"united\"\n            ? Harness.United<ulong>(new HeapResizableDirectMemory(), external)\n            : Harness.Split<ulong>(new HeapResizableDirectMemory(), new HeapResizableDirectMemory(), external);\n        var hub = links.CreatePoint();\n        var stopwatch = new Stopwatch();\n        for (var i = 1; i <= n; i++)\n        {\n            var link = links.Create();\n            if (i > n - 1000) stopwatch.Start();\n            if (side == \"source\") links.Update(link, hub, link); else links.Update(link, link, hub);\n            stopwatch.Stop();\n        }\n        line += $\" n={n}: {stopwatch.Elapsed.TotalNanoseconds / 1000,8:F0} ns\";",
