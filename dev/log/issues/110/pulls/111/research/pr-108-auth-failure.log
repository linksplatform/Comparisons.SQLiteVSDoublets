[2026-10-04T18:03:34.244Z] [INFO]               "lines": [
[2026-10-04T18:03:34.244Z] [INFO]                 " // Profiles which ILinks calls make C# Doublets blog post creation grow with the number of stored posts.",
[2026-10-04T18:03:34.244Z] [INFO]                 "-// Usage: dotnet run -c Release -- <united|split> <n>",
[2026-10-04T18:03:34.244Z] [INFO]                 "+// Usage: dotnet run -c Release -- <united|split> <n> [united index tree type]",
[2026-10-04T18:03:34.244Z] [INFO]                 " // Wraps the store in a decorator that counts and times Each, Count, Create, Update and Delete calls and",
[2026-10-04T18:03:34.244Z] [INFO]                 " // prints them per created post for the first and the last tenth of the posts.",
[2026-10-04T18:03:34.244Z] [INFO]                 " using System.Diagnostics;",
[2026-10-04T18:03:34.244Z] [INFO]                 " using Comparisons.SQLiteVSDoublets;",
[2026-10-04T18:03:34.244Z] [INFO]                 " using Platform.Data;",
[2026-10-04T18:03:34.244Z] [INFO]                 " using Platform.Data.Doublets;",
[2026-10-04T18:03:34.244Z] [INFO]                 "+using Platform.Data.Doublets.Memory;",
[2026-10-04T18:03:34.244Z] [INFO]                 "+using Platform.Data.Doublets.Memory.United.Generic;",
[2026-10-04T18:03:34.244Z] [INFO]                 " using Platform.Delegates;",
[2026-10-04T18:03:34.244Z] [INFO]                 " using Platform.Memory;",
[2026-10-04T18:03:34.244Z] [INFO]                 " ",
[2026-10-04T18:03:34.244Z] [INFO]                 " var kind = args[0];",
[2026-10-04T18:03:34.244Z] [INFO]                 " var n = int.Parse(args[1]);",
[2026-10-04T18:03:34.244Z] [INFO]                 "+Console.WriteLine($\"tree types: {string.Join(\", \", Enum.GetNames<IndexTreeType>())}\");",
[2026-10-04T18:03:34.244Z] [INFO]                 " ILinks<ulong> store = kind == \"united\"",
[2026-10-04T18:03:34.244Z] [INFO]                 "-    ? Harness.United<ulong>(new HeapResizableDirectMemory(), external: true)",
[2026-10-04T18:03:34.244Z] [INFO]                 "+    ? new UnitedMemoryLinks<ulong>(new HeapResizableDirectMemory(), UnitedMemoryLinks<ulong>.DefaultLinksSizeStep,",
[2026-10-04T18:03:34.244Z] [INFO]                 "+        new LinksConstants<ulong>(true), args.Length > 2 ? Enum.Parse<IndexTreeType>(args[2]) : IndexTreeType.Default)",
[2026-10-04T18:03:34.244Z] [INFO]                 "     : Harness.Split<ulong>(new HeapResizableDirectMemory(), new HeapResizableDirectMemory(), external: true);",
[2026-10-04T18:03:34.244Z] [INFO]                 " var profiled = new Profiled(store);",
[2026-10-04T18:03:34.244Z] [INFO]                 " var posts = new DoubletsBlogPosts<ulong>(profiled, cacheSequences: true);"
[2026-10-04T18:03:34.244Z] [INFO]               ]
[2026-10-04T18:03:34.244Z] [INFO]             }
[2026-10-04T18:03:34.244Z] [INFO]           ]
[2026-10-04T18:03:34.244Z] [INFO]         }
