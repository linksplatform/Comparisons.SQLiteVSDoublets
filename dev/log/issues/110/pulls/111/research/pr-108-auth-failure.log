[2026-10-04T17:13:51.453Z] [INFO]                 "+    private static void Timed(List<(string, TimeSpan)> timings, string operation, Tally expected, Func<Tally> work)",
[2026-10-04T17:13:51.453Z] [INFO]                 "+    {",
[2026-10-04T17:13:51.453Z] [INFO]                 "+        var stopwatch = Stopwatch.StartNew();",
[2026-10-04T17:13:51.453Z] [INFO]                 "+        var actual = work();",
[2026-10-04T17:13:51.453Z] [INFO]                 "+        timings.Add((operation, stopwatch.Elapsed));",
[2026-10-04T17:13:51.453Z] [INFO]                 "+        Check(actual == expected, $\"{operation} returned unexpected records: {actual} instead of {expected}\");",
[2026-10-04T17:13:51.453Z] [INFO]                 "+    }",
[2026-10-04T17:13:51.453Z] [INFO]                 "+",
[2026-10-04T17:13:51.453Z] [INFO]                 "+    private static void Check(bool condition, string message)",
[2026-10-04T17:13:51.453Z] [INFO]                 "+    {",
