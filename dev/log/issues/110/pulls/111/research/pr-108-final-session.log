[2026-10-05T00:29:17.785Z] [INFO]         "content": "     1\tuse doublets::{\n     2\t    data::{LinkReference, LinksConstants},\n     3\t    mem::Global,\n     4\t    split, unit,\n     5\t};\n     6\tuse sqlite_vs_doublets::{\n     7\t    dataset::{BlogPost, blog_post, link, scattered},\n     8\t    harness::{self, LINKS_VARIANTS, OBJECTS_VARIANTS},\n     9\t    links::{DoubletsLinks, Link, LinksStorage, SqliteLinks},\n    10\t    memory::volatile,\n    11\t    objects::{BlogPostsStorage, DoubletsBlogPosts, SqliteBlogPosts},\n    12\t};\n    13\tuse std::collections::HashSet;\n    14\t\n    15\tconst SIZE: u64 = 1_000;\n    16\t\n    17\t#[test]\n    18\tfn links_are_unique_and_reference_created_ids() {\n    19\t    let links: HashSet<_> = (1..=SIZE).map(link).collect();\n    20\t    assert_eq!(links.len(), SIZE as usize);\n    21\t    for i in 1..=SIZE {\n    22\t        let (from, to) = link(i);\n    23\t        assert!((1..=i).contains(&from) && (1..=i).contains(&to));\n    24\t    }\n    25\t}\n    26\t\n    27\t#[test]\n    28\tfn scattered_visits_every_id_once() {\n    29\t    for n in [1, 2, 3, 10, 1_000, 1_024, 65_536] {\n    30\t        let mut ids: Vec<u64> = scattered(n).collect();\n    31\t        ids.sort();\n    32\t        assert_eq!(ids, (1..=n).collect::<Vec<_>>());\n    33\t    }\n    34\t}\n    35\t\n    36\t#[test]\n    37\tfn every_links_variant_passes_the_lifecycle() {\n    38\t    let directory = tempdir(\"links\");\n    39\t    for variant in LINKS_VARIANTS {\n    40\t        harness::measure_links::<u32>(variant, SIZE, 1, &directory);\n    41\t        harness::measure_links::<u64>(variant, SIZE, 1, &directory);\n    42\t    }\n    43\t}\n    44\t\n    45\t#[test]\n    46\tfn every_objects_variant_passes_the_lifecycle() {\n    47\t    let directory = tempdir(\"objects\");\n    48\t    for variant in OBJECTS_VARIANTS {\n    49\t        harness::measure_objects::<u32>(variant, SIZE / 10, 1, &directory);\n    50\t        harness::measure_objects::<u64>(variant, SIZE / 10, 1, &directory);\n    51\t    }\n    52\t}\n    53\t\n    54\t#[test]\n    55\tfn split_store_keeps_links_updated_to_reference_themselves() {\n    56\t    let mut links =\n    57\t        DoubletsLinks::new(split::Store::<u32, _, _>::new(Global::new(), Global::new()).unwrap());\n    58\t    let point = links.create(1, 1);\n    59\t    let link = links.create(point, 2);\n    60\t    links.update(point, point, point);\n    61\t    links.update(link, link, point);\n    62\t    assert_eq!(\n    63\t        links.get(link),\n    64\t        Some(Link {\n    65\t            id: link,\n    66\t            from: link,\n    67\t            to: point\n    68\t        })\n    69\t    );\n    70\t    links.delete(link);\n    71\t    links.delete(point);\n    72\t    assert_eq!(links.count(), 0);\n    73\t}\n    74\t\n    75\t/// A fresh store reserves 2^20 links, so this many links make it grow once.\n    76\tconst GROWN: u64 = (1 << 20) + 1;\n    77\t\n    78\tfn create_until_grown(mut links: impl LinksStorage<u32>) {\n    79\t    for i in 1..=GROWN {\n    80\t        let (from, to) = link(i);\n    81\t        links.create(from as u32, to as u32);\n    82\t    }\n    83\t    assert_eq!(links.count(), GROWN);\n    84\t    for i in [1, 1_040_384, 1_040_385, GROWN] {\n    85\t        let (from, to) = link(i);\n    86\t        let (id, from, to) = (i as u32, from as u32, to as u32);\n    87\t        assert_eq!(links.get(id), Some(Link { id, from, to }));\n    88\t    }\n    89\t}\n    90\t\n    91\t#[test]\n    92\tfn stores_keep_their_links_when_their_memory_grows() {\n    93\t    create_until_grown(DoubletsLinks::new(\n    94\t        unit::Store::<u32, _>::new(volatile()).unwrap(),\n    95\t    ));\n    96\t    create_until_grown(DoubletsLinks::new(\n    97\t        split::Store::<u32, _, _>::new(volatile(), volatile()).unwrap(),\n    98\t    ));\n    99\t}\n   100\t\n   101\t#[test]\n   102\t#[should_panic(expected = \"query_all returned unexpected records\")]\n   103\tfn lifecycle_rejects_a_storage_that_loses_records() {\n   104\t    struct Lossy(SqliteLinks<u32>);\n   105\t\n   106\t    impl LinksStorage<u32> for Lossy {\n   107\t        fn create(&mut self, from: u32, to: u32) -> u32 {\n   108\t            self.0.create(from, to)\n   109\t        }\n   110\t        fn update(&mut self, id: u32, from: u32, to: u32) {\n   111\t            self.0.update(id, from, to)\n   112\t        }\n   113\t        fn delete(&mut self, id: u32) {\n   114\t            self.0.delete(id)\n   115\t        }\n   116\t        fn get(&self, id: u32) -> Option<Link<u32>> {\n   117\t            self.0.get(id)\n   118\t        }\n   119\t        fn search(&self, from: u32, to: u32) -> Option<u32> {\n   120\t            self.0.search(from, to)\n   121\t        }\n   122\t        fn each(&self, visit: impl FnMut(Link<u32>)) {\n   123\t            self.0.each_with_from(1, visit)\n   124\t        }\n   125\t        fn each_with_from(&self, from: u32, visit: impl FnMut(Link<u32>)) {\n   126\t            self.0.each_with_from(from, visit)\n   127\t        }\n   128\t        fn each_with_to(&self, to: u32, visit: impl FnMut(Link<u32>)) {\n   129\t            self.0.each_with_to(to, visit)\n   130\t        }\n   131\t        fn count(&self) -> u64 {\n   132\t            self.0.count()\n   133\t        }\n   134\t    }\n   135\t\n   136\t    harness::links_lifecycle(&mut Lossy(SqliteLinks::in_memory()), SIZE, &mut || {});\n   137\t}\n   138\t\n   139\tfn round_trip<T: LinkReference>(mut posts: impl BlogPostsStorage<T>) {\n   140\t    let mut inputs: Vec<BlogPost> = (1..=20).map(blog_post).collect();\n   141\t    inputs.push(BlogPost {\n   142\t        title: \"Ünïcödé 🌍 ✓\".into(),\n   143\t        content: \"a\".into(),\n   144\t        publication_date: 0,\n   145\t    });\n   146\t    inputs.push(BlogPost {\n   147\t        title: String::new(),\n   148\t        content: \"ab\".into(),\n   149\t        publication_date: u32::MAX as u64 / 2,\n   150\t    });\n   151\t    let ids: Vec<T> = inputs.iter().map(|post| posts.create(post)).collect();\n   152\t    for (id, post) in ids.iter().zip(&inputs) {\n   153\t        assert_eq!(posts.get(*id).as_ref(), Some(post));\n   154\t    }\n   155\t    let mut stored = Vec::new();\n   156\t    posts.each(|id, post| stored.push((id, post)));\n   157\t    stored.sort_by_key(|(id, _)| *id);\n   158\t    assert_eq!(stored, ids.into_iter().zip(inputs).collect::<Vec<_>>());\n   159\t}\n   160\t\n   161\t#[test]\n   162\tfn every_objects_storage_returns_the_stored_posts() {\n   163\t    round_trip::<u32>(SqliteBlogPosts::in_memory());\n   164\t    round_trip::<u64>(SqliteBlogPosts::in_memory());\n   165\t    for cached in [false, true] {\n   166\t        round_trip(DoubletsBlogPosts::new(\n   167\t            unit::Store::<u32, _>::with_constants(Global::new(), LinksConstants::external())\n   168\t                .unwrap(),\n   169\t            cached,\n   170\t        ));\n   171\t        round_trip(DoubletsBlogPosts::new(\n   172\t            unit::Store::<u64, _>::with_constants(Global::new(), LinksConstants::external())\n   173\t                .unwrap(),\n   174\t            cached,\n   175\t        ));\n   176\t        round_trip(DoubletsBlogPosts::new(\n   177\t            split::Store::<u32, _, _>::with_constants(\n   178\t                Global::new(),\n   179\t                Global::new(),\n   180\t                LinksConstants::external(),\n   181\t            )\n   182\t            .unwrap(),\n   183\t            cached,\n   184\t        ));\n   185\t        round_trip(DoubletsBlogPosts::new(\n   186\t            split::Store::<u64, _, _>::with_constants(\n   187\t                Global::new(),\n   188\t                Global::new(),\n   189\t                LinksConstants::external(),\n   190\t            )\n   191\t            .unwrap(),\n   192\t            cached,\n   193\t        ));\n   194\t    }\n   195\t}\n   196\t\n   197\tfn tempdir(name: &str) -> std::path::PathBuf {\n   198\t    let directory = std::env::temp_dir().join(format!(\n   199\t        \"sqlite-vs-doublets-test-{name}-{}\",\n   200\t        std::process::id()\n   201\t    ));\n   202\t    std::fs::create_dir_all(&directory).unwrap();\n   203\t    directory\n   204\t}\n   205\tusing Platform.Memory;\n   206\tusing Xunit;\n   207\tusing static Comparisons.SQLiteVSDoublets.Dataset;\n   208\t\n   209\tnamespace Comparisons.SQLiteVSDoublets.Tests;\n   210\t\n   211\tpublic class StoragesTests\n   212\t{\n   213\t    private const ulong Size = 1_000;\n   214\t\n   215\t    [Fact]\n   216\t    public void LinksAreUniqueAndReferenceCreatedIds()\n   217\t    {\n   218\t        var links = new HashSet<(ulong, ulong)>();\n   219\t        for (ulong i = 1; i <= Size; i++)\n   220\t        {\n   221\t            var (from, to) = Link(i);\n   222\t            Assert.InRange(from, 1UL, i);\n   223\t            Assert.InRange(to, 1UL, i);\n   224\t            links.Add((from, to));\n   225\t        }\n   226\t        Assert.Equal((int)Size, links.Count);\n   227\t    }\n   228\t\n   229\t    [Theory]\n   230\t    [InlineData(1UL), InlineData(2UL), InlineData(3UL), InlineData(10UL), InlineData(1_000UL), InlineData(1_024UL), InlineData(65_536UL)]\n   231\t    public void ScatteredVisitsEveryIdOnce(ulong n) =>\n   232\t        Assert.Equal(Enumerable.Range(1, (int)n).Select(i => (ulong)i), Scattered(n).Order());\n   233\t\n   234\t    public static TheoryData<string> LinksVariants => [.. Harness.LinksVariants];\n   235\t\n   236\t    public static TheoryData<string> ObjectsVariants => [.. Harness.ObjectsVariants];\n   237\t\n   238\t    [Theory, MemberData(nameof(LinksVariants))]\n   239\t    public void EveryLinksVariantPassesTheLifecycle(string variant)\n   240\t    {\n   241\t        var directory = Directory.CreateTempSubdirectory().FullName;\n   242\t        Harness.MeasureLinks<uint>(variant, Size, 1, directory);\n   243\t        Harness.MeasureLinks<ulong>(variant, Size, 1, directory);\n   244\t    }\n   245\t\n   246\t    [Theory, MemberData(nameof(ObjectsVariants))]\n   247\t    public void EveryObjectsVariantPassesTheLifecycle(string variant)\n   248\t    {\n   249\t        var directory = Directory.CreateTempSubdirectory().FullName;\n   250\t        Harness.MeasureObjects<uint>(variant, Size / 10, 1, directory);\n   251\t        Harness.MeasureObjects<ulong>(variant, Size / 10, 1, directory);\n   252\t    }\n   253\t\n   254\t    [Fact]\n   255\t    public void SplitStoreKeepsLinksUpdatedToReferenceThemselves()\n   256\t    {\n   257\t        using var links = new DoubletsLinks<uint>(Harness.Split<uint>(new HeapResizableDirectMemory(), new HeapResizableDirectMemory()));\n   258\t        var point = links.Create(1, 1);\n   259\t        var link = links.Create(point, 2);\n   260\t        links.Update(point, point, point);\n   261\t        links.Update(link, link, point);\n   262\t        Assert.Equal(new Link<uint>(link, link, point), links.Get(link));\n   263\t        links.Delete(link);\n   264\t        links.Delete(point);\n   265\t        Assert.Equal(0UL, links.Count());\n   266\t    }\n   267\t\n   268\t    private sealed class Lossy(SQLiteLinks<uint> links) : ILinksStorage<uint>\n   269\t    {\n   270\t        public uint Create(uint from, uint to) => links.Create(from, to);\n   271\t        public void Update(uint id, uint from, uint to) => links.Update(id, from, to);\n   272\t        public void Delete(uint id) => links.Delete(id);\n   273\t        public Link<uint>? Get(uint id) => links.Get(id);\n   274\t        public uint? Search(uint from, uint to) => links.Search(from, to);\n   275\t        public void Each(Action<Link<uint>> visit) => links.EachWithFrom(1, visit);\n   276\t        public void EachWithFrom(uint from, Action<Link<uint>> visit) => links.EachWithFrom(from, visit);\n   277\t        public void EachWithTo(uint to, Action<Link<uint>> visit) => links.EachWithTo(to, visit);\n   278\t        public ulong Count() => links.Count();\n   279\t        public void Dispose() => links.Dispose();\n   280\t    }\n   281\t\n   282\t    [Fact]\n   283\t    public void LifecycleRejectsAStorageThatLosesRecords()\n   284\t    {\n   285\t        using var lossy = new Lossy(SQLiteLinks<uint>.InMemory());\n   286\t        var error = Assert.Throws<InvalidOperationException>(() => Harness.LinksLifecycle(lossy, Size, () => { }));\n   287\t        Assert.StartsWith(\"query_all returned unexpected records\", error.Message);\n   288\t    }\n   289\t\n   290\t    private static void RoundTrip<T>(IBlogPostsStorage<T> posts) where T : struct\n   291\t    {\n   292\t        using var _ = posts;\n   293\t        var inputs = Enumerable.Range(1, 20).Select(i => BlogPost((ulong)i)).ToList();\n   294\t        inputs.Add(new BlogPost(\"Ünïcödé 🌍 ✓\", \"a\", 0));\n   295\t        inputs.Add(new BlogPost(\"\", \"ab\", uint.MaxValue / 2));\n   296\t        var ids = inputs.Select(posts.Create).ToList();\n   297\t        Assert.Equal(inputs, ids.Select(id => posts.Get(id)));\n   298\t        var stored = new List<(T, BlogPost)>();\n   299\t        posts.Each((id, post) => stored.Add((id, post)));\n   300\t        Assert.Equal(ids.Zip(inputs), stored.OrderBy(entry => entry.Item1));\n   301\t        ids.ForEach(posts.Delete);\n   302\t        Assert.Equal(0UL, posts.Count());\n   303\t    }\n   304\t\n   305\t    [Theory, InlineData(false), InlineData(true)]\n   306\t    public void EveryObjectsStorageReturnsTheStoredPosts(bool cached)\n   307\t    {\n   308\t        RoundTrip(SQLiteBlogPosts<uint>.InMemory());\n   309\t        RoundTrip(SQLiteBlogPosts<ulong>.InMemory());\n   310\t        RoundTrip(new DoubletsBlogPosts<uint>(Harness.United<uint>(new HeapResizableDirectMemory(), external: true), cached));\n   311\t        RoundTrip(new DoubletsBlogPosts<ulong>(Harness.United<ulong>(new HeapResizableDirectMemory(), external: true), cached));\n   312\t        RoundTrip(new DoubletsBlogPosts<uint>(Harness.Split<uint>(new HeapResizableDirectMemory(), new HeapResizableDirectMemory(), external: true), cached));\n   313\t        RoundTrip(new DoubletsBlogPosts<ulong>(Harness.Split<ulong>(new HeapResizableDirectMemory(), new HeapResizableDirectMemory(), external: true), cached));\n   314\t    }\n   315\t}",
