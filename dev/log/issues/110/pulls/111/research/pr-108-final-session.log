[2026-10-05T00:53:23.827Z] [INFO]               "lines": [
[2026-10-05T00:53:23.827Z] [INFO]                 "+#!/usr/bin/env bash",
[2026-10-05T00:53:23.827Z] [INFO]                 "+# Prints the C# medians per variant twice: with a warm JIT the Volatile/NonVolatile pairs of the same",
[2026-10-05T00:53:23.827Z] [INFO]                 "+# store should agree, whatever position the variant has in the run.",
[2026-10-05T00:53:23.827Z] [INFO]                 "+set -euo pipefail",
[2026-10-05T00:53:23.827Z] [INFO]                 "+category=${1:-links}",
[2026-10-05T00:53:23.827Z] [INFO]                 "+size=${2:-1000}",
[2026-10-05T00:53:23.827Z] [INFO]                 "+dotnet build -c Release csharp/SQLiteVSDoublets > /dev/null",
[2026-10-05T00:53:23.827Z] [INFO]                 "+for run in 1 2; do",
[2026-10-05T00:53:23.827Z] [INFO]                 "+  start=$SECONDS",
[2026-10-05T00:53:23.827Z] [INFO]                 "+  dotnet csharp/SQLiteVSDoublets/bin/Release/net10.0/sqlite-vs-doublets.dll \"$category\" 64 \"$size\" \\",
[2026-10-05T00:53:23.827Z] [INFO]                 "+    --output \"/tmp/warm-up-$run.json\" --directory /tmp/warm-up-storage 2> /dev/null",
[2026-10-05T00:53:23.827Z] [INFO]                 "+  echo \"run $run took $((SECONDS - start)) s\"",
[2026-10-05T00:53:23.827Z] [INFO]                 "+  python3 -c \"",
[2026-10-05T00:53:23.827Z] [INFO]                 "+import json, sys",
[2026-10-05T00:53:23.827Z] [INFO]                 "+for r in json.load(open(sys.argv[1]))['results']:",
[2026-10-05T00:53:23.827Z] [INFO]                 "+    print(r['variant'].ljust(38), {k: round(v['median_ns']) for k, v in r['operations'].items()})\" \"/tmp/warm-up-$run.json\"",
[2026-10-05T00:53:23.827Z] [INFO]                 "+done"
[2026-10-05T00:53:23.827Z] [INFO]               ]
[2026-10-05T00:53:23.827Z] [INFO]             }
[2026-10-05T00:53:23.827Z] [INFO]           ],
