[2026-10-04T18:12:59.536Z] [INFO]                 " // Usage: dotnet run -c Release -- <united|split> <n> [united index tree type] [internal]",
[2026-10-04T18:12:59.536Z] [INFO]                 " // Wraps the store in a decorator that counts and times Each, Count, Create, Update and Delete calls and",
[2026-10-04T18:12:59.536Z] [INFO]                 " // prints them per created post for the first and the last tenth of the posts.",
[2026-10-04T18:12:59.536Z] [INFO]                 "+// Results with Platform.Data.Doublets 0.18.1 and 10,000 posts: only the update that attaches a post to its",
[2026-10-04T18:12:59.536Z] [INFO]                 "+// type marker grows, so the united store's size balanced trees degenerate when thousands of links share a source.",
[2026-10-04T18:12:59.536Z] [INFO]                 "+// Mean time of that update for posts 1..1,000 -> 9,001..10,000:",
[2026-10-04T18:12:59.536Z] [INFO]                 "+//   united Default                          27 µs -> 322 µs",
[2026-10-04T18:12:59.536Z] [INFO]                 "+//   united SizeBalancedTree                 82 µs -> 369 µs",
[2026-10-04T18:12:59.536Z] [INFO]                 "+//   united RecursionlessSizeBalancedTree    47 µs -> 742 µs",
[2026-10-04T18:12:59.536Z] [INFO]                 "+//   united SizedAndThreadedAVLBalancedTree  22 µs -> 2.2 µs",
[2026-10-04T18:12:59.536Z] [INFO]                 "+//   split                                  0.9 µs -> 0.2 µs",
[2026-10-04T18:12:59.536Z] [INFO]                 "+// `internal` (no external references) degenerates the same way (Default: 50 µs -> 584 µs), and plain hubs",
[2026-10-04T18:12:59.536Z] [INFO]                 "+// without the rest of the blog post links do not, so the benchmarks use the AVL trees for the united store.",
[2026-10-04T18:12:59.536Z] [INFO]                 " using System.Diagnostics;",
[2026-10-04T18:12:59.536Z] [INFO]                 " using Comparisons.SQLiteVSDoublets;",
[2026-10-04T18:12:59.536Z] [INFO]                 " using Platform.Data;"
[2026-10-04T18:12:59.536Z] [INFO]               ]
[2026-10-04T18:12:59.536Z] [INFO]             }
[2026-10-04T18:12:59.536Z] [INFO]           ]
[2026-10-04T18:12:59.536Z] [INFO]         },
[2026-10-04T18:12:59.536Z] [INFO]         {
[2026-10-04T18:12:59.536Z] [INFO]           "filePath": "/tmp/gh-issue-solver-1791131286882/experiments/csharp_united_hub/Program.cs",
[2026-10-04T18:12:59.536Z] [INFO]           "hunks": [
[2026-10-04T18:12:59.536Z] [INFO]             {
[2026-10-04T18:12:59.536Z] [INFO]               "oldStart": 1,
[2026-10-04T18:12:59.536Z] [INFO]               "oldLines": 33,
[2026-10-04T18:12:59.536Z] [INFO]               "newStart": 1,
[2026-10-04T18:12:59.536Z] [INFO]               "newLines": 0,
[2026-10-04T18:12:59.536Z] [INFO]               "lines": [
[2026-10-04T18:12:59.536Z] [INFO]                 "-// Measures how attaching links to one shared \"hub\" link scales in the C# united and split stores.",
[2026-10-04T18:12:59.536Z] [INFO]                 "-// Usage: dotnet run -c Release",
[2026-10-04T18:12:59.536Z] [INFO]                 "-// For each store, constants (internal-only or with external references), and hub side (source or target), creates",
[2026-10-04T18:12:59.536Z] [INFO]                 "-// n links (hub, new) or (new, hub) and prints the time per link for the last thousand links.",
[2026-10-04T18:12:59.536Z] [INFO]                 "-using System.Diagnostics;",
[2026-10-04T18:12:59.536Z] [INFO]                 "-using Comparisons.SQLiteVSDoublets;",
[2026-10-04T18:12:59.536Z] [INFO]                 "-using Platform.Data;",
[2026-10-04T18:12:59.536Z] [INFO]                 "-using Platform.Data.Doublets;",
[2026-10-04T18:12:59.536Z] [INFO]                 "-using Platform.Memory;",
[2026-10-04T18:12:59.536Z] [INFO]                 "-",
[2026-10-04T18:12:59.536Z] [INFO]                 "-foreach (var kind in new[] { \"united\", \"split\" })",
[2026-10-04T18:12:59.536Z] [INFO]                 "-foreach (var external in new[] { false, true })",
[2026-10-04T18:12:59.536Z] [INFO]                 "-foreach (var side in new[] { \"source\", \"target\" })",
[2026-10-04T18:12:59.536Z] [INFO]                 "-{",
[2026-10-04T18:12:59.536Z] [INFO]                 "-    var line = $\"{kind,-6} external={external,-5} hub={side,-6}:\";",
[2026-10-04T18:12:59.536Z] [INFO]                 "-    foreach (var n in new[] { 2_000, 8_000, 32_000 })",
[2026-10-04T18:12:59.536Z] [INFO]                 "-    {",
[2026-10-04T18:12:59.536Z] [INFO]                 "-        ILinks<ulong> links = kind == \"united\"",
[2026-10-04T18:12:59.536Z] [INFO]                 "-            ? Harness.United<ulong>(new HeapResizableDirectMemory(), external)",
[2026-10-04T18:12:59.536Z] [INFO]                 "-            : Harness.Split<ulong>(new HeapResizableDirectMemory(), new HeapResizableDirectMemory(), external);",
[2026-10-04T18:12:59.536Z] [INFO]                 "-        var hub = links.CreatePoint();",
[2026-10-04T18:12:59.536Z] [INFO]                 "-        var stopwatch = new Stopwatch();",
[2026-10-04T18:12:59.536Z] [INFO]                 "-        for (var i = 1; i <= n; i++)",
[2026-10-04T18:12:59.536Z] [INFO]                 "-        {",
[2026-10-04T18:12:59.536Z] [INFO]                 "-            var link = links.Create();",
[2026-10-04T18:12:59.536Z] [INFO]                 "-            if (i > n - 1000) stopwatch.Start();",
[2026-10-04T18:12:59.536Z] [INFO]                 "-            if (side == \"source\") links.Update(link, hub, link); else links.Update(link, link, hub);",
[2026-10-04T18:12:59.536Z] [INFO]                 "-            stopwatch.Stop();",
[2026-10-04T18:12:59.536Z] [INFO]                 "-        }",
[2026-10-04T18:12:59.536Z] [INFO]                 "-        line += $\" n={n}: {stopwatch.Elapsed.TotalNanoseconds / 1000,8:F0} ns\";",
[2026-10-04T18:12:59.536Z] [INFO]                 "-    }",
[2026-10-04T18:12:59.536Z] [INFO]                 "-    Console.WriteLine(line);",
[2026-10-04T18:12:59.536Z] [INFO]                 "-}"
[2026-10-04T18:12:59.536Z] [INFO]               ]
[2026-10-04T18:12:59.536Z] [INFO]             }
