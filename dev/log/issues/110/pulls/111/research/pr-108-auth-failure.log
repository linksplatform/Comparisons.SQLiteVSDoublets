[2026-10-04T17:13:51.453Z] [INFO]                 "+        Timed(timings, \"query_by_to\", expected, () => storage.Transaction(() =>",
[2026-10-04T17:13:51.453Z] [INFO]                 "+        {",
[2026-10-04T17:13:51.453Z] [INFO]                 "+            var tally = new Tally();",
[2026-10-04T17:13:51.453Z] [INFO]                 "+            foreach (var to in Scattered(n))",
[2026-10-04T17:13:51.453Z] [INFO]                 "+            {",
[2026-10-04T17:13:51.453Z] [INFO]                 "+                storage.EachWithTo(Int(to), link => tally.AddLink(link));",
