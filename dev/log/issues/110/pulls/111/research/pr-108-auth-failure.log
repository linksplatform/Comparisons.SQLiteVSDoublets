[2026-10-04T17:13:51.453Z] [INFO]                 "+            foreach (var from in Scattered(n))",
[2026-10-04T17:13:51.453Z] [INFO]                 "+            {",
[2026-10-04T17:13:51.453Z] [INFO]                 "+                storage.EachWithFrom(Int(from), link => tally.AddLink(link));",
[2026-10-04T17:13:51.453Z] [INFO]                 "+            }",
[2026-10-04T17:13:51.453Z] [INFO]                 "+            return tally;",
