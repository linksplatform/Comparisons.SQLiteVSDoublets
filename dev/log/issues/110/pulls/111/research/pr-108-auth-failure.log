[2026-10-04T17:54:56.492Z] [INFO]           "+def load(directory):",
[2026-10-04T17:54:56.492Z] [INFO]           "+    \"\"\"All reports in `directory`, keyed by (category, language, bits, size).\"\"\"",
[2026-10-04T17:54:56.492Z] [INFO]           "+    reports = {}",
[2026-10-04T17:54:56.492Z] [INFO]           "+    for path in sorted(Path(directory).glob(\"*.json\")):",
