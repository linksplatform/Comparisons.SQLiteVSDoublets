[2026-10-04T17:18:27.496Z] [INFO]                 "+    private static void RoundTrip<T>(IBlogPostsStorage<T> posts) where T : struct",
[2026-10-04T17:18:27.496Z] [INFO]                 "+    {",
[2026-10-04T17:18:27.496Z] [INFO]                 "+        using var _ = posts;",
[2026-10-04T17:18:27.496Z] [INFO]                 "+        var inputs = Enumerable.Range(1, 20).Select(i => BlogPost((ulong)i)).ToList();",
[2026-10-04T17:18:27.496Z] [INFO]                 "+        inputs.Add(new BlogPost(\"Ünïcödé 🌍 ✓\", \"a\", 0));",
[2026-10-04T17:18:27.496Z] [INFO]                 "+        inputs.Add(new BlogPost(\"\", \"ab\", uint.MaxValue / 2));",
[2026-10-04T17:18:27.496Z] [INFO]                 "+        var ids = inputs.Select(posts.Create).ToList();",
[2026-10-04T17:18:27.496Z] [INFO]                 "+        Assert.Equal(inputs, ids.Select(id => posts.Get(id)));",
[2026-10-04T17:18:27.496Z] [INFO]                 "+        var stored = new List<(T, BlogPost)>();",
[2026-10-04T17:18:27.496Z] [INFO]                 "+        posts.Each((id, post) => stored.Add((id, post)));",
[2026-10-04T17:18:27.496Z] [INFO]                 "+        Assert.Equal(ids.Zip(inputs), stored.OrderBy(entry => entry.Item1));",
[2026-10-04T17:18:27.496Z] [INFO]                 "+        ids.ForEach(posts.Delete);",
[2026-10-04T17:18:27.496Z] [INFO]                 "+        Assert.Equal(0UL, posts.Count());",
[2026-10-04T17:18:27.496Z] [INFO]                 "+    }",
