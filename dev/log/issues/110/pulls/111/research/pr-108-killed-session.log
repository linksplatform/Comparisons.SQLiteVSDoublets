          "content": "use doublets::{\n    Doublets,\n    data::{Flow, LinkReference},\n};\nuse rusqlite::{Connection, OptionalExtension, params};\nuse std::{marker::PhantomData, path::Path};\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct Link<T> {\n    pub id: T,\n    pub from: T,\n    pub to: T,\n}\n\npub trait LinksStorage<T> {\n    fn create(&mut self, from: T, to: T) -> T;\n    fn update(&mut self, id: T, from: T, to: T);\n    fn delete(&mut self, id: T);\n    fn get(&self, id: T) -> Option<Link<T>>;\n    fn search(&self, from: T, to: T) -> Option<T>;\n    fn each(&self, visit: impl FnMut(Link<T>));\n    fn each_with_from(&self, from: T, visit: impl FnMut(Link<T>));\n    fn each_with_to(&self, to: T, visit: impl FnMut(Link<T>));\n    fn count(&self) -> u64;\n\n    fn transaction<R>(&mut self, work: impl FnOnce(&mut Self) -> R) -> R {\n        work(self)\n    }\n}\n\npub struct SqliteLinks<T> {\n    connection: Connection,\n    id_type: PhantomData<T>,\n}\n\nimpl<T: LinkReference> SqliteLinks<T> {\n    pub fn open(path: impl AsRef<Path>) -> Self {\n        Self::new(Connection::open(path).unwrap())\n    }\n\n    pub fn in_memory() -> Self {\n        Self::new(Connection::open_in_memory().unwrap())\n    }\n\n    fn new(connection: Connection) -> Self {\n        connection\n            .execute_batch(\n                r#\"\n                CREATE TABLE links (id INTEGER PRIMARY KEY, \"from\" INTEGER NOT NULL, \"to\" INTEGER NOT NULL);\n                CREATE INDEX links_from_to ON links (\"from\", \"to\");\n                CREATE INDEX links_to_from ON links (\"to\", \"from\");\n                \"#,\n            )\n            .unwrap();\n        Self { connection, id_type: PhantomData }\n    }\n\n    fn each_where(&self, sql: &str, parameters: impl rusqlite::Params, mut visit: impl FnMut(Link<T>)) {\n        let mut statement = self.connection.prepare_cached(sql).unwrap();\n        let mut rows = statement.query(parameters).unwrap();\n        while let Some(row) = rows.next().unwrap() {\n            visit(Link { id: id(row.get(0).unwrap()), from: id(row.get(1).unwrap()), to: id(row.get(2).unwrap()) });\n        }\n    }\n}\n\nfn sql<T: LinkReference>(id: T) -> i64 {\n    id.try_into().unwrap()\n}\n\nfn id<T: LinkReference>(sql: i64) -> T {\n    T::try_from(sql).unwrap()\n}\n\nimpl<T: LinkReference> LinksStorage<T> for SqliteLinks<T> {\n    fn create(&mut self, from: T, to: T) -> T {\n        let mut statement = self.connection.prepare_cached(r#\"INSERT INTO links (\"from\", \"to\") VALUES (?1, ?2)\"#).unwrap();\n        statement.execute(params![sql(from), sql(to)]).unwrap();\n        id(self.connection.last_insert_rowid())\n    }\n\n    fn update(&mut self, link: T, from: T, to: T) {\n        let mut statement = self.connection.prepare_cached(r#\"UPDATE links SET \"from\" = ?2, \"to\" = ?3 WHERE id = ?1\"#).unwrap();\n        statement.execute(params![sql(link), sql(from), sql(to)]).unwrap();\n    }\n\n    fn delete(&mut self, link: T) {\n        let mut statement = self.connection.prepare_cached(\"DELETE FROM links WHERE id = ?1\").unwrap();\n        statement.execute([sql(link)]).unwrap();\n    }\n\n    fn get(&self, link: T) -> Option<Link<T>> {\n        let mut statement = self.connection.prepare_cached(r#\"SELECT \"from\", \"to\" FROM links WHERE id = ?1\"#).unwrap();\n        statement\n            .query_row([sql(link)], |row| Ok(Link { id: link, from: id(row.get(0)?), to: id(row.get(1)?) }))\n            .optional()\n            .unwrap()\n    }\n\n    fn search(&self, from: T, to: T) -> Option<T> {\n        let mut statement = self.connection.prepare_cached(r#\"SELECT id FROM links WHERE \"from\" = ?1 AND \"to\" = ?2\"#).unwrap();\n        statement.query_row([sql(from), sql(to)], |row| row.get(0).map(id)).optional().unwrap()\n    }\n\n    fn each(&self, visit: impl FnMut(Link<T>)) {\n        self.each_where(r#\"SELECT id, \"from\", \"to\" FROM links\"#, [], visit);\n    }\n\n    fn each_with_from(&self, from: T, visit: impl FnMut(Link<T>)) {\n        self.each_where(r#\"SELECT id, \"from\", \"to\" FROM links WHERE \"from\" = ?1\"#, [sql(from)], visit);\n    }\n\n    fn each_with_to(&self, to: T, visit: impl FnMut(Link<T>)) {\n        self.each_where(r#\"SELECT id, \"from\", \"to\" FROM links WHERE \"to\" = ?1\"#, [sql(to)], visit);\n    }\n\n    fn count(&self) -> u64 {\n        self.connection.query_row(\"SELECT COUNT(*) FROM links\", [], |row| row.get(0)).unwrap()\n    }\n\n    fn transaction<R>(&mut self, work: impl FnOnce(&mut Self) -> R) -> R {\n        self.connection.execute_batch(\"BEGIN\").unwrap();\n        let result = work(self);\n        self.connection.execute_batch(\"COMMIT\").unwrap();\n        result\n    }\n}\n\nfn link<T: LinkReference>(link: doublets::Link<T>) -> Link<T> {\n    Link { id: link.index, from: link.source, to: link.target }\n}\n\nimpl<T: LinkReference, D: Doublets<T>> LinksStorage<T> for D {\n    fn create(&mut self, from: T, to: T) -> T {\n        self.create_link(from, to).unwrap()\n    }\n\n    fn update(&mut self, id: T, from: T, to: T) {\n        Doublets::update(self, id, from, to).unwrap();\n    }\n\n    fn delete(&mut self, id: T) {\n        Doublets::delete(self, id).unwrap();\n    }\n\n    fn get(&self, id: T) -> Option<Link<T>> {\n        self.get_link(id).map(link)\n    }\n\n    fn search(&self, from: T, to: T) -> Option<T> {\n        Doublets::search(self, from, to)\n    }\n\n    fn each(&self, mut visit: impl FnMut(Link<T>)) {\n        Doublets::each(self, |found| {\n            visit(link(found));\n            Flow::Continue\n        });\n    }\n\n    fn each_with_from(&self, from: T, mut visit: impl FnMut(Link<T>)) {\n        let any = self.constants().any;\n        self.each_by([any, from, any], |found| {\n            visit(link(found));\n            Flow::Continue\n        });\n    }\n\n    fn each_with_to(&self, to: T, mut visit: impl FnMut(Link<T>)) {\n        let any = self.constants().any;\n        self.each_by([any, any, to], |found| {\n            visit(link(found));\n            Flow::Continue\n        });\n    }\n\n    fn count(&self) -> u64 {\n        Doublets::count(self).try_into().unwrap()\n    }\n}\n"
