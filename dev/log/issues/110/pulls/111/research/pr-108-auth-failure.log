[2026-10-04T17:58:18.679Z] [INFO]               "newLines": 66,
[2026-10-04T17:58:18.679Z] [INFO]               "lines": [
[2026-10-04T17:58:18.679Z] [INFO]                 "+// Profiles which ILinks calls make C# Doublets blog post creation grow with the number of stored posts.",
[2026-10-04T17:58:18.679Z] [INFO]                 "+// Usage: dotnet run -c Release -- <united|split> <n>",
[2026-10-04T17:58:18.679Z] [INFO]                 "+// Wraps the store in a decorator that counts and times Each, Count, Create, Update and Delete calls and",
[2026-10-04T17:58:18.679Z] [INFO]                 "+// prints them per created post for the first and the last tenth of the posts.",
[2026-10-04T17:58:18.679Z] [INFO]                 "+using System.Diagnostics;",
[2026-10-04T17:58:18.679Z] [INFO]                 "+using Comparisons.SQLiteVSDoublets;",
[2026-10-04T17:58:18.679Z] [INFO]                 "+using Platform.Data;",
[2026-10-04T17:58:18.679Z] [INFO]                 "+using Platform.Data.Doublets;",
[2026-10-04T17:58:18.679Z] [INFO]                 "+using Platform.Memory;",
[2026-10-04T17:58:18.679Z] [INFO]                 "+",
[2026-10-04T17:58:18.679Z] [INFO]                 "+var kind = args[0];",
[2026-10-04T17:58:18.679Z] [INFO]                 "+var n = int.Parse(args[1]);",
[2026-10-04T17:58:18.679Z] [INFO]                 "+ILinks<ulong> store = kind == \"united\"",
[2026-10-04T17:58:18.679Z] [INFO]                 "+    ? Harness.United<ulong>(new HeapResizableDirectMemory(), external: true)",
[2026-10-04T17:58:18.679Z] [INFO]                 "+    : Harness.Split<ulong>(new HeapResizableDirectMemory(), new HeapResizableDirectMemory(), external: true);",
[2026-10-04T17:58:18.679Z] [INFO]                 "+var profiled = new Profiled(store);",
[2026-10-04T17:58:18.679Z] [INFO]                 "+var posts = new DoubletsBlogPosts<ulong>(profiled, cacheSequences: true);",
[2026-10-04T17:58:18.679Z] [INFO]                 "+var tenth = n / 10;",
[2026-10-04T17:58:18.679Z] [INFO]                 "+for (var i = 1; i <= n; i++)",
[2026-10-04T17:58:18.679Z] [INFO]                 "+{",
[2026-10-04T17:58:18.679Z] [INFO]                 "+    if (i == 1 || i == n - tenth + 1)",
[2026-10-04T17:58:18.679Z] [INFO]                 "+    {",
[2026-10-04T17:58:18.679Z] [INFO]                 "+        profiled.Reset();",
[2026-10-04T17:58:18.679Z] [INFO]                 "+    }",
[2026-10-04T17:58:18.679Z] [INFO]                 "+    posts.Create(Dataset.BlogPost((ulong)i));",
[2026-10-04T17:58:18.679Z] [INFO]                 "+    if (i == tenth || i == n)",
[2026-10-04T17:58:18.679Z] [INFO]                 "+    {",
[2026-10-04T17:58:18.679Z] [INFO]                 "+        Console.WriteLine($\"{kind} posts {i - tenth + 1}..{i}: {profiled.Report(tenth)}\");",
[2026-10-04T17:58:18.679Z] [INFO]                 "+    }",
[2026-10-04T17:58:18.679Z] [INFO]                 "+}",
[2026-10-04T17:58:18.679Z] [INFO]                 "+",
[2026-10-04T17:58:18.679Z] [INFO]                 "+sealed class Profiled(ILinks<ulong> links) : ILinks<ulong>",
[2026-10-04T17:58:18.679Z] [INFO]                 "+{",
[2026-10-04T17:58:18.679Z] [INFO]                 "+    private readonly Dictionary<string, (long Calls, TimeSpan Time)> _calls = [];",
[2026-10-04T17:58:18.679Z] [INFO]                 "+",
[2026-10-04T17:58:18.679Z] [INFO]                 "+    public LinksConstants<ulong> Constants => links.Constants;",
[2026-10-04T17:58:18.679Z] [INFO]                 "+",
[2026-10-04T17:58:18.679Z] [INFO]                 "+    public void Reset() => _calls.Clear();",
[2026-10-04T17:58:18.679Z] [INFO]                 "+",
[2026-10-04T17:58:18.679Z] [INFO]                 "+    public string Report(int posts) => string.Join(\", \", _calls.Select(call =>",
[2026-10-04T17:58:18.679Z] [INFO]                 "+        $\"{call.Key} {(double)call.Value.Calls / posts:F1} calls {call.Value.Time.TotalNanoseconds / posts:F0} ns\"));",
[2026-10-04T17:58:18.679Z] [INFO]                 "+",
[2026-10-04T17:58:18.679Z] [INFO]                 "+    private TResult Timed<TResult>(string name, Func<TResult> work)",
[2026-10-04T17:58:18.679Z] [INFO]                 "+    {",
[2026-10-04T17:58:18.679Z] [INFO]                 "+        var stopwatch = Stopwatch.StartNew();",
[2026-10-04T17:58:18.679Z] [INFO]                 "+        var result = work();",
[2026-10-04T17:58:18.679Z] [INFO]                 "+        var (calls, time) = _calls.GetValueOrDefault(name);",
[2026-10-04T17:58:18.679Z] [INFO]                 "+        _calls[name] = (calls + 1, time + stopwatch.Elapsed);",
[2026-10-04T17:58:18.679Z] [INFO]                 "+        return result;",
[2026-10-04T17:58:18.679Z] [INFO]                 "+    }",
[2026-10-04T17:58:18.679Z] [INFO]                 "+",
[2026-10-04T17:58:18.679Z] [INFO]                 "+    private static string Shape(IList<ulong>? restriction, ulong any) =>",
[2026-10-04T17:58:18.679Z] [INFO]                 "+        restriction is null ? \"null\" : string.Concat(restriction.Select(value => value == any ? \"*\" : \"v\"));",
[2026-10-04T17:58:18.679Z] [INFO]                 "+",
[2026-10-04T17:58:18.679Z] [INFO]                 "+    public ulong Count(IList<ulong>? restriction) => Timed($\"Count[{Shape(restriction, Constants.Any)}]\", () => links.Count(restriction));",
[2026-10-04T17:58:18.679Z] [INFO]                 "+",
[2026-10-04T17:58:18.679Z] [INFO]                 "+    public ulong Each(IList<ulong>? restriction, ReadHandler<ulong>? handler) =>",
[2026-10-04T17:58:18.679Z] [INFO]                 "+        Timed($\"Each[{Shape(restriction, Constants.Any)}]\", () => links.Each(restriction, handler));",
[2026-10-04T17:58:18.679Z] [INFO]                 "+",
[2026-10-04T17:58:18.679Z] [INFO]                 "+    public ulong Create(IList<ulong>? substitution, WriteHandler<ulong>? handler) => Timed(\"Create\", () => links.Create(substitution, handler));",
[2026-10-04T17:58:18.679Z] [INFO]                 "+",
[2026-10-04T17:58:18.679Z] [INFO]                 "+    public ulong Update(IList<ulong>? restriction, IList<ulong>? substitution, WriteHandler<ulong>? handler) =>",
[2026-10-04T17:58:18.679Z] [INFO]                 "+        Timed(\"Update\", () => links.Update(restriction, substitution, handler));",
[2026-10-04T17:58:18.679Z] [INFO]                 "+",
[2026-10-04T17:58:18.679Z] [INFO]                 "+    public ulong Delete(IList<ulong>? restriction, WriteHandler<ulong>? handler) => Timed(\"Delete\", () => links.Delete(restriction, handler));",
[2026-10-04T17:58:18.679Z] [INFO]                 "+}"
[2026-10-04T17:58:18.679Z] [INFO]               ]
[2026-10-04T17:58:18.679Z] [INFO]             }
