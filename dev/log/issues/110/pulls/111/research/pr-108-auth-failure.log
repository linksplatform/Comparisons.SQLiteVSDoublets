[2026-10-04T18:24:47.337Z] [INFO]         "input": {
[2026-10-04T18:24:47.337Z] [INFO]           "command": "python3 - <<'EOF'\nfrom pathlib import Path\npath = Path(\"scripts/benchmark_report.py\")\ntext = path.read_text(encoding=\"utf-8\")\nold_doc = '''    \"\"\"How `measured` compares with `reference`.\n\n    Overlapping sample ranges and medians within NOISE of each other (single samples have no range)\n    are not called a difference.\n    \"\"\"\n    overlapping = measured[\"min_ns\"] <= reference[\"max_ns\"] and reference[\"min_ns\"] <= measured[\"max_ns\"]\n'''\nnew_doc = '''    \"\"\"How `measured` compares with `reference`.\n\n    Overlapping interquartile ranges and medians within NOISE of each other (single samples have no range)\n    are not called a difference.\n    \"\"\"\n    (low, high), (reference_low, reference_high) = quartiles(measured), quartiles(reference)\n    overlapping = low <= reference_high and reference_low <= high\n'''\nassert old_doc in text\ntext = text.replace(old_doc, new_doc)\nanchor = \"def comparison(measured, reference, text):\"\ntext = text.replace(anchor, '''def quartiles(measured):\n    \"\"\"The middle half of the samples: unlike the full range, one outlier repetition does not widen it.\"\"\"\n    samples = measured[\"samples_ns\"]\n    if len(samples) == 1:\n        return samples[0], samples[0]\n    first, _, third = statistics.quantiles(samples, n=4, method=\"inclusive\")\n    return first, third\n\n\n''' + anchor)\ntext = text.replace(\"import re\\n\", \"import re\\nimport statistics\\n\")\npath.write_text(text, encoding=\"utf-8\")\n\npath = Path(\"scripts/test_benchmark_report.py\")\ntext = path.read_text(encoding=\"utf-8\")\nold = '''def measurement(median, low=None, high=None):\n    low = median if low is None else low\n    high = median if high is None else high\n    return {\"median_ns\": median, \"min_ns\": low, \"max_ns\": high, \"samples_ns\": [low, median, high]}\n'''\nnew = '''def measurement(median, *samples):\n    samples = sorted(samples or [median])\n    return {\"median_ns\": median, \"min_ns\": samples[0], \"max_ns\": samples[-1], \"samples_ns\": samples}\n'''\nassert old in text\ntext = text.replace(old, new)\nold = '''    def test_overlapping_ranges_are_not_a_difference(self):\n        self.assertEqual(report.comparison(measurement(100, 90, 300), measurement(250, 200, 260), self.text), \"≈ same\")\n'''\nnew = '''    def test_overlapping_interquartile_ranges_are_not_a_difference(self):\n        measured, reference = measurement(150, 90, 100, 200, 300), measurement(220, 180, 210, 230, 260)\n        self.assertEqual(report.quartiles(measured), (100, 200))\n        self.assertEqual(report.comparison(measured, reference, self.text), \"≈ same\")\n\n    def test_outlier_repetitions_do_not_hide_a_difference(self):\n        # C# objects, 1,000 blog posts, read by id: Doublets Split NonVolatile Cached vs SQLite File (µs).\n        doublets = measurement(3.75, 2.1, 2.6, 2.7, 3.1, 3.5, 4.0, 5.1, 6.3, 15.7, 23.0)\n        sqlite = measurement(19.0, 5.7, 11.4, 16.9, 17.6, 18.2, 19.8, 20.6, 28.2, 29.1, 90.9)\n        self.assertEqual(report.comparison(doublets, sqlite, self.text), \"5.07× faster\")\n'''\nassert old in text\ntext = text.replace(old, new)\npath.write_text(text, encoding=\"utf-8\")\nEOF\ncd scripts && python3 -m unittest discover -s . 2>&1 | tail -5",
