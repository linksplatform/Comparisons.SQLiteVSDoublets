        "content": "# with all versions of Cargo and also rewrite `path` dependencies\n# to registry (e.g., crates.io) dependencies.\n#\n# If you are reading this file be aware that the original Cargo.toml\n# will likely look very different (and much more reasonable).\n# See Cargo.toml.orig for the original contents.\n\n[features]\ndata = []\ndefault = [\"platform\"]\nfull = [\n    \"platform\",\n    \"rayon\",\n    \"small-search\",\n]\nmem = []\nmore-inline = []\nnum = []\nplatform = [\n    \"mem\",\n    \"num\",\n    \"data\",\n]\nsmall-search = [\"smallvec\"]\n\n[lib]\nname = \"doublets\"\npath = \"src/lib.rs\"\n\n[[example]]\nname = \"uniqueness\"\npath = \"examples/uniqueness.rs\"\n\n[[test]]\nname = \"decorators\"\npath = \"tests/decorators.rs\"\n\n[[test]]\nname = \"doublet\"\npath = \"tests/doublet.rs\"\n\n[[test]]\nname = \"doublets\"\npath = \"tests/doublets.rs\"\n\n[[test]]\nname = \"dyn\"\npath = \"tests/dyn.rs\"\n\n[[test]]\nname = \"error\"\npath = \"tests/error.rs\"\n\n[[test]]\nname = \"expansion\"\npath = \"tests/expansion.rs\"\n\n[[test]]\nname = \"extensions\"\npath = \"tests/extensions.rs\"\n\n[[test]]\nname = \"handler\"\npath = \"tests/handler.rs\"\n\n[[test]]\nname = \"iter\"\npath = \"tests/iter.rs\"\n\n[[test]]\nname = \"link\"\npath = \"tests/link.rs\"\n\n[[test]]\nname = \"mem\"\npath = \"tests/mem.rs\"\n\n[[test]]\nname = \"multi\"\npath = \"tests/multi.rs\"\n\n[[test]]\nname = \"query_tests\"\npath = \"tests/query_tests.rs\"\n\n[[test]]\nname = \"seq\"\npath = \"tests/seq.rs\"\n\n[[test]]\nname = \"store_internals\"\npath = \"tests/store_internals.rs\"\n\n[[test]]\nname = \"traits\"\npath = \"tests/traits.rs\"\n\n[[test]]\nname = \"type_parts\"\npath = \"tests/type_parts.rs\"\n\n[[test]]\nname = \"write_handlers\"\npath = \"tests/write_handlers.rs\"\n\n[[bench]]\nname = \"iter\"\npath = \"benches/iter.rs\"\nharness = false\n\n[dependencies.cfg-if]\n[dependencies.cfg-if]\nversion = \"1\"\nversion = \"1\"\n\n\n[dependencies.data]\n[dependencies.data]\nversion = \"2.0.0\"\nversion = \"2.0.0\"\npackage = \"platform-data\"\npackage = \"platform-data\"\n\n\n[dependencies.leak_slice]\n[dependencies.leak_slice]\nversion = \"0.2\"\nversion = \"0.2\"\n\n\n[dependencies.mem]\n[dependencies.mem]\nversion = \"0.3.0\"\nversion = \"0.3.0\"\npackage = \"platform-mem\"\npackage = \"platform-mem\"\n\n\n[dependencies.num]\n[dependencies.num]\nversion = \"0.8.0\"\nversion = \"0.8.0\"\npackage = \"platform-num\"\npackage = \"platform-num\"\n\n\n[dependencies.rayon]\n[dependencies.rayon]\nversion = \"1\"\nversion = \"1\"\noptional = true\noptional = true\n\n[dependencies.smallvec]\n[dependencies.smallvec]\nversion = \"1\"\nversion = \"1\"\nfeatures = [\"union\"]\nfeatures = [\"union\"]\noptional = true\noptional = true\n\n\n[dependencies.tap]\n[dependencies.tap]\nversion = \"1\"\nversion = \"1\"\n\n[dependencies.thiserror]\n[dependencies.thiserror]\nversion = \"2\"\nversion = \"2\"\n\n\n[dependencies.trees]\n[dependencies.trees]\nversion = \"0.3.4\"\nversion = \"0.3.4\"\npackage = \"platform-trees\"\npackage = \"platform-trees\"\n\n\n[dev-dependencies.criterion]\n[dev-dependencies.criterion]\nversion = \"0.5\"\nversion = \"0.5\"\n\n\n[dev-dependencies.mimalloc]\n[dev-dependencies.mimalloc]\nversion = \"0.1\"\nversion = \"0.1\"\ndefault-features = false\ndefault-features = false\n\n\n[dev-dependencies.rand]\n[dev-dependencies.rand]\nversion = \"0.8\"\nversion = \"0.8\"\n\n\n[dev-dependencies.smallvec]\n[dev-dependencies.smallvec]\nversion = \"1\"\nversion = \"1\"\n\n\n[dev-dependencies.static_assertions]\n[dev-dependencies.static_assertions]\nversion = \"1\"\n\n[dev-dependencies.tap]\n[dev-dependencies.tap]\nversion = \"1\"\nversion = \"1\"\n\n\n[dev-dependencies.tinyvec]\n[dev-dependencies.tinyvec]\nversion = \"1\"\nversion = \"1\"\nfeatures = [\"alloc\"]\nfeatures = [\"alloc\"]\n\n\n[lints.clippy]\ncomparison_chain = \"allow\"\nmissing_const_for_fn = \"allow\"\nmissing_errors_doc = \"allow\"\nmissing_panics_doc = \"allow\"\nmissing_safety_doc = \"allow\"\nmodule_name_repetitions = \"allow\"\nneedless_pass_by_value = \"allow\"\ntoo_many_lines = \"allow\"\n\n[lints.clippy.all]\nlevel = \"warn\"\npriority = -1\n\n[lints.clippy.nursery]\nlevel = \"warn\"\npriority = -1\n\n[lints.clippy.pedantic]\nlevel = \"warn\"\npriority = -1\n\n[lints.rust]\nunsafe_code = \"allow\"\n\n[profile.release]\nlto = true\ncodegen-units = 1\nstrip = true\n//! Low-level memory management with pluggable backends.\n//!\n//! `platform-mem` provides a unified [`RawMem`] trait that abstracts over\n//! different memory storage strategies: heap allocators, memory-mapped files,\n//! and temporary files. Code written against [`RawMem`] works with any backend.\n//!\n//! # Backends\n//!\n//! | Type | Storage | Use case |\n//! |------|---------|----------|\n//! | [`Global<T>`] | Rust global allocator | General-purpose in-memory storage |\n//! | [`System<T>`] | System allocator | When you need the OS allocator specifically |\n//! | [`Alloc<T, A>`] | Any [`Allocator`](allocator_api2::alloc::Allocator) | Custom allocator strategies |\n//! | [`FileMapped<T>`] | Memory-mapped file | Persistent storage, large datasets |\n//! | [`TempFile<T>`] | Temporary mmap file | Anonymous storage cleaned on drop |\n//! | [`AsyncFileMem<T>`](async_mem::AsyncFileMem) | Async mmap via I/O thread | Non-blocking file-backed storage (requires `async` feature) |\n//!\n//! # Quick start\n//!\n//! ```\n//! use platform_mem::{Global, RawMem};\n//!\n//! let mut mem = Global::<u64>::new();\n//! mem.grow_filled(3, 42).unwrap();\n//! assert_eq!(mem.allocated(), &[42, 42, 42]);\n//!\n//! mem.grow_from_slice(&[1, 2, 3]).unwrap();\n//! assert_eq!(mem.allocated(), &[42, 42, 42, 1, 2, 3]);\n//!\n//! mem.shrink(2).unwrap();\n//! assert_eq!(mem.allocated(), &[42, 42, 42, 1]);\n//! ```\n//!\n//! # Type erasure\n//!\n//! Use [`ErasedMem`] to work with heterogeneous memory backends via dynamic dispatch:\n//!\n//! ```\n//! use platform_mem::{Global, ErasedMem, RawMem};\n//!\n//! fn use_any_mem(mem: &mut Box<dyn ErasedMem<Item = u64>>) {\n//!     mem.grow_filled(5, 0).unwrap();\n//! }\n//!\n//! let mut mem: Box<dyn ErasedMem<Item = u64>> = Box::new(Global::<u64>::new());\n//! use_any_mem(&mut mem);\n//! assert_eq!(mem.allocated().len(), 5);\n//! ```\n//!\n//! # Features\n//!\n//! - **`async`** — enables [`AsyncFileMem`] for non-blocking\n//!   file-backed memory via a dedicated I/O thread (requires tokio).\n\n// special lint\n#![cfg_attr(not(test), forbid(clippy::unwrap_used))]\n// rust compiler lints\n#![deny(unused_must_use)]\n#![warn(missing_docs, missing_debug_implementations)]\n\n        /// Creates a new empty `System` memory.\n        pub const fn new() -> Self {\n            Self(Alloc::new(SystemAlloc))\n        }\n    }\n\n    /// Temporary file-backed memory-mapped storage.\n    ///\n    /// Data is stored in an anonymous temporary file that is automatically\n    /// cleaned up when the `TempFile` is dropped.\n    TempFile<T>(FileMapped<T>) {\n        /// Creates a new temporary file-backed memory.\n        pub fn new() -> io::Result<Self> {\n            Self::from_temp(tempfile::tempfile())\n        }\n\n        /// Creates a new temporary file-backed memory in the specified directory.\n        pub fn new_in<P: AsRef<Path>>(path: P) -> io::Result<Self> {\n            Self::from_temp(tempfile::tempfile_in(path))\n        }\n\n        fn from_temp(file: io::Result<File>) -> io::Result<Self> {\n            file.and_then(FileMapped::new).map(Self)\n        }\n    }\n}\n\nimpl<T> Default for Global<T> {\n    fn default() -> Self {\n        Self::new()\n    }",
