[2026-10-05T01:05:15.857Z] [INFO]         "input": {
[2026-10-05T01:05:15.857Z] [INFO]           "command": "mkdir -p /tmp/gh-issue-solver-1791159559061/experiments/sqlite_returning && cd /tmp/gh-issue-solver-1791159559061/experiments/sqlite_returning && cat > Cargo.toml <<'E'\n[package]\nname = \"sqlite-returning\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[dependencies]\nrusqlite = { version = \"0.40.2\", features = [\"bundled\"] }\n\n[workspace]\nE\nmkdir -p src && cat > src/main.rs <<'E'\n//! Times 100,000 inserts of a blog post in one transaction with each way of getting the new id.\nuse rusqlite::Connection;\nuse std::time::Instant;\n\nconst N: i64 = 100_000;\n\nfn main() {\n    let content = \"Lorem ipsum \".repeat(60);\n    for (name, sql) in [\n        (\"execute + last_insert_rowid\", \"INSERT INTO posts (title, content) VALUES (?1, ?2)\"),\n        (\"query_row RETURNING id\", \"INSERT INTO posts (title, content) VALUES (?1, ?2) RETURNING id\"),\n        (\"query + drain RETURNING id\", \"INSERT INTO posts (title, content) VALUES (?1, ?2) RETURNING id\"),\n    ] {\n        for _ in 0..3 {\n            let connection = Connection::open_in_memory().unwrap();\n            connection\n                .execute_batch(\"CREATE TABLE posts (id INTEGER PRIMARY KEY, title TEXT NOT NULL, content TEXT NOT NULL); BEGIN IMMEDIATE\")\n                .unwrap();\n            let mut statement = connection.prepare_cached(sql).unwrap();\n            let start = Instant::now();\n            for i in 1..=N {\n                let title = format!(\"Blog post {i}\");\n                let id: i64 = match name {\n                    \"execute + last_insert_rowid\" => {\n                        statement.execute((&title, &content)).unwrap();\n                        connection.last_insert_rowid()\n                    }\n                    \"query_row RETURNING id\" => statement.query_row((&title, &content), |row| row.get(0)).unwrap(),\n                    _ => {\n                        let mut rows = statement.query((&title, &content)).unwrap();\n                        let id = rows.next().unwrap().unwrap().get(0).unwrap();\n                        assert!(rows.next().unwrap().is_none());\n                        id\n                    }\n                };\n                assert_eq!(id, i);\n            }\n            println!(\"{name}: {:.0} ns/insert\", start.elapsed().as_nanos() as f64 / N as f64);\n        }\n    }\n}\nE\ncargo run --release -q 2>&1 | tail -12",
