[2026-10-04T16:46:33.776Z] [INFO]                 "-            },",
[2026-10-04T16:46:33.776Z] [INFO]                 "-        );",
[2026-10-04T16:46:33.776Z] [INFO]                 "-    };",
[2026-10-04T16:46:33.776Z] [INFO]                 "-}",
[2026-10-04T16:46:33.776Z] [INFO]                 "-",
[2026-10-04T16:46:33.776Z] [INFO]                 "-/// Measures one operation on every subject of the comparison.",
[2026-10-04T16:46:33.776Z] [INFO]                 "-///",
[2026-10-04T16:46:33.776Z] [INFO]                 "-/// `$prepare` and `$operation` are repeated for each subject, so that both",
