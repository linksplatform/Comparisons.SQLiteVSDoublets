[2026-10-04T16:29:06.866Z] [INFO]         "type": "tool_result",
[2026-10-04T16:29:06.866Z] [INFO]         "content": "1\t//! SQLite implementation for links storage\n2\t\n3\tuse crate::{BlogPost, Link, Links, Objects};\n4\tuse rusqlite::{params, Connection};\n5\tuse std::path::Path;\n6\t\n7\t/// SQLite-based links storage\n8\tpub struct SqliteLinks {\n9\t    conn: Connection,\n10\t    next_id: u64,\n11\t}\n12\t\n13\timpl SqliteLinks {\n14\t    /// Create a new SQLite links storage with in-memory database\n15\t    pub fn new_memory() -> Self {\n16\t        let conn = Connection::open_in_memory().expect(\"Failed to open in-memory SQLite database\");\n17\t        Self::init(conn)\n18\t    }\n19\t\n20\t    /// Create a new SQLite links storage with file-based database\n21\t    pub fn new_file<P: AsRef<Path>>(path: P) -> Self {\n22\t        let conn = Connection::open(path).expect(\"Failed to open SQLite database file\");\n23\t        Self::init(conn)\n24\t    }\n25\t\n26\t    fn init(conn: Connection) -> Self {\n27\t        Self::create_schema(&conn);\n28\t\n29\t        // Get the max ID to continue from\n30\t        let next_id: u64 = conn\n31\t            .query_row(\"SELECT COALESCE(MAX(id), 0) + 1 FROM links\", [], |row| {\n32\t                row.get(0)\n33\t            })\n34\t            .unwrap_or(1);\n35\t\n36\t        Self { conn, next_id }\n37\t    }\n38\t\n39\t    /// Creates the tables and the indexes used by the benchmarks.\n40\t    ///\n41\t    /// `links` stores the link related benchmark data, `blog_posts` stores the\n42\t    /// object like structures — the same shape the C# benchmark stores through\n43\t    /// Entity Framework Core (a primary key, a unique title, a content and a\n44\t    /// publication date).\n45\t    fn create_schema(conn: &Connection) {\n46\t        conn.execute_batch(\n47\t            \"CREATE TABLE IF NOT EXISTS links (\n48\t                id INTEGER PRIMARY KEY,\n49\t                source INTEGER NOT NULL,\n50\t                target INTEGER NOT NULL\n51\t            );\n52\t            CREATE INDEX IF NOT EXISTS idx_source ON links(source);\n53\t            CREATE INDEX IF NOT EXISTS idx_target ON links(target);\n54\t            CREATE INDEX IF NOT EXISTS idx_source_target ON links(source, target);\n55\t            CREATE TABLE IF NOT EXISTS blog_posts (\n56\t                id INTEGER PRIMARY KEY,\n57\t                title TEXT NOT NULL,\n58\t                content TEXT NOT NULL,\n59\t                publication_date_time INTEGER NOT NULL\n60\t            );\n61\t            CREATE UNIQUE INDEX IF NOT EXISTS idx_blog_posts_title ON blog_posts(title);\",\n62\t        )\n63\t        .expect(\"Failed to create the benchmark schema\");\n64\t    }\n65\t\n66\t    /// Drop all tables and recreate them\n67\t    pub fn reset(&mut self) {\n68\t        self.conn\n69\t            .execute_batch(\n70\t                \"DROP TABLE IF EXISTS links;\n71\t                DROP TABLE IF EXISTS blog_posts;\",\n72\t            )\n73\t            .expect(\"Failed to drop the benchmark tables\");\n74\t        Self::create_schema(&self.conn);\n75\t        self.next_id = 1;\n76\t    }\n77\t}\n78\t\n79\timpl Links for SqliteLinks {\n80\t    fn create(&mut self, source: u64, target: u64) -> u64 {\n81\t        let id = self.next_id;\n82\t        self.conn\n83\t            .execute(\n84\t                \"INSERT INTO links (id, source, target) VALUES (?1, ?2, ?3)\",\n85\t                params![id as i64, source as i64, target as i64],\n86\t            )\n87\t            .expect(\"Failed to insert link\");\n88\t        self.next_id += 1;\n89\t        id\n90\t    }\n91\t\n92\t    fn update(&mut self, id: u64, source: u64, target: u64) {\n93\t        self.conn\n94\t            .execute(\n95\t                \"UPDATE links SET source = ?1, target = ?2 WHERE id = ?3\",\n96\t                params![source as i64, target as i64, id as i64],\n97\t            )\n98\t            .expect(\"Failed to update link\");\n99\t    }\n100\t\n101\t    fn delete(&mut self, id: u64) {\n102\t        self.conn\n103\t            .execute(\"DELETE FROM links WHERE id = ?1\", params![id as i64])\n104\t            .expect(\"Failed to delete link\");\n105\t    }\n106\t\n107\t    fn delete_all(&mut self) {\n108\t        self.conn\n109\t            .execute(\"DELETE FROM links\", [])\n110\t            .expect(\"Failed to delete all links\");\n111\t        self.next_id = 1;\n112\t    }\n113\t\n114\t    fn query_all(&self) -> Vec<Link> {\n115\t        let mut stmt = self\n116\t            .conn\n117\t            .prepare(\"SELECT id, source, target FROM links\")\n118\t            .expect(\"Failed to prepare query\");\n119\t\n120\t        stmt.query_map([], |row| {\n121\t            Ok(Link {\n122\t                id: row.get::<_, i64>(0)? as u64,\n123\t                source: row.get::<_, i64>(1)? as u64,\n124\t                target: row.get::<_, i64>(2)? as u64,\n125\t            })\n126\t        })\n127\t        .expect(\"Failed to query links\")\n128\t        .filter_map(|r| r.ok())\n129\t        .collect()\n130\t    }\n131\t\n132\t    fn query_by_id(&self, id: u64) -> Option<Link> {\n133\t        self.conn\n134\t            .query_row(\n135\t                \"SELECT id, source, target FROM links WHERE id = ?1\",\n136\t                params![id as i64],\n137\t                |row| {\n138\t                    Ok(Link {\n139\t                        id: row.get::<_, i64>(0)? as u64,\n140\t                        source: row.get::<_, i64>(1)? as u64,\n141\t                        target: row.get::<_, i64>(2)? as u64,\n142\t                    })\n143\t                },\n144\t            )\n145\t            .ok()\n146\t    }\n147\t\n148\t    fn query_by_source(&self, source: u64) -> Vec<Link> {\n149\t        let mut stmt = self\n150\t            .conn\n151\t            .prepare(\"SELECT id, source, target FROM links WHERE source = ?1\")\n152\t            .expect(\"Failed to prepare query\");\n153\t\n154\t        stmt.query_map(params![source as i64], |row| {\n155\t            Ok(Link {\n156\t                id: row.get::<_, i64>(0)? as u64,\n157\t                source: row.get::<_, i64>(1)? as u64,\n158\t                target: row.get::<_, i64>(2)? as u64,\n159\t            })\n160\t        })\n161\t        .expect(\"Failed to query links\")\n162\t        .filter_map(|r| r.ok())\n163\t        .collect()\n164\t    }\n165\t\n166\t    fn query_by_target(&self, target: u64) -> Vec<Link> {\n167\t        let mut stmt = self\n168\t            .conn\n169\t            .prepare(\"SELECT id, source, target FROM links WHERE target = ?1\")\n170\t            .expect(\"Failed to prepare query\");\n171\t\n172\t        stmt.query_map(params![target as i64], |row| {\n173\t            Ok(Link {\n174\t                id: row.get::<_, i64>(0)? as u64,\n175\t                source: row.get::<_, i64>(1)? as u64,\n176\t                target: row.get::<_, i64>(2)? as u64,\n177\t            })\n178\t        })\n179\t        .expect(\"Failed to query links\")\n180\t        .filter_map(|r| r.ok())\n181\t        .collect()\n182\t    }\n183\t\n184\t    fn query_by_source_target(&self, source: u64, target: u64) -> Vec<Link> {\n185\t        let mut stmt = self\n186\t            .conn\n187\t            .prepare(\"SELECT id, source, target FROM links WHERE source = ?1 AND target = ?2\")\n188\t            .expect(\"Failed to prepare query\");\n189\t\n190\t        stmt.query_map(params![source as i64, target as i64], |row| {\n191\t            Ok(Link {\n192\t                id: row.get::<_, i64>(0)? as u64,\n193\t                source: row.get::<_, i64>(1)? as u64,\n194\t                target: row.get::<_, i64>(2)? as u64,\n195\t            })\n196\t        })\n197\t        .expect(\"Failed to query links\")\n198\t        .filter_map(|r| r.ok())\n199\t        .collect()\n200\t    }\n201\t\n202\t    fn count(&self) -> usize {\n203\t        self.conn\n204\t            .query_row(\"SELECT COUNT(*) FROM links\", [], |row| row.get::<_, i64>(0))\n205\t            .unwrap_or(0) as usize\n206\t    }\n207\t}\n208\t\n209\timpl Objects for SqliteLinks {\n210\t    fn create_posts(&mut self, posts: &[BlogPost]) -> Vec<u64> {\n211\t        let transaction = self\n212\t            .conn\n213\t            .unchecked_transaction()\n214\t            .expect(\"Failed to start a transaction\");\n215\t        let mut ids = Vec::with_capacity(posts.len());\n216\t        {\n217\t            let mut statement = transaction\n218\t                .prepare(\n219\t                    \"INSERT INTO blog_posts (title, content, publication_date_time)\n220\t                     VALUES (?1, ?2, ?3)\",\n221\t                )\n222\t                .expect(\"Failed to prepare the blog post insert\");\n223\t            for post in posts {\n224\t                statement\n225\t                    .execute(params![\n226\t                        post.title,\n227\t                        post.content,\n228\t                        post.publication_date_time\n229\t                    ])\n230\t                    .expect(\"Failed to insert a blog post\");\n231\t                ids.push(transaction.last_insert_rowid() as u64);\n232\t            }\n233\t        }\n234\t        transaction.commit().expect(\"Failed to commit blog posts\");\n235\t        ids\n236\t    }\n237\t\n238\t    fn read_posts(&self) -> Vec<BlogPost> {\n239\t        let mut statement = self\n240\t            .conn\n241\t            .prepare(\"SELECT id, title, content, publication_date_time FROM blog_posts\")\n242\t            .expect(\"Failed to prepare the blog post query\");\n243\t\n244\t        statement\n245\t            .query_map([], |row| {\n246\t                Ok(BlogPost {\n247\t                    id: row.get::<_, i64>(0)? as u64,\n248\t                    title: row.get(1)?,\n249\t                    content: row.get(2)?,\n250\t                    publication_date_time: row.get(3)?,\n251\t                })\n252\t            })\n253\t            .expect(\"Failed to query blog posts\")\n254\t            .filter_map(|post| post.ok())\n255\t            .collect()\n256\t    }\n257\t\n258\t    fn delete_posts(&mut self) {\n259\t        self.conn\n260\t            .execute(\"DELETE FROM blog_posts\", [])\n261\t            .expect(\"Failed to delete blog posts\");\n262\t    }\n263\t\n264\t    fn count_posts(&self) -> usize {\n265\t        self.conn\n266\t            .query_row(\"SELECT COUNT(*) FROM blog_posts\", [], |row| {\n267\t                row.get::<_, i64>(0)\n268\t            })\n269\t            .unwrap_or(0) as usize\n270\t    }\n271\t}\n272\t\n273\t#[cfg(test)]\n274\tmod tests {\n275\t    use super::*;\n276\t\n277\t    #[test]\n278\t    fn test_create_and_query() {\n279\t        let mut db = SqliteLinks::new_memory();\n280\t        let id = db.create(1, 2);\n281\t        assert_eq!(id, 1);\n282\t\n283\t        let link = db.query_by_id(id).unwrap();\n284\t        assert_eq!(link.source, 1);\n285\t        assert_eq!(link.target, 2);\n286\t    }\n287\t\n288\t    #[test]\n289\t    fn test_create_point() {\n290\t        let mut db = SqliteLinks::new_memory();\n291\t        let id = db.create_point();\n292\t        assert_eq!(id, 1);\n293\t\n294\t        let link = db.query_by_id(id).unwrap();\n295\t        assert_eq!(link.source, id);\n296\t        assert_eq!(link.target, id);\n297\t    }\n298\t\n299\t    #[test]\n300\t    fn test_update() {\n301\t        let mut db = SqliteLinks::new_memory();\n302\t        let id = db.create(1, 2);\n303\t        db.update(id, 3, 4);\n304\t\n305\t        let link = db.query_by_id(id).unwrap();\n306\t        assert_eq!(link.source, 3);\n307\t        assert_eq!(link.target, 4);\n308\t    }\n309\t\n310\t    #[test]\n311\t    fn test_delete() {\n312\t        let mut db = SqliteLinks::new_memory();\n313\t        let id = db.create(1, 2);\n314\t        db.delete(id);\n315\t        assert!(db.query_by_id(id).is_none());\n316\t    }\n317\t\n318\t    #[test]\n319\t    fn test_query_by_source() {\n320\t        let mut db = SqliteLinks::new_memory();\n321\t        db.create(1, 2);\n322\t        db.create(1, 3);\n323\t        db.create(2, 3);\n324\t\n325\t        let links = db.query_by_source(1);\n326\t        assert_eq!(links.len(), 2);\n327\t    }\n328\t\n329\t    #[test]\n330\t    fn test_query_by_target() {\n331\t        let mut db = SqliteLinks::new_memory();\n332\t        db.create(1, 3);\n333\t        db.create(2, 3);\n334\t        db.create(2, 4);\n335\t\n336\t        let links = db.query_by_target(3);\n337\t        assert_eq!(links.len(), 2);\n338\t    }\n339\t}\n340\t//! Doublets storage implementation for links\n341\t\n342\tuse crate::{BlogPost, Link, Links, Objects};\n343\tuse doublets::{\n344\t    mem::{Alloc, FileMapped},\n345\t    split::{self, DataPart, IndexPart},\n346\t    unit::{self, LinkPart},\n347\t    Doublets, DoubletsExt,\n348\t};\n349\tuse std::{alloc::Global, collections::HashMap, fs::OpenOptions, path::Path};\n350\t\n351\t/// Type alias for Doublets united (unit) store with volatile (in-memory) storage.\n352\t/// Each link is stored as a contiguous unit containing (id, source, target).\n353\tpub type DoubletsUnitedVolatile<T = usize> = unit::Store<T, Alloc<LinkPart<T>, Global>>;\n354\t\n355\t/// Type alias for Doublets split store with volatile (in-memory) storage.\n356\t/// Separates data and index into different memory regions for better cache efficiency.\n357\tpub type DoubletsSplitVolatile<T = usize> =\n358\t    split::Store<T, Alloc<DataPart<T>, Global>, Alloc<IndexPart<T>, Global>>;\n359\t\n360\t/// Type alias for Doublets united (unit) store with non-volatile (file-mapped) storage.\n361\t/// Same layout as [`DoubletsUnitedVolatile`], but the links live in a memory-mapped file.\n362\tpub type DoubletsUnitedNonVolatile<T = usize> = unit::Store<T, FileMapped<LinkPart<T>>>;\n363\t\n364\t/// Type alias for Doublets split store with non-volatile (file-mapped) storage.\n365\t/// Same layout as [`DoubletsSplitVolatile`], but data and index live in two memory-mapped files.\n366\tpub type DoubletsSplitNonVolatile<T = usize> =\n367\t    split::Store<T, FileMapped<DataPart<T>>, FileMapped<IndexPart<T>>>;\n368\t\n369\t/// Opens (creating it when missing) a file and maps it as Doublets memory.\n370\tpub fn map_file<T: Default, P: AsRef<Path>>(path: P) -> FileMapped<T> {\n371\t    let file = OpenOptions::new()\n372\t        .read(true)\n373\t        .write(true)\n374\t        .create(true)\n375\t        .open(path)\n376\t        .expect(\"Failed to open the links file\");\n377\t    FileMapped::new(file).expect(\"Failed to map the links file\")\n378\t}\n379\t\n380\t/// Markers of the object like structures stored as links.\n381\t///\n382\t/// The markers mirror the ones of the C# `DoubletsDbContext`: a marker for the\n383\t/// blog post itself and one marker per property.\n384\t#[derive(Debug, Clone, Copy)]\n385\tstruct Markers {\n386\t    blog_post: usize,\n387\t    title: usize,\n388\t    content: usize,\n389\t    publication_date_time: usize,\n390\t    empty_string: usize,\n391\t}\n392\t\n393\t/// State needed to store object like structures as links.\n394\t///\n395\t/// Doublets has no notion of a string, so every string is stored as a sequence\n396\t/// of links: every distinct character becomes a point link (a \"symbol\"), and a\n397\t/// string becomes a left fold of `(sequence, symbol)` links. Identical strings\n398\t/// (and identical prefixes) are therefore stored exactly once, which is how the\n399\t/// C# benchmark stores unicode sequences as well.\n400\t#[derive(Default)]\n401\tstruct ObjectsState {\n402\t    markers: Option<Markers>,\n403\t    symbols: HashMap<char, usize>,\n404\t    characters: HashMap<usize, char>,\n405\t}\n406\t\n407\timpl ObjectsState {\n408\t    fn clear(&mut self) {\n409\t        self.markers = None;\n410\t        self.symbols.clear();\n411\t        self.characters.clear();\n412\t    }\n413\t}\n414\t\n415\t/// Wrapper to adapt doublets::Doublets to our Links trait\n416\tpub struct DoubletsLinks<S> {\n417\t    store: S,\n418\t    objects: ObjectsState,\n419\t}\n420\t\n421\timpl<S> DoubletsLinks<S> {\n422\t    pub fn new(store: S) -> Self {\n423\t        Self {\n424\t            store,\n425\t            objects: ObjectsState::default(),\n426\t        }\n427\t    }\n428\t\n429\t    pub fn into_inner(self) -> S {\n430\t        self.store\n431\t    }\n432\t}\n433\t\n434\timpl<S: Doublets<usize> + DoubletsExt<usize>> Links for DoubletsLinks<S> {\n435\t    fn create(&mut self, source: u64, target: u64) -> u64 {\n436\t        // `create_by` passes its argument as a *restriction* of the query, and\n437\t        // the memory stores ignore it — it always creates an empty link. The\n438\t        // source and the target are only assigned by the update that follows,\n439\t        // which is exactly what `create_link` does (the equivalent of\n440\t        // `CreateAndUpdate` of the C# `Platform.Data.Doublets`).\n441\t        self.store\n442\t            .create_link(source as usize, target as usize)\n443\t            .expect(\"Failed to create link\") as u64\n444\t    }\n445\t\n446\t    fn create_point(&mut self) -> u64 {\n447\t        self.store.create_point().expect(\"Failed to create point\") as u64\n448\t    }\n449\t\n450\t    fn update(&mut self, id: u64, source: u64, target: u64) {\n451\t        self.store\n452\t            .update(id as usize, source as usize, target as usize)\n453\t            .expect(\"Failed to update link\");\n454\t    }\n455\t\n456\t    fn delete(&mut self, id: u64) {\n457\t        self.store\n458\t            .delete(id as usize)\n459\t            .expect(\"Failed to delete link\");\n460\t    }\n461\t\n462\t    fn delete_all(&mut self) {\n463\t        // The markers and the symbols are links too, they are gone as well.\n464\t        self.objects.clear();\n465\t        let any = self.store.constants().any;\n466\t        let ids: Vec<usize> = self\n467\t            .store\n468\t            .each_iter([any, any, any])\n469\t            .map(|link| link.index)\n470\t            .collect();\n471\t        for id in ids {\n472\t            let _ = self.store.delete(id);\n473\t        }\n474\t    }\n475\t\n476\t    fn query_all(&self) -> Vec<Link> {\n477\t        let any = self.store.constants().any;\n478\t        self.store\n479\t            .each_iter([any, any, any])\n480\t            .map(|link| Link::new(link.index as u64, link.source as u64, link.target as u64))\n481\t            .collect()\n482\t    }\n483\t\n484\t    fn query_by_id(&self, id: u64) -> Option<Link> {\n485\t        self.store\n486\t            .get_link(id as usize)\n487\t            .map(|link| Link::new(link.index as u64, link.source as u64, link.target as u64))\n488\t    }\n489\t\n490\t    fn query_by_source(&self, source: u64) -> Vec<Link> {\n491\t        let any = self.store.constants().any;\n492\t        self.store\n493\t            .each_iter([any, source as usize, any])\n494\t            .map(|link| Link::new(link.index as u64, link.source as u64, link.target as u64))\n495\t            .collect()\n496\t    }\n497\t\n498\t    fn query_by_target(&self, target: u64) -> Vec<Link> {\n499\t        let any = self.store.constants().any;\n500\t        self.store\n501\t            .each_iter([any, any, target as usize])\n502\t            .map(|link| Link::new(link.index as u64, link.source as u64, link.target as u64))\n503\t            .collect()\n504\t    }\n505\t\n506\t    fn query_by_source_target(&self, source: u64, target: u64) -> Vec<Link> {\n507\t        let any = self.store.constants().any;\n508\t        self.store\n509\t            .each_iter([any, source as usize, target as usize])\n510\t            .map(|link| Link::new(link.index as u64, link.source as u64, link.target as u64))\n511\t            .collect()\n512\t    }\n513\t\n514\t    fn count(&self) -> usize {\n515\t        self.store.count()\n516\t    }\n517\t}\n518\t\n519\timpl<S: Doublets<usize> + DoubletsExt<usize>> DoubletsLinks<S> {\n520\t    /// Returns the markers of the object like structures, creating them on first use.\n521\t    fn markers(&mut self) -> Markers {\n522\t        if let Some(markers) = self.objects.markers {\n523\t            return markers;\n524\t        }\n525\t        let markers = Markers {\n526\t            blog_post: self.point(),\n527\t            title: self.point(),\n528\t            content: self.point(),\n529\t            publication_date_time: self.point(),\n530\t            empty_string: self.point(),\n531\t        };\n532\t        self.objects.markers = Some(markers);\n533\t        markers\n534\t    }\n535\t\n536\t    fn point(&mut self) -> usize {\n537\t        self.store\n538\t            .create_point()\n539\t            .expect(\"Failed to create a marker\")\n540\t    }\n541\t\n542\t    /// Returns the point link representing `character`, creating it on first use.\n543\t    fn symbol(&mut self, character: char) -> usize {\n544\t        if let Some(&symbol) = self.objects.symbols.get(&character) {\n545\t            return symbol;\n546\t        }\n547\t        let symbol = self.point();\n548\t        self.objects.symbols.insert(character, symbol);\n549\t        self.objects.characters.insert(symbol, character);\n550\t        symbol\n551\t    }\n552\t\n553\t    /// Stores `text` as a sequence of links and returns the link of the sequence.\n554\t    fn create_sequence(&mut self, text: &str) -> usize {\n555\t        let mut sequence: Option<usize> = None;\n556\t        for character in text.chars() {\n557\t            let symbol = self.symbol(character);\n558\t            sequence = Some(match sequence {\n559\t                None => symbol,\n560\t                Some(previous) => self\n561\t                    .store\n562\t                    .get_or_create(previous, symbol)\n563\t                    .expect(\"Failed to create a sequence link\"),\n564\t            });\n565\t        }\n566\t        sequence.unwrap_or_else(|| self.markers().empty_string)\n567\t    }\n568\t\n569\t    /// Restores the string stored as the sequence of links `sequence`.\n570\t    fn read_sequence(&self, sequence: usize) -> String {\n571\t        if Some(sequence) == self.objects.markers.map(|markers| markers.empty_string) {\n572\t            return String::new();\n573\t        }\n574\t        let mut characters = Vec::new();\n575\t        let mut current = sequence;\n576\t        loop {\n577\t            if let Some(&character) = self.objects.characters.get(&current) {\n578\t                characters.push(character);\n579\t                break;\n580\t            }\n581\t            match self.store.get_link(current) {\n582\t                Some(link) => {\n583\t                    match self.objects.characters.get(&link.target) {\n584\t                        Some(&character) => characters.push(character),\n585\t                        // Not a sequence of this store, stop instead of looping.\n586\t                        None => break,\n587\t                    }\n588\t                    current = link.source;\n589\t                }\n590\t                None => break,\n591\t            }\n592\t        }\n593\t        characters.reverse();\n594\t        characters.into_iter().collect()\n595\t    }\n596\t\n597\t    /// Sets the value of a property of an object, as `PropertiesOperator` does in C#.\n598\t    fn set_property(&mut self, object: usize, marker: usize, value: usize) {\n599\t        let property = self\n600\t            .store\n601\t            .get_or_create(object, marker)\n602\t            .expect(\"Failed to create a property link\");\n603\t        self.store\n604\t            .get_or_create(property, value)\n605\t            .expect(\"Failed to create a property value link\");\n606\t    }\n607\t\n608\t    /// Returns the value of a property of an object.\n609\t    fn property(&self, object: usize, marker: usize) -> Option<usize> {\n610\t        let any = self.store.constants().any;\n611\t        let property = self.store.search(object, marker)?;\n612\t        self.store\n613\t            .find([any, property, any])\n614\t            .map(|link| link.target)\n615\t    }\n616\t}\n617\t\n618\timpl<S: Doublets<usize> + DoubletsExt<usize>> Objects for DoubletsLinks<S> {\n619\t    fn create_posts(&mut self, posts: &[BlogPost]) -> Vec<u64> {\n620\t        let markers = self.markers();\n621\t        let mut ids = Vec::with_capacity(posts.len());\n622\t        for post in posts {\n623\t            let title = self.create_sequence(&post.title);\n624\t            let content = self.create_sequence(&post.content);\n625\t            let date = self.create_sequence(&post.publication_date_time.to_string());\n626\t\n627\t            // The blog post link is `(blog post marker, itself)`, exactly like\n628\t            // `CreateAndUpdate(_blogPostMarker, Constants.Itself)` in C#.\n629\t            let object = self.store.create().expect(\"Failed to create a blog post\");\n630\t            self.store\n631\t                .update(object, markers.blog_post, object)\n632\t                .expect(\"Failed to mark a blog post\");\n633\t\n634\t            self.set_property(object, markers.title, title);\n635\t            self.set_property(object, markers.content, content);\n636\t            self.set_property(object, markers.publication_date_time, date);\n637\t            ids.push(object as u64);\n638\t        }\n639\t        ids\n640\t    }\n641\t\n642\t    fn read_posts(&self) -> Vec<BlogPost> {\n643\t        let markers = match self.objects.markers {\n644\t            Some(markers) => markers,\n645\t            None => return Vec::new(),\n646\t        };\n647\t        self.objects_of(markers)\n648\t            .into_iter()\n649\t            .map(|object| {\n650\t                let title = self\n651\t                    .property(object, markers.title)\n652\t                    .map(|value| self.read_sequence(value))\n653\t                    .unwrap_or_default();\n654\t                let content = self\n655\t                    .property(object, markers.content)\n656\t                    .map(|value| self.read_sequence(value))\n657\t                    .unwrap_or_default();\n658\t                let date = self\n659\t                    .property(object, markers.publication_date_time)\n660\t                    .map(|value| self.read_sequence(value))\n661\t                    .unwrap_or_default();\n662\t                BlogPost {\n663\t                    id: object as u64,\n664\t                    title,\n665\t                    content,\n666\t                    publication_date_time: date.parse().unwrap_or_default(),\n667\t                }\n668\t            })\n669\t            .collect()\n670\t    }\n671\t\n672\t    fn delete_posts(&mut self) {\n673\t        let markers = match self.objects.markers {\n674\t            Some(markers) => markers,\n675\t            None => return,\n676\t        };\n677\t        let any = self.store.constants().any;\n678\t        for object in self.objects_of(markers) {\n679\t            let properties: Vec<usize> = self\n680\t                .store\n681\t                .each_iter([any, object, any])\n682\t                .map(|link| link.index)\n683\t                .filter(|&index| index != object)\n684\t                .collect();\n685\t            for property in properties {\n686\t                let values: Vec<usize> = self\n687\t                    .store\n688\t                    .each_iter([any, property, any])\n689\t                    .map(|link| link.index)\n690\t                    .filter(|&index| index != property)\n691\t                    .collect();\n692\t                for value in values {\n693\t                    let _ = self.store.delete(value);\n694\t                }\n695\t                let _ = self.store.delete(property);\n696\t            }\n697\t            let _ = self.store.delete(object);\n698\t        }\n699\t    }\n700\t\n701\t    fn count_posts(&self) -> usize {\n702\t        match self.objects.markers {\n703\t            Some(markers) => self.objects_of(markers).len(),\n704\t            None => 0,\n705\t        }\n706\t    }\n707\t}\n708\t\n709\timpl<S: Doublets<usize> + DoubletsExt<usize>> DoubletsLinks<S> {\n710\t    /// Links of all stored blog posts: `(blog post marker, itself)` links.\n711\t    fn objects_of(&self, markers: Markers) -> Vec<usize> {\n712\t        let any = self.store.constants().any;\n713\t        self.store\n714\t            .each_iter([any, markers.blog_post, any])\n715\t            .map(|link| link.index)\n716\t            .filter(|&index| index != markers.blog_post)\n717\t            .collect()\n718\t    }\n719\t}\n720\t\n721\t/// Create a new in-memory doublets united store\n722\tpub fn create_united_volatile() -> DoubletsLinks<DoubletsUnitedVolatile> {\n723\t    let mem = Alloc::new(Global);\n724\t    let store = DoubletsUnitedVolatile::new(mem).expect(\"Failed to create doublets store\");\n725\t    DoubletsLinks::new(store)\n726\t}\n727\t\n728\t/// Create a new in-memory doublets split store\n729\tpub fn create_split_volatile() -> DoubletsLinks<DoubletsSplitVolatile> {\n730\t    let data_mem = Alloc::new(Global);\n731\t    let index_mem = Alloc::new(Global);\n732\t    let store =\n733\t        DoubletsSplitVolatile::new(data_mem, index_mem).expect(\"Failed to create doublets store\");\n734\t    DoubletsLinks::new(store)\n735\t}\n736\t\n737\t/// Create a new file-mapped doublets united store\n738\tpub fn create_united_non_volatile<P: AsRef<Path>>(\n739\t    path: P,\n740\t) -> DoubletsLinks<DoubletsUnitedNonVolatile> {\n741\t    let mem = map_file(path);\n742\t    let store = DoubletsUnitedNonVolatile::new(mem).expect(\"Failed to create doublets store\");\n743\t    DoubletsLinks::new(store)\n744\t}\n745\t\n746\t/// Create a new file-mapped doublets split store\n747\tpub fn create_split_non_volatile<P: AsRef<Path>, Q: AsRef<Path>>(\n748\t    data_path: P,\n749\t    index_path: Q,\n750\t) -> DoubletsLinks<DoubletsSplitNonVolatile> {\n751\t    let data_mem = map_file(data_path);\n752\t    let index_mem = map_file(index_path);\n753\t    let store = DoubletsSplitNonVolatile::new(data_mem, index_mem)\n754\t        .expect(\"Failed to create doublets store\");\n755\t    DoubletsLinks::new(store)\n756\t}\n757\t\n758\t#[cfg(test)]\n759\tmod tests {\n760\t    use super::*;\n761\t\n762\t    #[test]\n763\t    fn test_create_and_query_united() {\n764\t        let mut db = create_united_volatile();\n765\t        let id = db.create_point();\n766\t        assert_eq!(id, 1);\n767\t\n768\t        let link = db.query_by_id(id).unwrap();\n769\t        assert_eq!(link.source, id);\n770\t        assert_eq!(link.target, id);\n771\t    }\n772\t\n773\t    #[test]\n774\t    fn test_create_and_query_split() {\n775\t        let mut db = create_split_volatile();\n776\t        let id = db.create_point();\n777\t        assert_eq!(id, 1);\n778\t\n779\t        let link = db.query_by_id(id).unwrap();\n780\t        assert_eq!(link.source, id);\n781\t        assert_eq!(link.target, id);\n782\t    }\n783\t\n784\t    /// Regression test: `create` used to call `create_by([source, target])`,\n785\t    /// which the memory stores read as a restriction and ignore, so every\n786\t    /// benchmarked link was created empty instead of connecting two links.\n787\t    #[test]\n788\t    fn test_create_assigns_source_and_target() {\n789\t        let mut db = create_united_volatile();\n790\t        let first = db.create_point();\n791\t        let second = db.create_point();\n792\t        let id = db.create(first, second);\n793\t\n794\t        let link = db.query_by_id(id).unwrap();\n795\t        assert_eq!(link.source, first);\n796\t        assert_eq!(link.target, second);\n797\t        assert_eq!(db.query_by_source(first).len(), 2);\n798\t        assert_eq!(db.query_by_target(second).len(), 2);\n799\t    }\n800\t\n801\t    #[test]\n802\t    fn test_update() {\n803\t        let mut db = create_united_volatile();\n804\t        let id = db.create(1, 2);\n805\t        db.update(id, 3, 4);\n806\t\n807\t        let link = db.query_by_id(id).unwrap();\n808\t        assert_eq!(link.source, 3);\n809\t        assert_eq!(link.target, 4);\n810\t    }\n811\t\n812\t    #[test]\n813\t    fn test_delete() {\n814\t        let mut db = create_united_volatile();\n815\t        let id = db.create_point();\n816\t        db.delete(id);\n817\t        assert!(db.query_by_id(id).is_none());\n818\t    }\n819\t\n820\t    #[test]\n821\t    fn test_query_by_source() {\n822\t        let mut db = create_united_volatile();\n823\t        let id1 = db.create_point();\n824\t        let id2 = db.create_point();\n825\t        db.update(id1, id1, id2);\n826\t        db.update(id2, id1, id1);\n827\t\n828\t        let links = db.query_by_source(id1);\n829\t        assert_eq!(links.len(), 2);\n830\t    }\n831\t}\n832\t//! Object-like structures (blog posts) shared by both storages.\n833\t//!\n834\t//! The C# part of this repository compares SQLite and Doublets on an object\n835\t//! like structure — a blog post with a title, a content and a publication date.\n836\t//! This module provides the same model for the Rust benchmarks, so that both\n837\t//! languages measure the same three operations:\n838\t//!\n839\t//! | Operation             | Meaning                                       |\n840\t//! |-----------------------|-----------------------------------------------|\n841\t//! | `Objects Create List` | save a list of blog posts into empty storage  |\n842\t//! | `Objects Read List`   | read every stored blog post back              |\n843\t//! | `Objects Delete List` | delete every stored blog post                 |\n844\t//!\n845\t//! The generated data matches `csharp/Model/BlogPosts.cs`: the title is\n846\t//! `Blog post {n}`, the content is one of five lorem ipsum paragraphs and the\n847\t//! publication date is within the last 30 days. Generation is deterministic\n848\t//! (a small xorshift generator seeded by [`OBJECT_SEED`]) so that every run and\n849\t//! every storage is benchmarked on exactly the same data.\n850\t\n851\tuse once_cell::sync::Lazy;\n852\tuse std::env;\n853\t\n854\t/// Number of blog posts used by the object benchmarks.\n855\t///\n856\t/// Can be overridden with the `BENCHMARK_OBJECT_COUNT` environment variable,\n857\t/// which the CI workflow lowers for pull request runs.\n858\tpub static BENCHMARK_OBJECT_COUNT: Lazy<usize> = Lazy::new(|| {\n859\t    env::var(\"BENCHMARK_OBJECT_COUNT\")\n860\t        .ok()\n861\t        .and_then(|value| value.parse().ok())\n862\t        .unwrap_or(1000)\n863\t});\n864\t\n865\t/// Seed of the deterministic generator of blog posts.\n866\tpub const OBJECT_SEED: u64 = 0x5148_5157_2D31_3235;\n867\t\n868\t/// Lorem ipsum paragraphs used as blog post contents.\n869\t///\n870\t/// The same five paragraphs are used by `csharp/Model/BlogPosts.cs`.\n871\tpub const CONTENTS: [&str; 5] = [\n872\t    \"Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis malesuada blandit mauris nec bibendum.\",\n873\t    \"Curabitur tincidunt nibh sit amet finibus dictum. Suspendisse aliquet arcu non rutrum ultrices.\",\n874\t    \"Donec vitae felis lectus. Aenean velit sapien, porttitor ut feugiat a, consectetur et risus.\",\n875\t    \"Aliquam sed egestas felis. Maecenas sollicitudin nisl in sapien posuere vulputate.\",\n876\t    \"Ut a eleifend augue, eget posuere augue. Proin purus neque, pretium condimentum ipsum ut.\",\n877\t];\n878\t\n879\t/// An object like structure: a blog post.\n880\t#[derive(Debug, Clone, PartialEq, Eq)]\n881\tpub struct BlogPost {\n882\t    /// Storage assigned identifier, `0` before the post is saved.\n883\t    pub id: u64,\n884\t    /// Unique title of the post.\n885\t    pub title: String,\n886\t    /// Body of the post.\n887\t    pub content: String,\n888\t    /// Publication date as a Unix timestamp in seconds.\n889\t    pub publication_date_time: i64,\n890\t}\n891\t\n892\timpl BlogPost {\n893\t    /// Creates a not yet stored blog post.\n894\t    pub fn new(\n895\t        title: impl Into<String>,\n896\t        content: impl Into<String>,\n897\t        publication_date_time: i64,\n898\t    ) -> Self {\n899\t        Self {\n900\t            id: 0,\n901\t            title: title.into(),\n902\t            content: content.into(),\n903\t            publication_date_time,\n904\t        }\n905\t    }\n906\t}\n907\t\n908\t/// Deterministic xorshift64* generator, so every benchmark sees the same data.\n909\tstruct Generator(u64);\n910\t\n911\timpl Generator {\n912\t    fn next(&mut self) -> u64 {\n913\t        let mut state = self.0;\n914\t        state ^= state << 13;\n915\t        state ^= state >> 7;\n916\t        state ^= state << 17;\n917\t        self.0 = state;\n918\t        state\n919\t    }\n920\t}\n921\t\n922\t/// Generates `count` blog posts, mirroring `BlogPosts.GenerateData` of the C# benchmark.\n923\tpub fn generate_posts(count: usize) -> Vec<BlogPost> {\n924\t    // A fixed \"now\" keeps the generated data stable between runs.\n925\t    const NOW: i64 = 1_700_000_000;\n926\t    const SECONDS_IN_30_DAYS: i64 = 30 * 24 * 60 * 60;\n927\t\n928\t    let mut generator = Generator(OBJECT_SEED);\n929\t    (0..count)\n930\t        .map(|index| {\n931\t            let content = CONTENTS[(generator.next() % CONTENTS.len() as u64) as usize];\n932\t            let age = (generator.next() % SECONDS_IN_30_DAYS as u64) as i64;\n933\t            BlogPost::new(format!(\"Blog post {}\", index + 1), content, NOW - age)\n934\t        })\n935\t        .collect()\n936\t}\n937\t\n938\t/// Storage of object like structures.\n939\t///\n940\t/// Implemented natively by every benchmarked backend: SQLite stores blog posts\n941\t/// as rows of a table, Doublets stores them as links (with strings represented\n942\t/// as sequences of links).\n943\tpub trait Objects {\n944\t    /// Saves every post of the list, returns the assigned identifiers.\n945\t    fn create_posts(&mut self, posts: &[BlogPost]) -> Vec<u64>;\n946\t\n947\t    /// Reads every stored post back.\n948\t    fn read_posts(&self) -> Vec<BlogPost>;\n949\t\n950\t    /// Deletes every stored post.\n951\t    fn delete_posts(&mut self);\n952\t\n953\t    /// Number of stored posts.\n954\t    fn count_posts(&self) -> usize;\n955\t}\n956\t\n957\t#[cfg(test)]\n958\tmod tests {\n959\t    use super::*;\n960\t\n961\t    #[test]\n962\t    fn generated_data_is_deterministic() {\n963\t        assert_eq!(generate_posts(16), generate_posts(16));\n964\t    }\n965\t\n966\t    #[test]\n967\t    fn generated_titles_match_the_csharp_benchmark() {\n968\t        let posts = generate_posts(3);\n969\t        assert_eq!(posts[0].title, \"Blog post 1\");\n970\t        assert_eq!(posts[2].title, \"Blog post 3\");\n971\t    }\n972\t\n973\t    #[test]\n974\t    fn generated_contents_are_taken_from_the_lorem_ipsum_paragraphs() {\n975\t        for post in generate_posts(64) {\n976\t            assert!(CONTENTS.contains(&post.content.as_str()));\n977\t        }\n978\t    }\n979\t\n980\t    #[test]\n981\t    fn generated_dates_are_within_the_last_30_days() {\n982\t        let posts = generate_posts(64);\n983\t        let newest = posts\n984\t            .iter()\n985\t            .map(|post| post.publication_date_time)\n986\t            .max()\n987\t            .unwrap();\n988\t        let oldest = posts\n989\t            .iter()\n990\t            .map(|post| post.publication_date_time)\n991\t            .min()\n992\t            .unwrap();\n993\t        assert!(newest - oldest <= 30 * 24 * 60 * 60);\n994\t    }\n995\t}\n996\t"
