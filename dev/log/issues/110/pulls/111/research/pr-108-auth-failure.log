[2026-10-04T18:44:22.802Z] [INFO]         "content": "//! Runs every storage through the same lifecycle on a fresh store per repetition:\n//! a timed batch per operation, each validated against the expected count and checksum.\n\nuse crate::{\n    dataset::{self, blog_post, link, mix, scattered},\n    links::{DoubletsLinks, Link, LinksStorage, SqliteLinks},\n    objects::{BlogPostsStorage, DoubletsBlogPosts, SqliteBlogPosts},\n};\nuse doublets::{\n    data::{LinkReference, LinksConstants},\n    mem::{FileMapped, Global},\n    split, unit,\n};\nuse serde_json::{Value, json};\nuse std::{\n    fs,\n    path::{Path, PathBuf},\n    time::{Duration, Instant},\n};\n\npub const LINKS_VARIANTS: [&str; 6] = [\n    \"SQLite_Memory\",\n    \"SQLite_File\",\n    \"Doublets_United_Volatile\",\n    \"Doublets_United_NonVolatile\",\n    \"Doublets_Split_Volatile\",\n    \"Doublets_Split_NonVolatile\",\n];\n\npub const OBJECTS_VARIANTS: [&str; 10] = [\n        })\n        .collect::<Vec<_>>()\n        .join(\", \")\n}\n\nfn file(directory: &Path, name: &str) -> PathBuf {\n    directory.join(name)\n}\n\nfn mapped<P>(directory: &Path, name: &str) -> FileMapped<P> {\n    FileMapped::from_path(file(directory, name)).unwrap()\n}\n\npub fn measure_links<T: LinkReference>(\n    variant: &'static str,\n    n: u64,\n    repetitions: usize,\n    directory: &Path,\n) -> Measurement {\n    match variant {\n        \"SQLite_Memory\" => measure(\n            variant,\n            n,\n            repetitions,\n            directory,\n            |_| SqliteLinks::<T>::in_memory(),\n            links_lifecycle,\n        ),\n        \"SQLite_File\" => measure(\n            variant,\n            n,\n            repetitions,\n            directory,\n            |dir| SqliteLinks::<T>::open(file(dir, \"links.db\")),\n            links_lifecycle,\n        ),\n        \"Doublets_United_Volatile\" => measure(\n            variant,\n            n,\n            repetitions,\n            directory,\n            |_| DoubletsLinks::new(unit::Store::<T, _>::new(Global::new()).unwrap()),\n            links_lifecycle,\n        ),\n        \"Doublets_United_NonVolatile\" => measure(\n            variant,\n            n,\n            repetitions,\n            directory,\n            |dir| DoubletsLinks::new(unit::Store::<T, _>::new(mapped(dir, \"links.links\")).unwrap()),\n            links_lifecycle,\n        ),\n        \"Doublets_Split_Volatile\" => measure(\n            variant,\n            n,\n            repetitions,\n            directory,\n            |_| {\n                DoubletsLinks::new(\n                    split::Store::<T, _, _>::new(Global::new(), Global::new()).unwrap(),\n                )\n            },\n            links_lifecycle,\n        ),\n        \"Doublets_Split_NonVolatile\" => measure(\n            variant,\n            n,\n            repetitions,\n            directory,\n            |dir| {\n                DoubletsLinks::new(\n                    split::Store::<T, _, _>::new(\n                        mapped(dir, \"data.links\"),\n                        mapped(dir, \"index.links\"),\n                    )\n                    .unwrap(),\n                )\n            },\n            links_lifecycle,\n        ),\n        _ => panic!(\"unknown links variant {variant}\"),\n    }\n}\n\npub fn measure_objects<T: LinkReference>(\n    variant: &'static str,\npub mod raw_mem;\nmod raw_place;\nmod utils;\n\n/// Async memory module providing [`AsyncFileMem`].\n///\n/// Requires the `async` feature flag.\n#[cfg(feature = \"async\")]\npub mod async_mem;\n\npub(crate) use raw_place::RawPlace;\npub use {\n    alloc::Alloc,\n    file_mapped::FileMapped,\n    raw_mem::{ErasedMem, Error, RawMem, Result},\n};\n\n#[cfg(feature = \"async\")]\npub use async_mem::AsyncFileMem;\n\nfn _assertion() {\n    fn assert_sync_send<T: Sync + Send>() {}\n\n    assert_sync_send::<FileMapped<()>>();\n    assert_sync_send::<Alloc<(), allocator_api2::alloc::Global>>();\n}\n\nuse doublets::{\n    data::{LinkReference, LinksConstants},\n    mem::Global,\n    split, unit,\n};\nuse sqlite_vs_doublets::{\n    dataset::{BlogPost, blog_post, link, scattered},\n    harness::{self, LINKS_VARIANTS, OBJECTS_VARIANTS},\n    links::{DoubletsLinks, Link, LinksStorage, SqliteLinks},\n    objects::{BlogPostsStorage, DoubletsBlogPosts, SqliteBlogPosts},\n};\nuse std::collections::HashSet;\n\nconst SIZE: u64 = 1_000;\n\n#[test]\nfn links_are_unique_and_reference_created_ids() {\n    let links: HashSet<_> = (1..=SIZE).map(link).collect();\n    assert_eq!(links.len(), SIZE as usize);\n    for i in 1..=SIZE {\n        let (from, to) = link(i);\n        assert!((1..=i).contains(&from) && (1..=i).contains(&to));\n    }\n}\n\n#[test]\nfn scattered_visits_every_id_once() {\n    for n in [1, 2, 3, 10, 1_000, 1_024, 65_536] {\n        let mut ids: Vec<u64> = scattered(n).collect();\n        ids.sort();\n        assert_eq!(ids, (1..=n).collect::<Vec<_>>());\n    }\n}\n\n#[test]\nfn every_links_variant_passes_the_lifecycle() {\n    let directory = tempdir(\"links\");\n    for variant in LINKS_VARIANTS {\n        harness::measure_links::<u32>(variant, SIZE, 1, &directory);\n        harness::measure_links::<u64>(variant, SIZE, 1, &directory);\n    }\n}\n\n#[test]\nfn every_objects_variant_passes_the_lifecycle() {\n    let directory = tempdir(\"objects\");\n    for variant in OBJECTS_VARIANTS {\n        harness::measure_objects::<u32>(variant, SIZE / 10, 1, &directory);\n        harness::measure_objects::<u64>(variant, SIZE / 10, 1, &directory);\n    }\n}\n\n#[test]\nfn split_store_keeps_links_updated_to_reference_themselves() {\n    let mut links =\n        DoubletsLinks::new(split::Store::<u32, _, _>::new(Global::new(), Global::new()).unwrap());\n    let point = links.create(1, 1);\n    let link = links.create(point, 2);\n    links.update(point, point, point);\n    links.update(link, link, point);\n    assert_eq!(\n        links.get(link),\n        Some(Link {\n            id: link,\n            from: link,\n            to: point\n        })\n    );\n    links.delete(link);\n    links.delete(point);\n    assert_eq!(links.count(), 0);\n}\n\n#[test]\n#[should_panic(expected = \"query_all returned unexpected records\")]\nfn lifecycle_rejects_a_storage_that_loses_records() {\n    struct Lossy(SqliteLinks<u32>);\n\n    impl LinksStorage<u32> for Lossy {\n        fn create(&mut self, from: u32, to: u32) -> u32 {",
