[2026-10-04T16:52:15.728Z] [INFO]               "lines": [
[2026-10-04T16:52:15.728Z] [INFO]                 "+//! Usage: sqlite-vs-doublets <links|objects> <32|64> <size> [--work N | --repetitions N]",
[2026-10-04T16:52:15.728Z] [INFO]                 "+//!        [--variants A,B] [--directory DIR] [--output FILE]",
[2026-10-04T16:52:15.728Z] [INFO]                 "+//!",
[2026-10-04T16:52:15.728Z] [INFO]                 "+//! Repetitions default to `work / size` (at least one), so every size does about the same total work.",
[2026-10-04T16:52:15.728Z] [INFO]                 "+",
[2026-10-04T16:52:15.728Z] [INFO]                 "+use doublets::data::LinkReference;",
[2026-10-04T16:52:15.728Z] [INFO]                 "+use serde_json::json;",
[2026-10-04T16:52:15.728Z] [INFO]                 "+use sqlite_vs_doublets::harness::{self, LINKS_VARIANTS, Measurement, OBJECTS_VARIANTS};",
[2026-10-04T16:52:15.728Z] [INFO]                 "+use std::{collections::HashMap, env, fs, path::Path};",
[2026-10-04T16:52:15.728Z] [INFO]                 "+",
[2026-10-04T16:52:15.728Z] [INFO]                 "+const DEFAULT_WORK: u64 = 10_000_000;",
[2026-10-04T16:52:15.728Z] [INFO]                 "+",
[2026-10-04T16:52:15.728Z] [INFO]                 "+fn main() {",
[2026-10-04T16:52:15.728Z] [INFO]                 "+    let arguments: Vec<String> = env::args().skip(1).collect();",
[2026-10-04T16:52:15.728Z] [INFO]                 "+    let [category, bits, size] = [0, 1, 2].map(|index| arguments.get(index).expect(\"missing positional argument\").as_str());",
[2026-10-04T16:52:15.728Z] [INFO]                 "+    let options: HashMap<&str, &str> =",
[2026-10-04T16:52:15.728Z] [INFO]                 "+        arguments[3..].chunks(2).map(|pair| (pair[0].trim_start_matches(\"--\"), pair[1].as_str())).collect();",
[2026-10-04T16:52:15.728Z] [INFO]                 "+    let size: u64 = size.replace('_', \"\").parse().unwrap();",
[2026-10-04T16:52:15.728Z] [INFO]                 "+    let work: u64 = options.get(\"work\").map_or(DEFAULT_WORK, |work| work.replace('_', \"\").parse().unwrap());",
[2026-10-04T16:52:15.728Z] [INFO]                 "+    let repetitions: usize = options.get(\"repetitions\").map_or((work / size).max(1) as usize, |count| count.parse().unwrap());",
[2026-10-04T16:52:15.728Z] [INFO]                 "+    let all_variants: &[&'static str] = if category == \"links\" { &LINKS_VARIANTS } else { &OBJECTS_VARIANTS };",
[2026-10-04T16:52:15.728Z] [INFO]                 "+    let variants: Vec<&'static str> = match options.get(\"variants\") {",
[2026-10-04T16:52:15.728Z] [INFO]                 "+        Some(names) => names.split(',').map(|name| *all_variants.iter().find(|known| **known == name).expect(name)).collect(),",
[2026-10-04T16:52:15.728Z] [INFO]                 "+        None => all_variants.to_vec(),",
[2026-10-04T16:52:15.728Z] [INFO]                 "+    };",
[2026-10-04T16:52:15.728Z] [INFO]                 "+    let directory = options.get(\"directory\").map_or_else(env::temp_dir, |directory| directory.into());",
[2026-10-04T16:52:15.728Z] [INFO]                 "+",
[2026-10-04T16:52:15.728Z] [INFO]                 "+    let measurements: Vec<Measurement> = match bits {",
[2026-10-04T16:52:15.728Z] [INFO]                 "+        \"32\" => measure::<u32>(category, &variants, size, repetitions, &directory),",
[2026-10-04T16:52:15.728Z] [INFO]                 "+        \"64\" => measure::<u64>(category, &variants, size, repetitions, &directory),",
[2026-10-04T16:52:15.728Z] [INFO]                 "+        _ => panic!(\"bits must be 32 or 64\"),",
[2026-10-04T16:52:15.728Z] [INFO]                 "+    };",
[2026-10-04T16:52:15.728Z] [INFO]                 "+    let report = json!({",
[2026-10-04T16:52:15.728Z] [INFO]                 "+        \"language\": \"Rust\",",
[2026-10-04T16:52:15.728Z] [INFO]                 "+        \"category\": category,",
[2026-10-04T16:52:15.728Z] [INFO]                 "+        \"bits\": bits.parse::<u32>().unwrap(),",
[2026-10-04T16:52:15.728Z] [INFO]                 "+        \"size\": size,",
[2026-10-04T16:52:15.728Z] [INFO]                 "+        \"repetitions\": repetitions,",
[2026-10-04T16:52:15.728Z] [INFO]                 "+        \"warm_up_size\": size.min(harness::WARM_UP_SIZE),",
[2026-10-04T16:52:15.728Z] [INFO]                 "+        \"sqlite_version\": rusqlite::version(),",
[2026-10-04T16:52:15.728Z] [INFO]                 "+        \"results\": measurements.iter().map(Measurement::to_json).collect::<Vec<_>>(),",
[2026-10-04T16:52:15.728Z] [INFO]                 "+    });",
[2026-10-04T16:52:15.728Z] [INFO]                 "+    let report = serde_json::to_string_pretty(&report).unwrap();",
[2026-10-04T16:52:15.728Z] [INFO]                 "+    match options.get(\"output\") {",
[2026-10-04T16:52:15.728Z] [INFO]                 "+        Some(path) => fs::write(path, report).unwrap(),",
[2026-10-04T16:52:15.728Z] [INFO]                 "+        None => println!(\"{report}\"),",
[2026-10-04T16:52:15.728Z] [INFO]                 "+    }",
[2026-10-04T16:52:15.728Z] [INFO]                 "+}",
[2026-10-04T16:52:15.728Z] [INFO]                 "+",
[2026-10-04T16:52:15.728Z] [INFO]                 "+fn measure<T: LinkReference>(",
[2026-10-04T16:52:15.728Z] [INFO]                 "+    category: &str,",
[2026-10-04T16:52:15.728Z] [INFO]                 "+    variants: &[&'static str],",
[2026-10-04T16:52:15.728Z] [INFO]                 "+    size: u64,",
[2026-10-04T16:52:15.728Z] [INFO]                 "+    repetitions: usize,",
[2026-10-04T16:52:15.728Z] [INFO]                 "+    directory: &Path,",
[2026-10-04T16:52:15.728Z] [INFO]                 "+) -> Vec<Measurement> {",
[2026-10-04T16:52:15.728Z] [INFO]                 "+    variants",
[2026-10-04T16:52:15.728Z] [INFO]                 "+        .iter()",
[2026-10-04T16:52:15.728Z] [INFO]                 "+        .map(|variant| match category {",
[2026-10-04T16:52:15.728Z] [INFO]                 "+            \"links\" => harness::measure_links::<T>(variant, size, repetitions, directory),",
[2026-10-04T16:52:15.728Z] [INFO]                 "+            \"objects\" => harness::measure_objects::<T>(variant, size, repetitions, directory),",
[2026-10-04T16:52:15.728Z] [INFO]                 "+            _ => panic!(\"category must be links or objects\"),",
[2026-10-04T16:52:15.728Z] [INFO]                 "+        })",
[2026-10-04T16:52:15.728Z] [INFO]                 "+        .collect()",
[2026-10-04T16:52:15.728Z] [INFO]                 "+}"
[2026-10-04T16:52:15.728Z] [INFO]               ]
[2026-10-04T16:52:15.728Z] [INFO]             }
