[2026-10-04T16:46:33.776Z] [INFO]                 "-};",
[2026-10-04T16:46:33.776Z] [INFO]                 "-",
[2026-10-04T16:46:33.776Z] [INFO]                 "-/// Prepares the storage of every iteration and measures `operation` on it.",
[2026-10-04T16:46:33.776Z] [INFO]                 "-///",
[2026-10-04T16:46:33.776Z] [INFO]                 "-/// `prepare` runs on an empty (forked) storage and its result is handed to",
[2026-10-04T16:46:33.776Z] [INFO]                 "-/// `operation`, which is the only part of the iteration that is timed. Dropping",
[2026-10-04T16:46:33.776Z] [INFO]                 "-/// the fork empties the storage again for the next iteration.",
[2026-10-04T16:46:33.776Z] [INFO]                 "-pub fn measure<B, P, S, O>(bencher: &mut Bencher<'_>, mut prepare: P, mut operation: O)",
[2026-10-04T16:46:33.776Z] [INFO]                 "-where",
[2026-10-04T16:46:33.776Z] [INFO]                 "-    B: Benched<Builder = ()> + DerefMut,",
[2026-10-04T16:46:33.776Z] [INFO]                 "-    B::Target: Links + Objects + Sized,",
[2026-10-04T16:46:33.776Z] [INFO]                 "-    P: FnMut(&mut B::Target) -> S,",
[2026-10-04T16:46:33.776Z] [INFO]                 "-    O: FnMut(&mut B::Target, S),",
[2026-10-04T16:46:33.776Z] [INFO]                 "-{",
[2026-10-04T16:46:33.776Z] [INFO]                 "-    let mut benched = B::setup(());",
[2026-10-04T16:46:33.776Z] [INFO]                 "-    bencher.iter_custom(|iterations| {",
[2026-10-04T16:46:33.776Z] [INFO]                 "-        let mut elapsed = Duration::ZERO;",
[2026-10-04T16:46:33.776Z] [INFO]                 "-        for _ in 0..iterations {",
[2026-10-04T16:46:33.776Z] [INFO]                 "-            let mut fork = benched.fork();",
[2026-10-04T16:46:33.776Z] [INFO]                 "-            let storage = &mut **fork;",
[2026-10-04T16:46:33.776Z] [INFO]                 "-            let prepared = prepare(storage);",
[2026-10-04T16:46:33.776Z] [INFO]                 "-",
[2026-10-04T16:46:33.776Z] [INFO]                 "-            let start = Instant::now();",
[2026-10-04T16:46:33.776Z] [INFO]                 "-            operation(storage, prepared);",
[2026-10-04T16:46:33.776Z] [INFO]                 "-            elapsed += start.elapsed();",
[2026-10-04T16:46:33.776Z] [INFO]                 "-        }",
[2026-10-04T16:46:33.776Z] [INFO]                 "-        elapsed",
[2026-10-04T16:46:33.776Z] [INFO]                 "-    });",
[2026-10-04T16:46:33.776Z] [INFO]                 "-}",
[2026-10-04T16:46:33.776Z] [INFO]                 "-",
[2026-10-04T16:46:33.776Z] [INFO]                 "-/// Measures one operation on one subject.",
[2026-10-04T16:46:33.776Z] [INFO]                 "-macro_rules! benchmark_subject {",
