[2026-10-04T16:55:23.223Z] [INFO]           "command": "mkdir -p /tmp/gh-issue-solver-1791131286882/experiments/split_store_delete/src && cd /tmp/gh-issue-solver-1791131286882/experiments/split_store_delete && cat > Cargo.toml <<'EOF'\n[package]\nname = \"split_store_delete\"\nversion = \"0.1.0\"\nedition = \"2024\"\npublish = false\n\n[dependencies]\ndoublets = \"0.5.0\"\n\n[workspace]\nEOF\ncat > src/main.rs <<'EOF'\n//! Minimal reproduction: the split store panics on delete after links were updated.\nuse doublets::{Doublets, mem::Global, split, unit};\n\nfn link(i: u32) -> (u32, u32) {\n    let from = 1 + (i * 7919) % i;\n    (from, i + 1 - from)\n}\n\nfn run<D: Doublets<u32>>(name: &str, mut store: D, n: u32, swap: bool, reverse_delete: bool) {\n    for i in 1..=n {\n        let (from, to) = link(i);\n        assert_eq!(store.create_link(from, to).unwrap(), i);\n    }\n    if swap {\n        for i in 1..=n {\n            let (from, to) = link(i);\n            store.update(i, to, from).unwrap();\n        }\n    }\n    let ids: Vec<u32> = if reverse_delete { (1..=n).rev().collect() } else { (1..=n).collect() };\n    for id in ids {\n        store.delete(id).unwrap();\n    }\n    println!(\"{name} n={n} swap={swap} reverse_delete={reverse_delete}: ok, count = {}\", store.count());\n}\n\nfn main() {\n    let args: Vec<String> = std::env::args().collect();\n    let kind = args[1].as_str();\n    let n: u32 = args[2].parse().unwrap();\n    let swap = args[3] == \"swap\";\n    let reverse = args[4] == \"reverse\";\n    match kind {\n        \"unit\" => run(kind, unit::Store::<u32, _>::new(Global::new()).unwrap(), n, swap, reverse),\n        _ => run(kind, split::Store::<u32, _, _>::new(Global::new(), Global::new()).unwrap(), n, swap, reverse),\n    }\n}\nEOF\ncargo build --release 2>&1 | tail -3\nfor k in unit split; do for s in swap keep; do for r in forward reverse; do timeout 60 ./target/release/split_store_delete $k 100 $s $r 2>&1 | tail -1; done; done; done",
